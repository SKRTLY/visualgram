name: Build VisualGram APK

# Запускається вручну: вкладка Actions -> Build VisualGram APK -> Run workflow
on:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    timeout-minutes: 150

    steps:
      - name: Checkout mod files
        uses: actions/checkout@v4

      - name: Free disk space
        run: |
          sudo rm -rf /usr/share/dotnet /opt/ghc /opt/hostedtoolcache/CodeQL /usr/local/share/boost || true
          df -h /

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Set up Android SDK
        uses: android-actions/setup-android@v3

      - name: Install Android SDK parts
        run: |
          yes | sdkmanager --licenses > /dev/null || true
          sdkmanager "platforms;android-36" "build-tools;36.0.0" "ndk;27.2.12479018" "cmake;3.22.1"

      - name: Download Telegram source (pinned commit)
        run: |
          BASE=$(cat BASE_COMMIT)
          mkdir telegram
          cd telegram
          git init -q
          git remote add origin https://github.com/DrKLO/Telegram.git
          git fetch --depth 1 origin "$BASE"
          git checkout -q FETCH_HEAD
          git log -1 --format='Telegram base commit: %H'

      - name: Apply the mod
        run: |
          cd telegram
          git apply --whitespace=nowarn ../telegram-mod.patch
          echo "Changed files: $(git status --short | wc -l)"

      - name: Put in your own Telegram API keys
        env:
          TG_API_ID: ${{ secrets.TG_API_ID }}
          TG_API_HASH: ${{ secrets.TG_API_HASH }}
        run: |
          if ! [[ "$TG_API_ID" =~ ^[0-9]+$ ]] || ! [[ "$TG_API_HASH" =~ ^[0-9a-fA-F]{32}$ ]]; then
            echo "::error::Додайте секрети TG_API_ID (число) і TG_API_HASH (32 символи) з my.telegram.org. Дивіться README."
            exit 1
          fi
          F=telegram/TMessagesProj/src/main/java/org/telegram/messenger/BuildVars.java
          sed -i "s/public static int APP_ID = 4;/public static int APP_ID = ${TG_API_ID};/" "$F"
          sed -i "s/public static String APP_HASH = \"[0-9a-f]*\";/public static String APP_HASH = \"${TG_API_HASH}\";/" "$F"
          if grep -q "APP_ID = 4;" "$F"; then
            echo "::error::Не вдалося підставити API ключі"
            exit 1
          fi
          echo "API keys inserted"

      - name: Firebase config (for push notifications)
        env:
          GS: ${{ secrets.GOOGLE_SERVICES_JSON_BASE64 }}
        run: |
          OUT=telegram/TMessagesProj_App/google-services.json
          if [ -n "$GS" ]; then
            echo "$GS" | base64 -d > "$OUT"
            echo "Using your Firebase config"
          else
            cp dummy-google-services.json "$OUT"
            echo "::notice::Firebase не підключено: застосунок збереться, але пуш-сповіщення від Google не працюватимуть."
          fi

      - name: Signing key
        env:
          KS: ${{ secrets.KEYSTORE_BASE64 }}
          KSPASS: ${{ secrets.KEYSTORE_PASSWORD }}
        run: |
          KSFILE=telegram/TMessagesProj/config/release.keystore
          rm -f "$KSFILE"
          if [ -n "$KS" ]; then
            echo "$KS" | base64 -d > "$KSFILE"
            echo "Using your signing key"
          else
            echo "::warning::Секрет KEYSTORE_BASE64 не задано: створено тимчасовий ключ. Такий APK не оновиться поверх попередньої збірки, треба буде видалити старий."
            keytool -genkeypair -keystore "$KSFILE" -storepass "${KSPASS:-android}" -keypass "${KSPASS:-android}" \
              -alias androidkey -keyalg RSA -keysize 2048 -validity 10000 -dname "CN=VisualGram"
          fi

      - name: Cache Gradle
        uses: actions/cache@v4
        with:
          path: |
            ~/.gradle/caches
            ~/.gradle/wrapper
          key: gradle-${{ hashFiles('BASE_COMMIT') }}
          restore-keys: gradle-

      - name: Build APK
        working-directory: telegram
        env:
          KSPASS: ${{ secrets.KEYSTORE_PASSWORD }}
        run: |
          chmod +x gradlew
          PASS="${KSPASS:-android}"
          ./gradlew :TMessagesProj_App:assembleAfatRelease --stacktrace --no-daemon \
            -PRELEASE_STORE_PASSWORD="$PASS" -PRELEASE_KEY_PASSWORD="$PASS" -PRELEASE_KEY_ALIAS=androidkey

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: VisualGram-apk
          path: telegram/TMessagesProj_App/build/outputs/apk/afat/release/app.apk
          if-no-files-found: error
