@@ -0,0 +1,129 @@
+package org.telegram.messenger.mod;
+
+import android.graphics.Canvas;
+import android.graphics.Paint;
+import android.graphics.Path;
+
+import org.telegram.messenger.MessageObject;
+import org.telegram.tgnet.TLRPC;
+
+/**
+ * Shapes of the video messages ("circles"): circle, rounded square, heart, star and so on.
+ *
+ * The shape is not stored in the video. A video message of the mod is declared with the size
+ * 360 + number of the shape (square, so it is still a normal square video for everybody), every
+ * copy of the mod reads the shape from that size, and the usual Telegram just shows a circle.
+ */
+public final class ModShapes {
+
+    public static final int COUNT = ModShapeMath.COUNT;
+
+    private static final int BASE_SIZE = 360;
+    private static final float[][] POINTS = new float[COUNT][];
+    private static final Path ICON_PATH = new Path();
+
+    private ModShapes() {
+    }
+
+    /** True for every shape except the circle (the usual look is kept for it). */
+    public static boolean isShaped(int id) {
+        return id > 0 && id < COUNT;
+    }
+
+    public static int sizeFor(int id) {
+        return BASE_SIZE + id;
+    }
+
+    /** Shape of the video message in that document, 0 if it is a usual circle. */
+    public static int of(TLRPC.Document document) {
+        if (document == null || document.attributes == null) {
+            return 0;
+        }
+        for (int a = 0, n = document.attributes.size(); a < n; a++) {
+            final TLRPC.DocumentAttribute attribute = document.attributes.get(a);
+            if (attribute instanceof TLRPC.TL_documentAttributeVideo) {
+                final TLRPC.TL_documentAttributeVideo video = (TLRPC.TL_documentAttributeVideo) attribute;
+                if (video.round_message && video.w == video.h) {
+                    final int id = video.w - BASE_SIZE;
+                    return isShaped(id) ? id : 0;
+                }
+            }
+        }
+        return 0;
+    }
+
+    public static int of(MessageObject message) {
+        if (message == null || message.messageOwner == null || message.messageOwner.media == null) {
+            return 0;
+        }
+        return of(message.getDocument());
+    }
+
+    private static float[] points(int id) {
+        float[] p = POINTS[id];
+        if (p == null) {
+            p = ModShapeMath.outline(id);
+            POINTS[id] = p;
+        }
+        return p;
+    }
+
+    /** Puts the shape into the rectangle. The circle is an oval. */
+    public static void fillPath(int id, Path dst, float left, float top, float right, float bottom) {
+        dst.rewind();
+        if (!isShaped(id)) {
+            dst.addOval(left, top, right, bottom, Path.Direction.CW);
+            return;
+        }
+        final float[] p = points(id);
+        final float cx = (left + right) / 2f;
+        final float cy = (top + bottom) / 2f;
+        final float hw = (right - left) / 2f;
+        final float hh = (bottom - top) / 2f;
+        dst.moveTo(cx + p[0] * hw, cy + p[1] * hh);
+        for (int i = 2; i < p.length; i += 2) {
+            dst.lineTo(cx + p[i] * hw, cy + p[i + 1] * hh);
+        }
+        dst.close();
+    }
+
+    /** Small picture of the shape for the list of shapes. */
+    public static void drawIcon(Canvas canvas, int id, float cx, float cy, float size, Paint paint) {
+        final float half = size / 2f;
+        fillPath(id, ICON_PATH, cx - half, cy - half, cx + half, cy + half);
+        canvas.drawPath(ICON_PATH, paint);
+    }
+
+    public static String name(int id) {
+        switch (id) {
+            case 1:
+                return ModStrings.t("Квадрат", "Квадрат", "Squircle");
+            case 2:
+                return ModStrings.t("Серце", "Сердце", "Heart");
+            case 3:
+                return ModStrings.t("Зірка", "Звезда", "Star");
+            case 4:
+                return ModStrings.t("Шестикутник", "Шестиугольник", "Hexagon");
+            case 5:
+                return ModStrings.t("П'ятикутник", "Пятиугольник", "Pentagon");
+            case 6:
+                return ModStrings.t("Ромб", "Ромб", "Diamond");
+            case 7:
+                return ModStrings.t("Квітка", "Цветок", "Flower");
+            case 8:
+                return ModStrings.t("Конюшина", "Клевер", "Clover");
+            case 9:
+                return ModStrings.t("Печатка", "Печать", "Seal");
+            case 10:
+                return ModStrings.t("Іскра", "Искра", "Sparkle");
+            case 11:
+                return ModStrings.t("Хмара", "Облако", "Cloud");
+            case 12:
+                return ModStrings.t("Клякса", "Клякса", "Blob");
+            case 13:
+                return ModStrings.t("Котик", "Котик", "Cat");
+            default:
+                return ModStrings.t("Коло", "Круг", "Circle");
+        }
+    }
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/mod/ModStrings.java b/TMessagesProj/src/main/java/org/telegram/messenger/mod/ModStrings.java
