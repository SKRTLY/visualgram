+package org.telegram.messenger.mod;
+
+import android.graphics.Color;
+import android.graphics.ColorFilter;
+import android.graphics.Paint;
+import android.graphics.drawable.Drawable;
+import android.util.SparseIntArray;
+
+import androidx.core.graphics.ColorUtils;
+
+import org.telegram.ui.ActionBar.Theme;
+
+/**
+ * Colors of the profile screen of a person: dark page (black, or tinted with the color of the gift
+ * that is set as the Premium status), rounded cards that are a little lighter than the page, and
+ * light text. Everything else is passed to the theme that was used before.
+ *
+ * The page color is set with setBody (see ProfileActivity.updatedPeerColor).
+ */
+public class ModProfileTheme implements Theme.ResourcesProvider {
+
+    private static final int ACCENT = 0xFF6DB6FF;
+    private static final float CARD_LIGHTEN = 0.14f;
+
+    private final Theme.ResourcesProvider base;
+    private final SparseIntArray colors = new SparseIntArray();
+    private int body = 0xFF000000;
+
+    private ModProfileTheme(Theme.ResourcesProvider base) {
+        this.base = base;
+        rebuild();
+    }
+
+    /** Wraps the theme once; a theme that is already wrapped is returned as it is. */
+    public static ModProfileTheme wrap(Theme.ResourcesProvider base) {
+        if (base instanceof ModProfileTheme) {
+            return (ModProfileTheme) base;
+        }
+        return new ModProfileTheme(base);
+    }
+
+    public int getBody() {
+        return body;
+    }
+
+    /** Sets the color of the page. Returns true if it changed. */
+    public boolean setBody(int color) {
+        color = color | 0xFF000000;
+        if (color == body) {
+            return false;
+        }
+        body = color;
+        rebuild();
+        return true;
+    }
+
+    private void rebuild() {
+        colors.clear();
+        final int card = ColorUtils.blendARGB(body, Color.WHITE, CARD_LIGHTEN);
+        final int white = Color.WHITE;
+        final int gray1 = 0xB3FFFFFF;
+        final int gray2 = 0x99FFFFFF;
+
+        colors.put(Theme.key_windowBackgroundWhite, card);
+        colors.put(Theme.key_windowBackgroundGray, body);
+        colors.put(Theme.key_windowBackgroundGrayShadow, 0);
+
+        colors.put(Theme.key_windowBackgroundWhiteBlackText, white);
+        colors.put(Theme.key_windowBackgroundWhiteGrayText, gray1);
+        colors.put(Theme.key_windowBackgroundWhiteGrayText2, gray1);
+        colors.put(Theme.key_windowBackgroundWhiteGrayText3, gray2);
+        colors.put(Theme.key_windowBackgroundWhiteGrayText4, gray2);
+        colors.put(Theme.key_windowBackgroundWhiteGrayText5, gray2);
+        colors.put(Theme.key_windowBackgroundWhiteGrayText6, gray2);
+        colors.put(Theme.key_windowBackgroundWhiteGrayText7, gray2);
+        colors.put(Theme.key_windowBackgroundWhiteGrayText8, gray2);
+        colors.put(Theme.key_windowBackgroundWhiteGrayIcon, gray1);
+        colors.put(Theme.key_windowBackgroundWhiteBlueIcon, ACCENT);
+
+        colors.put(Theme.key_windowBackgroundWhiteBlueHeader, ACCENT);
+        colors.put(Theme.key_windowBackgroundWhiteBlueText, ACCENT);
+        colors.put(Theme.key_windowBackgroundWhiteBlueText2, ACCENT);
+        colors.put(Theme.key_windowBackgroundWhiteBlueText3, ACCENT);
+        colors.put(Theme.key_windowBackgroundWhiteBlueText4, ACCENT);
+        colors.put(Theme.key_windowBackgroundWhiteBlueText5, ACCENT);
+        colors.put(Theme.key_windowBackgroundWhiteBlueText6, ACCENT);
+        colors.put(Theme.key_windowBackgroundWhiteBlueText7, ACCENT);
+        colors.put(Theme.key_windowBackgroundWhiteLinkText, ACCENT);
+        colors.put(Theme.key_windowBackgroundWhiteValueText, ACCENT);
+        colors.put(Theme.key_chat_messageLinkIn, ACCENT);
+
+        colors.put(Theme.key_divider, 0x1FFFFFFF);
+        colors.put(Theme.key_listSelector, 0x1AFFFFFF);
+        colors.put(Theme.key_settings_listSelector, 0x1AFFFFFF);
+
+        colors.put(Theme.key_actionBarDefaultIcon, white);
+        colors.put(Theme.key_actionBarDefaultTitle, white);
+        colors.put(Theme.key_actionBarDefaultSubtitle, 0xCCFFFFFF);
+    }
+
+    @Override
+    public int getColor(int key) {
+        final int index = colors.indexOfKey(key);
+        if (index >= 0) {
+            return colors.valueAt(index);
+        }
+        return base != null ? base.getColor(key) : Theme.getColor(key);
+    }
+
+    @Override
+    public int getColorOrDefault(int key) {
+        final int index = colors.indexOfKey(key);
+        if (index >= 0) {
+            return colors.valueAt(index);
+        }
+        return base != null ? base.getColorOrDefault(key) : Theme.getColor(key);
+    }
+
+    @Override
+    public int getCurrentColor(int key) {
+        final int index = colors.indexOfKey(key);
+        if (index >= 0) {
+            return colors.valueAt(index);
+        }
+        return base != null ? base.getCurrentColor(key) : Theme.getColor(key);
+    }
+
+    @Override
+    public void setAnimatedColor(int key, int color) {
+        if (base != null) {
+            base.setAnimatedColor(key, color);
+        }
+    }
+
+    @Override
+    public Drawable getDrawable(String drawableKey) {
+        return base != null ? base.getDrawable(drawableKey) : Theme.ResourcesProvider.super.getDrawable(drawableKey);
+    }
+
+    @Override
+    public Paint getPaint(String paintKey) {
+        return base != null ? base.getPaint(paintKey) : Theme.ResourcesProvider.super.getPaint(paintKey);
+    }
+
+    @Override
+    public boolean hasGradientService() {
+        return base != null && base.hasGradientService();
+    }
+
+    @Override
+    public boolean isDark() {
+        return base != null ? base.isDark() : Theme.ResourcesProvider.super.isDark();
+    }
+
+    @Override
+    public void applyServiceShaderMatrix(int w, int h, float translationX, float translationY) {
+        if (base != null) {
+            base.applyServiceShaderMatrix(w, h, translationX, translationY);
+        } else {
+            Theme.ResourcesProvider.super.applyServiceShaderMatrix(w, h, translationX, translationY);
+        }
+    }
+
+    @Override
+    public ColorFilter getAnimatedEmojiColorFilter() {
+        return base != null ? base.getAnimatedEmojiColorFilter() : Theme.ResourcesProvider.super.getAnimatedEmojiColorFilter();
+    }
+}
