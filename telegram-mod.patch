+            {SEAL_FLOWER, G_HEART, 0xFFF8BBD0, 0xFFEC407A, WHITE, 0},
+            {SEAL_BURST, G_SPARKS, 0xFFCE93D8, 0xFF8E24AA, WHITE, 1},
+            {SEAL_CIRCLE, G_SHIELD, 0xFF263238, 0xFF000000, 0xFF4DD0E1, 0},
