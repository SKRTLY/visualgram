+            {SEAL_WAVY12, G_PLANE, 0xFF5EEAD4, 0xFF0E9AA7, WHITE, 1},
+            {SEAL_HEX, G_BOLT, 0xFF4DD0E1, 0xFF0077A8, WHITE, 0},
+            {SEAL_SQUIRCLE, G_DIAMOND, 0xFFFF86C8, 0xFF7C4DFF, WHITE, 1},
