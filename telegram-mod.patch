@@ -0,0 +1,40 @@
+package org.telegram.messenger.mod;
+
+import org.telegram.messenger.LocaleController;
+
+import java.util.Locale;
+
+/**
+ * Texts of the mod in the language that is chosen in the Telegram settings: Ukrainian, Russian or
+ * English (every other language gets English). Usage: ModStrings.t("українською", "по-русски", "in English").
+ */
+public class ModStrings {
+
+    public static final int UK = 0;
+    public static final int RU = 1;
+    public static final int EN = 2;
+
+    private static Locale cachedLocale;
+    private static int cachedLang = EN;
+
+    public static int lang() {
+        final Locale locale = LocaleController.getInstance().getCurrentLocale();
+        if (locale != cachedLocale) {
+            cachedLocale = locale;
+            final String code = locale == null ? "" : locale.getLanguage();
+            if ("uk".equals(code)) {
+                cachedLang = UK;
+            } else if ("ru".equals(code)) {
+                cachedLang = RU;
+            } else {
+                cachedLang = EN;
+            }
+        }
+        return cachedLang;
+    }
+
+    public static String t(String uk, String ru, String en) {
+        final int lang = lang();
+        return lang == UK ? uk : lang == RU ? ru : en;
+    }
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/mod/ModTicks.java b/TMessagesProj/src/main/java/org/telegram/messenger/mod/ModTicks.java
new file mode 100644
index 000000000..8c3828fce
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/mod/ModTicks.java
@@ -0,0 +1,214 @@
+package org.telegram.messenger.mod;
+
+import static org.telegram.messenger.AndroidUtilities.dp;
+
+import android.graphics.Canvas;
+import android.graphics.Paint;
+
+import org.telegram.messenger.MessageObject;
+
+/**
+ * Custom "ticks" instead of the standard Telegram check marks: emoji (ids 1..19) or a short text
+ * status such as "viewed / not viewed" (ids 20..23). Id 0 means the standard ticks.
+ * The ids are sent to friends, so never reorder or remove entries, only add new ones at the end.
+ */
+public class ModTicks {
+
+    private static final String[] EMOJI = {
+            "",
+            "\u2764\uFE0F",       // 1 red heart
+            "\u2B50",             // 2 star
+            "\uD83D\uDD25",       // 3 fire
+            "\u2728",             // 4 sparkles
+            "\uD83D\uDC8E",       // 5 diamond
+            "\uD83C\uDF38",       // 6 blossom
+            "\uD83C\uDF40",       // 7 clover
+            "\uD83E\uDD8B",       // 8 butterfly
+            "\uD83D\uDC51",       // 9 crown
+            "\uD83D\uDC3E",       // 10 paw prints
+            "\u26A1",             // 11 lightning
+            "\uD83D\uDC9C",       // 12 purple heart
+            "\uD83C\uDF08",       // 13 rainbow
+            "\uD83C\uDF53",       // 14 strawberry
+            "\uD83D\uDC31",       // 15 cat
+            "\uD83C\uDF80",       // 16 ribbon
+            "\u2601\uFE0F",       // 17 cloud
+            "\uD83C\uDF19",       // 18 crescent moon
+            "\uD83D\uDCAB"        // 19 dizzy star
+    };
+
+    private static final String[][] EMOJI_NAMES = {
+            {"Стандартні (як у Telegram)", "Серце", "Зірка", "Вогник", "Іскри", "Діамант", "Квітка", "Конюшина", "Метелик", "Корона",
+                    "Лапка", "Блискавка", "Фіолетове серце", "Веселка", "Полуниця", "Котик", "Бантик", "Хмаринка", "Місяць", "Зірочка"},
+            {"Стандартные (как в Telegram)", "Сердце", "Звезда", "Огонёк", "Искры", "Бриллиант", "Цветок", "Клевер", "Бабочка", "Корона",
+                    "Лапка", "Молния", "Фиолетовое сердце", "Радуга", "Клубника", "Котик", "Бантик", "Облачко", "Луна", "Звёздочка"},
+            {"Standard (as in Telegram)", "Heart", "Star", "Fire", "Sparkles", "Diamond", "Flower", "Clover", "Butterfly", "Crown",
+                    "Paw", "Lightning", "Purple heart", "Rainbow", "Strawberry", "Kitty", "Bow", "Cloud", "Moon", "Stardust"}
+    };
+
+    /** Text statuses per language (uk, ru, en): {not viewed yet, viewed}. */
+    private static final String[][][] TEXT = {
+            {
+                    {"не продивився", "продивився"},
+                    {"не переглянуто", "переглянуто"},
+                    {"⏳ доставлено", "👀 прочитано"},
+                    {"💌 надіслано", "💚 прочитано"}
+            },
+            {
+                    {"не просмотрел", "просмотрел"},
+                    {"не просмотрено", "просмотрено"},
+                    {"⏳ доставлено", "👀 прочитано"},
+                    {"💌 отправлено", "💚 прочитано"}
+            },
+            {
+                    {"not seen", "seen"},
+                    {"not viewed", "viewed"},
+                    {"⏳ delivered", "👀 read"},
+                    {"💌 sent", "💚 read"}
+            }
+    };
+
+    private static String[] pair(int tick) {
+        return TEXT[ModStrings.lang()][tick - FIRST_TEXT];
+    }
+
+    /** First id of the text statuses. */
+    public static final int FIRST_TEXT = EMOJI.length;
+    /** Number of ids, valid ids are 0..COUNT-1. */
+    public static final int COUNT = EMOJI.length + TEXT[0].length;
+
+    private static final Paint emojiPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private static final Paint textPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+
+    static {
+        emojiPaint.setTextAlign(Paint.Align.CENTER);
+    }
+
+    public static boolean isEmoji(int tick) {
+        return tick > 0 && tick < FIRST_TEXT;
+    }
+
+    public static boolean isText(int tick) {
+        return tick >= FIRST_TEXT && tick < COUNT;
+    }
+
+    public static boolean isCustom(int tick) {
+        return isEmoji(tick) || isText(tick);
+    }
+
+    /** Names of all styles for the choice dialog, the index in the array is the tick id. */
+    public static String[] labels() {
+        String[] result = new String[COUNT];
+        for (int i = 0; i < COUNT; i++) {
+            if (i == 0) {
+                result[i] = EMOJI_NAMES[ModStrings.lang()][0];
+            } else if (isEmoji(i)) {
+                result[i] = EMOJI[i] + "  " + EMOJI_NAMES[ModStrings.lang()][i];
+            } else {
+                final String[] pair = pair(i);
+                result[i] = ModStrings.t("Текст: ", "Текст: ", "Text: ") + pair[0] + " / " + pair[1];
+            }
+        }
+        return result;
+    }
+
+    public static String label(int tick) {
+        if (tick < 0 || tick >= COUNT) {
+            tick = 0;
+        }
+        return labels()[tick];
+    }
+
+    /** True if my own messages should use the custom tick instead of the standard checks. */
+    public static boolean isOwnActive() {
+        return isCustom(ModSettings.getMyTick());
+    }
+
+    private static int textWidth(int tick) {
+        String[] pair = pair(tick);
+        textPaint.setTextSize(dp(11));
+        float a = textPaint.measureText(pair[0]);
+        float b = textPaint.measureText(pair[1]);
+        return (int) Math.ceil(Math.max(a, b));
+    }
+
+    /** Extra width that the time line of my own message needs for the custom tick. */
+    public static int extraTimeWidth(MessageObject message) {
+        if (message == null || !message.isOutOwner()) {
+            return 0;
+        }
+        int tick = ModSettings.getMyTick();
+        if (isText(tick)) {
+            // the standard check area is about 14dp wider than the room that the text needs to leave
+            return Math.max(0, textWidth(tick) - dp(14));
+        }
+        return 0;
+    }
+
+    /** Width that my own text tick needs in the chat list beyond the standard check area (stdWidth). */
+    public static int listExtra(int stdWidth) {
+        final int tick = ModSettings.getMyTick();
+        return isText(tick) ? Math.max(0, textWidth(tick) - stdWidth) : 0;
+    }
+
+    /**
+     * Draws the tick of my own outgoing message, the tick ends at rightEdge.
+     * Not viewed yet: one emoji, a bit faded (or the first text). Viewed: two emoji like the double
+     * check (or the second text). The color is used for the text styles only.
+     */
+    public static void drawOwn(Canvas canvas, float rightEdge, float centerY, boolean viewed, int alpha255, int color) {
+        int tick = ModSettings.getMyTick();
+        if (isText(tick)) {
+            String[] pair = pair(tick);
+            drawText(canvas, pair[viewed ? 1 : 0], rightEdge, centerY, Paint.Align.RIGHT, viewed ? alpha255 : (int) (alpha255 * 0.75f), color);
+            return;
+        }
+        if (!isEmoji(tick)) {
+            return;
+        }
+        float size = dp(13);
+        if (viewed) {
+            drawEmoji(canvas, EMOJI[tick], rightEdge - size / 2f - dp(4.5f), centerY, size, alpha255);
+            drawEmoji(canvas, EMOJI[tick], rightEdge - size / 2f, centerY, size, alpha255);
+        } else {
+            drawEmoji(canvas, EMOJI[tick], rightEdge - size / 2f, centerY, size, (int) (alpha255 * 0.6f));
+        }
+    }
+
+    /** Width of the tick area for the preview in the settings screen. */
+    public static int previewWidth(int tick) {
+        return isText(tick) ? textWidth(tick) : dp(22);
+    }
+
+    /** Preview in the settings screen: draws a tick of the given style, without touching the saved setting. */
+    public static void drawPreview(Canvas canvas, int tick, float rightEdge, float centerY, boolean viewed, int color) {
+        if (isText(tick)) {
+            drawText(canvas, pair(tick)[viewed ? 1 : 0], rightEdge, centerY, Paint.Align.RIGHT, 255, color);
+        } else if (isEmoji(tick)) {
+            float size = dp(13);
+            if (viewed) {
+                drawEmoji(canvas, EMOJI[tick], rightEdge - size / 2f - dp(4.5f), centerY, size, 255);
+                drawEmoji(canvas, EMOJI[tick], rightEdge - size / 2f, centerY, size, 255);
+            } else {
+                drawEmoji(canvas, EMOJI[tick], rightEdge - size / 2f, centerY, size, 153);
+            }
+        }
+    }
+
+    private static void drawText(Canvas canvas, String text, float x, float centerY, Paint.Align align, int alpha255, int color) {
+        textPaint.setTextSize(dp(11));
+        textPaint.setTextAlign(align);
+        textPaint.setColor(color);
+        textPaint.setAlpha(Math.max(0, Math.min(255, alpha255)));
+        Paint.FontMetrics fm = textPaint.getFontMetrics();
+        canvas.drawText(text, x, centerY - (fm.ascent + fm.descent) / 2f, textPaint);
+    }
+
+    private static void drawEmoji(Canvas canvas, String emoji, float cx, float cy, float size, int alpha255) {
+        emojiPaint.setTextSize(size);
+        emojiPaint.setAlpha(Math.max(0, Math.min(255, alpha255)));
+        Paint.FontMetrics fm = emojiPaint.getFontMetrics();
+        float baseline = cy - (fm.ascent + fm.descent) / 2f;
+        canvas.drawText(emoji, cx, baseline, emojiPaint);
+    }
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/mod/ModTrashSpan.java b/TMessagesProj/src/main/java/org/telegram/messenger/mod/ModTrashSpan.java
new file mode 100644
index 000000000..ddab7a700
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/mod/ModTrashSpan.java
@@ -0,0 +1,122 @@
+package org.telegram.messenger.mod;
+
+import android.graphics.Canvas;
+import android.graphics.Paint;
+import android.graphics.Path;
+import android.graphics.RectF;
+import android.text.SpannableStringBuilder;
+import android.text.Spanned;
+import android.text.style.ReplacementSpan;
+
+import org.telegram.ui.ActionBar.Theme;
+
+/**
+ * The mark of a message that was deleted by the other side: a small trash can before the time.
+ *
+ * The icon stands in the text of the time as a row of non-breaking spaces (see {@link #replaceMark}) that has the same
+ * width as the icon, so every measuring of the time (Paint.measureText on the plain characters) and the drawing of it
+ * (StaticLayout with this span) agree about the width. The color is chosen in the settings of the mod, "automatic" takes
+ * the color of the time.
+ */
+public class ModTrashSpan extends ReplacementSpan {
+
+    /** Put into the text of the time where the icon must stand, replaced by {@link #replaceMark}. */
+    public static final char MARK = '';
+
+    private static final char SPACE = ' ';
+
+    private final int count;
+    private final Path path = new Path();
+    private final Paint stroke = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final RectF box = new RectF();
+
+    private ModTrashSpan(int count) {
+        this.count = count;
+        stroke.setStyle(Paint.Style.STROKE);
+        stroke.setStrokeCap(Paint.Cap.ROUND);
+        stroke.setStrokeJoin(Paint.Join.ROUND);
+    }
+
+    /** Text of the time with the mark: if there is no MARK in it, nothing changes. */
+    public static CharSequence replaceMark(CharSequence time) {
+        if (time == null) {
+            return null;
+        }
+        final int index = TextIndex.of(time, MARK);
+        if (index < 0) {
+            return time;
+        }
+        final float size = Theme.chat_timePaint.getTextSize();
+        final float space = Math.max(1f, Theme.chat_timePaint.measureText(String.valueOf(SPACE)));
+        final int count = Math.max(2, Math.round(size / space));
+        final SpannableStringBuilder builder = new SpannableStringBuilder(time);
+        final StringBuilder spaces = new StringBuilder();
+        for (int a = 0; a < count; a++) {
+            spaces.append(SPACE);
+        }
+        spaces.append(' ');
+        builder.replace(index, index + 1, spaces);
+        builder.setSpan(new ModTrashSpan(count), index, index + count, Spanned.SPAN_EXCLUSIVE_EXCLUSIVE);
+        return builder;
+    }
+
+    @Override
+    public int getSize(Paint paint, CharSequence text, int start, int end, Paint.FontMetricsInt fm) {
+        return (int) Math.ceil(count * paint.measureText(String.valueOf(SPACE)));
+    }
+
+    @Override
+    public void draw(Canvas canvas, CharSequence text, int start, int end, float x, int top, int y, int bottom, Paint paint) {
+        final float width = count * paint.measureText(String.valueOf(SPACE));
+        final float size = Math.min(width, paint.getTextSize() * 1.02f);
+        final float cx = x + width / 2f;
+        final float cy = y - paint.getTextSize() * 0.34f;
+        box.set(cx - size / 2f, cy - size / 2f, cx + size / 2f, cy + size / 2f);
+
+        int color = ModSettings.getDeletedColor();
+        if (color == 0) {
+            color = paint.getColor();
+        } else {
+            color = (color & 0x00FFFFFF) | (paint.getColor() & 0xFF000000);
+        }
+        stroke.setColor(color);
+        stroke.setStrokeWidth(size * 0.09f);
+
+        final float k = size / 24f;
+        final float l = box.left;
+        final float t = box.top;
+        path.rewind();
+        // lid and handle
+        path.moveTo(l + 3.5f * k, t + 6f * k);
+        path.lineTo(l + 20.5f * k, t + 6f * k);
+        path.moveTo(l + 9f * k, t + 6f * k);
+        path.lineTo(l + 9f * k, t + 3.6f * k);
+        path.lineTo(l + 15f * k, t + 3.6f * k);
+        path.lineTo(l + 15f * k, t + 6f * k);
+        // body
+        path.moveTo(l + 5.5f * k, t + 6f * k);
+        path.lineTo(l + 6.6f * k, t + 19.4f * k);
+        path.quadTo(l + 6.8f * k, t + 21f * k, l + 8.4f * k, t + 21f * k);
+        path.lineTo(l + 15.6f * k, t + 21f * k);
+        path.quadTo(l + 17.2f * k, t + 21f * k, l + 17.4f * k, t + 19.4f * k);
+        path.lineTo(l + 18.5f * k, t + 6f * k);
+        // two stripes
+        path.moveTo(l + 10f * k, t + 10f * k);
+        path.lineTo(l + 10f * k, t + 17f * k);
+        path.moveTo(l + 14f * k, t + 10f * k);
+        path.lineTo(l + 14f * k, t + 17f * k);
+        canvas.drawPath(path, stroke);
+    }
+
+    /** Index of a char in a CharSequence. */
+    private static final class TextIndex {
+        static int of(CharSequence text, char c) {
+            for (int a = 0, n = text.length(); a < n; a++) {
+                if (text.charAt(a) == c) {
+                    return a;
+                }
+            }
+            return -1;
+        }
+    }
+}
