+                rebuild();
+            });
+        }
+        addInfo(ModStrings.t("Шпалери відтворюються лише у вашому застосунку. Краще брати коротке відео без звуку (до 30 секунд, до 1080p): так менше розряджається батарея.", "Обои воспроизводятся только в вашем приложении. Лучше взять короткое видео без звука (до 30 секунд, до 1080p): так батарея разряжается меньше.", "The wallpaper plays only in your app. A short video without sound (up to 30 seconds, up to 1080p) is best, it drains less battery."));
+
+        // my tick
