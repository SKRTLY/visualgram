+            {SEAL_FLOWER, G_CHECK, 0xFFFFA8D4, 0xFFFF4F9A, WHITE, 0},
+            {SEAL_WAVY10, G_FLAME, 0xFFFFB347, 0xFFE8431F, WHITE, 1},
+            {SEAL_WAVY10, G_MOON, 0xFF5C6BC0, 0xFF1A237E, 0xFFFFE9A8, 1},
