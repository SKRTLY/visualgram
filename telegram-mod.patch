diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/mod/LiveWallpaperView.java b/TMessagesProj/src/main/java/org/telegram/messenger/mod/LiveWallpaperView.java
new file mode 100644
index 0000000..a3ecd44
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/mod/LiveWallpaperView.java
@@ -0,0 +1,312 @@
+package org.telegram.messenger.mod;
+
+import android.content.Context;
+import android.graphics.Bitmap;
+import android.graphics.BitmapFactory;
+import android.graphics.Matrix;
+import android.graphics.SurfaceTexture;
+import android.media.MediaMetadataRetriever;
+import android.media.MediaPlayer;
+import android.view.Surface;
+import android.view.TextureView;
+import android.view.ViewGroup;
+import android.widget.FrameLayout;
+import android.widget.ImageView;
+
+import org.telegram.messenger.ApplicationLoader;
+import org.telegram.messenger.FileLog;
+import org.telegram.messenger.Utilities;
+
+import java.io.File;
+import java.io.FileOutputStream;
+
+/**
+ * Looping, muted video that is drawn behind the chat. The video is chosen by the user and copied
+ * to the app's private storage (see ModSettings.getWallpaperFile).
+ *
+ * To avoid any flash of the normal Telegram wallpaper (or of a black screen) while the chat opens,
+ * the view is always opaque and shows a "poster" (the first frame of the video, saved as a small
+ * picture) at once. The poster fades out as soon as the real video renders its first frame.
+ */
+public class LiveWallpaperView extends FrameLayout implements TextureView.SurfaceTextureListener {
+
+    private static final String POSTER_FILE = "live_wallpaper_poster.jpg";
+    private static final int POSTER_MAX_SIDE = 1280;
+
+    private static Bitmap posterCache;
+    private static long posterCacheStamp = -1;
+    private static boolean posterBuilding;
+
+    private final TextureView textureView;
+    private final ImageView posterView;
+
+    private MediaPlayer player;
+    private Surface surface;
+    private int videoWidth;
+    private int videoHeight;
+    private long loadedStamp = -1;
+
+    public LiveWallpaperView(Context context) {
+        super(context);
+        setBackgroundColor(0xFF000000);
+        setClickable(false);
+        setFocusable(false);
+
+        textureView = new TextureView(context);
+        textureView.setSurfaceTextureListener(this);
+        addView(textureView, new LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT));
+
+        posterView = new ImageView(context);
+        posterView.setScaleType(ImageView.ScaleType.CENTER_CROP);
+        addView(posterView, new LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT));
+
+        showPoster();
+    }
+
+    // ---- poster (first frame of the video, shown instantly) ----------------------------------
+
+    private static File posterFile() {
+        return new File(ApplicationLoader.applicationContext.getFilesDir(), POSTER_FILE);
+    }
+
+    private static long stampOf(File file) {
+        return file.lastModified() + file.length();
+    }
+
+    /** Returns the poster picture, or null if it does not exist yet (then it is created in the background). */
+    private static synchronized Bitmap loadPoster() {
+        File video = ModSettings.getWallpaperFile();
+        File poster = posterFile();
+        if (!video.exists()) {
+            return null;
+        }
+        if (poster.exists() && poster.lastModified() >= video.lastModified()) {
+            long stamp = stampOf(poster);
+            if (posterCache == null || posterCacheStamp != stamp) {
+                try {
+                    posterCache = BitmapFactory.decodeFile(poster.getAbsolutePath());
+                    posterCacheStamp = stamp;
+                } catch (Throwable e) {
+                    FileLog.e(e);
+                    posterCache = null;
+                }
+            }
+            return posterCache;
+        }
+        if (!posterBuilding) {
+            posterBuilding = true;
+            Utilities.globalQueue.postRunnable(() -> {
+                try {
+                    createPoster();
+                } finally {
+                    synchronized (LiveWallpaperView.class) {
+                        posterBuilding = false;
+                    }
+                }
+            });
+        }
+        return null;
+    }
+
+    /** Saves the first frame of the wallpaper video as a small JPEG. Safe to call from a background thread. */
+    public static void createPoster() {
+        File video = ModSettings.getWallpaperFile();
+        if (!video.exists()) {
+            return;
+        }
+        MediaMetadataRetriever retriever = new MediaMetadataRetriever();
+        try {
+            retriever.setDataSource(video.getAbsolutePath());
+            Bitmap frame = retriever.getFrameAtTime(0, MediaMetadataRetriever.OPTION_CLOSEST_SYNC);
+            if (frame == null) {
+                return;
+            }
+            int w = frame.getWidth();
+            int h = frame.getHeight();
+            float scale = Math.min(1f, POSTER_MAX_SIDE / (float) Math.max(w, h));
+            if (scale < 1f) {
+                Bitmap scaled = Bitmap.createScaledBitmap(frame, Math.max(1, Math.round(w * scale)), Math.max(1, Math.round(h * scale)), true);
+                if (scaled != frame) {
+                    frame.recycle();
+                    frame = scaled;
+                }
+            }
+            File poster = posterFile();
+            File temp = new File(poster.getParentFile(), POSTER_FILE + ".tmp");
+            try (FileOutputStream out = new FileOutputStream(temp)) {
+                frame.compress(Bitmap.CompressFormat.JPEG, 85, out);
+                out.flush();
+            }
+            //noinspection ResultOfMethodCallIgnored
+            poster.delete();
+            //noinspection ResultOfMethodCallIgnored
+            temp.renameTo(poster);
+            frame.recycle();
+        } catch (Throwable e) {
+            FileLog.e(e);
+        } finally {
+            try {
+                retriever.release();
+            } catch (Throwable ignore) {
+            }
+        }
+    }
+
+    private void showPoster() {
+        posterView.animate().cancel();
+        Bitmap bitmap = loadPoster();
+        if (bitmap != null) {
+            posterView.setImageBitmap(bitmap);
+            posterView.setAlpha(1f);
+            posterView.setVisibility(VISIBLE);
+        } else {
+            posterView.setImageDrawable(null);
+            posterView.setVisibility(GONE);
+        }
+    }
+
+    private void hidePoster() {
+        if (posterView.getVisibility() != VISIBLE) {
+            return;
+        }
+        posterView.animate().cancel();
+        posterView.animate().alpha(0f).setDuration(180).withEndAction(() -> posterView.setVisibility(GONE)).start();
+    }
+
+    // ---- state ------------------------------------------------------------------------------
+
+    /**
+     * Shows or hides the wallpaper according to the current settings and reloads the video when the
+     * file was replaced. Called when the chat is created and every time the chat is resumed.
+     */
+    public void refresh() {
+        final boolean active = ModSettings.isWallpaperActive();
+        setVisibility(active ? VISIBLE : GONE);
+        if (!active) {
+            return;
+        }
+        final File file = ModSettings.getWallpaperFile();
+        if (stampOf(file) != loadedStamp) {
+            showPoster();
+            if (textureView.isAvailable()) {
+                final SurfaceTexture texture = textureView.getSurfaceTexture();
+                if (texture != null) {
+                    startPlayer(texture);
+                }
+            }
+        }
+    }
+
+    private void startPlayer(SurfaceTexture texture) {
+        File file = ModSettings.getWallpaperFile();
+        if (!file.exists()) {
+            return;
+        }
+        loadedStamp = stampOf(file);
+        try {
+            releasePlayer();
+            surface = new Surface(texture);
+            player = new MediaPlayer();
+            player.setDataSource(file.getAbsolutePath());
+            player.setSurface(surface);
+            player.setLooping(true);
+            player.setVolume(0f, 0f);
+            player.setOnPreparedListener(mp -> {
+                videoWidth = mp.getVideoWidth();
+                videoHeight = mp.getVideoHeight();
+                updateTransform();
+                try {
+                    mp.start();
+                } catch (Throwable e) {
+                    FileLog.e(e);
+                }
+            });
+            player.setOnInfoListener((mp, what, extra) -> {
+                if (what == MediaPlayer.MEDIA_INFO_VIDEO_RENDERING_START) {
+                    hidePoster();
+                }
+                return false;
+            });
+            player.setOnErrorListener((mp, what, extra) -> {
+                releasePlayer();
+                return true;
+            });
+            player.prepareAsync();
+        } catch (Throwable e) {
+            FileLog.e(e);
+            releasePlayer();
+        }
+    }
+
+    private void releasePlayer() {
+        if (player != null) {
+            try {
+                player.release();
+            } catch (Throwable ignore) {
+            }
+            player = null;
+        }
+        if (surface != null) {
+            surface.release();
+            surface = null;
+        }
+    }
+
+    /** Scales the video so that it fills the whole view and crops the overflow (center crop). */
+    private void updateTransform() {
+        int w = textureView.getWidth();
+        int h = textureView.getHeight();
+        if (w == 0 || h == 0 || videoWidth == 0 || videoHeight == 0) {
+            return;
+        }
+        float scale = Math.max(w / (float) videoWidth, h / (float) videoHeight);
+        float scaleX = scale * videoWidth / w;
+        float scaleY = scale * videoHeight / h;
+        Matrix matrix = new Matrix();
+        matrix.setScale(scaleX, scaleY, w / 2f, h / 2f);
+        textureView.setTransform(matrix);
+    }
+
+    @Override
+    protected void onSizeChanged(int w, int h, int oldw, int oldh) {
+        super.onSizeChanged(w, h, oldw, oldh);
+        updateTransform();
+    }
+
+    @Override
+    protected void onWindowVisibilityChanged(int visibility) {
+        super.onWindowVisibilityChanged(visibility);
+        if (player == null) {
+            return;
+        }
+        try {
+            if (visibility == VISIBLE) {
+                player.start();
+            } else {
+                player.pause();
+            }
+        } catch (Throwable ignore) {
+        }
+    }
+
+    @Override
+    public void onSurfaceTextureAvailable(SurfaceTexture texture, int width, int height) {
+        startPlayer(texture);
+    }
+
+    @Override
+    public void onSurfaceTextureSizeChanged(SurfaceTexture texture, int width, int height) {
+        updateTransform();
+    }
+
+    @Override
+    public boolean onSurfaceTextureDestroyed(SurfaceTexture texture) {
+        releasePlayer();
+        loadedStamp = -1;
+        return true;
+    }
+
+    @Override
+    public void onSurfaceTextureUpdated(SurfaceTexture texture) {
+    }
+}
