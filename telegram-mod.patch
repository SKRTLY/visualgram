+package org.telegram.ui.Components;
+
+import static org.telegram.messenger.AndroidUtilities.dp;
+
+import android.content.Context;
+import android.graphics.Canvas;
+import android.graphics.Paint;
+import android.view.Gravity;
+import android.view.View;
+import android.widget.HorizontalScrollView;
+import android.widget.LinearLayout;
+
+import org.telegram.messenger.mod.ModShapes;
+
+/**
+ * Row of buttons with the shapes of a video message. It sits in the panel next to the buttons of the
+ * camera; the chosen shape is filled with the accent color.
+ */
+public class ModShapePicker extends HorizontalScrollView {
+
+    public interface Callback {
+        void onShapeSelected(int id);
+    }
+
+    private static final int ACCENT = 0xFF3390EC;
+
+    private final LinearLayout row;
+    private final Chip[] chips = new Chip[ModShapes.COUNT];
+    private final int iconColor;
+    private int selected;
+    private Callback callback;
+
+    public ModShapePicker(Context context, boolean lightIcons) {
+        super(context);
+        iconColor = lightIcons ? 0xFFFFFFFF : 0xFF5C6670;
+        setHorizontalScrollBarEnabled(false);
+        setOverScrollMode(OVER_SCROLL_NEVER);
+        setFillViewport(false);
+
+        row = new LinearLayout(context);
+        row.setOrientation(LinearLayout.HORIZONTAL);
+        row.setGravity(Gravity.CENTER_VERTICAL);
+        addView(row, new LayoutParams(LayoutParams.WRAP_CONTENT, LayoutParams.MATCH_PARENT));
+
+        for (int a = 0; a < ModShapes.COUNT; a++) {
+            final int id = a;
+            final Chip chip = new Chip(context, id);
+            chip.setOnClickListener(v -> {
+                setSelectedShape(id);
+                if (callback != null) {
+                    callback.onShapeSelected(id);
+                }
+            });
+            chips[a] = chip;
+            row.addView(chip, new LinearLayout.LayoutParams(dp(38), dp(38)));
+        }
+    }
+
+    public void setCallback(Callback callback) {
+        this.callback = callback;
+    }
+
+    public int getSelectedShape() {
+        return selected;
+    }
+
+    public void setSelectedShape(int id) {
+        if (id < 0 || id >= ModShapes.COUNT) {
+            id = 0;
+        }
+        selected = id;
+        for (Chip chip : chips) {
+            chip.invalidate();
+        }
+        final Chip chip = chips[id];
+        post(() -> smoothScrollTo(Math.max(0, chip.getLeft() - dp(60)), 0));
+    }
+
+    private class Chip extends View {
+
+        private final int id;
+        private final Paint fill = new Paint(Paint.ANTI_ALIAS_FLAG);
+
+        Chip(Context context, int id) {
+            super(context);
+            this.id = id;
+            setContentDescription(ModShapes.name(id));
+        }
+
+        @Override
+        protected void onDraw(Canvas canvas) {
+            final float cx = getMeasuredWidth() / 2f;
+            final float cy = getMeasuredHeight() / 2f;
+            final boolean on = selected == id;
+            if (on) {
+                fill.setColor(ACCENT);
+                canvas.drawCircle(cx, cy, dp(16), fill);
+            }
+            fill.setColor(on ? 0xFFFFFFFF : iconColor);
+            ModShapes.drawIcon(canvas, id, cx, cy, dp(on ? 17 : 18), fill);
+        }
+    }
+}
