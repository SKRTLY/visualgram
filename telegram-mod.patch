+            SEAL_SQUIRCLE = 5, SEAL_SHIELD = 6, SEAL_BURST = 7, SEAL_FLOWER = 8, SEAL_COUNT = 9;
+    // pictures inside the seal: the first ones are drawn from ModBadgeGlyphs (same order), the rest in code
+    private static final int G_PLANE = 0, G_SHIELD = 1, G_GIFT = 2, G_HEART = 3, G_DIAMOND = 4, G_SPARKS = 5,
+            G_EYE = 6, G_EGG = 7, DATA_GLYPHS = 8, G_CHECK = 8, G_STAR = 9, G_BOLT = 10, G_CROWN = 11,
+            G_MOON = 12, G_FLAME = 13, G_SK = 14, G_VIP = 15, G_COUNT = 16;
+
+    private static final int WHITE = 0xFFFFFFFF;
+
+    /** Per design: seal, picture, top color, bottom color (0 = rainbow), picture color, sparkles (1 or 0). */
