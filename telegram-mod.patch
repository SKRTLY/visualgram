+        modWaveTime = now;
+        final boolean playing = pressed || now - modProgressTime < 400;
+        final float step = dt / 250f;
+        if (playing) {
+            modWaveAmplitude = Math.min(1f, modWaveAmplitude + step);
+        } else {
+            modWaveAmplitude = Math.max(0f, modWaveAmplitude - step);
+        }
+        final float wavelength = AndroidUtilities.dp(42);
+        modWavePhase = (modWavePhase + dt / 1000f * AndroidUtilities.dp(26)) % wavelength;
+        if ((playing || modWaveAmplitude > 0f) && parentView != null) {
+            parentView.invalidate();
+        }
+
