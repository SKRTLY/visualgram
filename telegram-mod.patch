+        TextView titleView = new TextView(context);
+        titleView.setText(title);
+        titleView.setTextSize(16);
+        titleView.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText));
+        row.addView(titleView, new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
+
+        TextView valueView = new TextView(context);
+        valueView.setText(value);
+        valueView.setTextSize(14);
+        valueView.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText));
+        row.addView(valueView, new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
+
+        root.addView(row, new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
+
+        View divider = new View(context);
+        divider.setBackgroundColor(Theme.getColor(Theme.key_divider));
+        root.addView(divider, new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, 1));
+    }
+
+    // ---- dialogs ------------------------------------------------------------------------
+
+    private void showChoiceDialog(String title, String[] names, int current, IntCallback callback) {
+        AlertDialog.Builder builder = new AlertDialog.Builder(context);
+        builder.setTitle(title);
+        builder.setItems(names, (dialog, which) -> callback.run(which));
+        builder.setNegativeButton("Скасувати", null);
+        showDialog(builder.create());
+    }
+
+    private void showSeekDialog(String title, int min, int max, int current, String unit, IntCallback callback) {
+        LinearLayout layout = new LinearLayout(context);
+        layout.setOrientation(LinearLayout.VERTICAL);
+        layout.setPadding(dp(24), dp(8), dp(24), dp(8));
+
+        TextView valueView = new TextView(context);
+        valueView.setTextSize(18);
+        valueView.setGravity(Gravity.CENTER);
+        valueView.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText));
+        valueView.setText(current + unit);
+        layout.addView(valueView, new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
+
+        SeekBar seekBar = new SeekBar(context);
+        seekBar.setMax(max - min);
+        seekBar.setProgress(Math.max(0, Math.min(max - min, current - min)));
+        seekBar.setOnSeekBarChangeListener(new SeekBar.OnSeekBarChangeListener() {
+            @Override
+            public void onProgressChanged(SeekBar bar, int progress, boolean fromUser) {
+                valueView.setText((progress + min) + unit);
+            }
+
+            @Override
+            public void onStartTrackingTouch(SeekBar bar) {
+            }
+
+            @Override
+            public void onStopTrackingTouch(SeekBar bar) {
+            }
+        });
+        layout.addView(seekBar, new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
+
+        AlertDialog.Builder builder = new AlertDialog.Builder(context);
+        builder.setTitle(title);
+        builder.setView(layout);
+        builder.setPositiveButton("OK", (dialog, which) -> callback.run(seekBar.getProgress() + min));
+        builder.setNegativeButton("Скасувати", null);
+        showDialog(builder.create());
+    }
+
+    // ---- wallpaper picking --------------------------------------------------------------
+
+    private void pickWallpaper() {
+        if (getParentActivity() == null) {
+            return;
+        }
+        try {
+            Intent intent = new Intent(Intent.ACTION_OPEN_DOCUMENT);
+            intent.addCategory(Intent.CATEGORY_OPENABLE);
+            intent.setType("video/*");
+            startActivityForResult(intent, REQUEST_PICK_WALLPAPER);
+        } catch (Throwable e) {
+            FileLog.e(e);
+            Toast.makeText(context, "Не вдалося відкрити вибір файлу", Toast.LENGTH_SHORT).show();
+        }
+    }
+
+    @Override
+    public void onActivityResultFragment(int requestCode, int resultCode, Intent data) {
+        if (requestCode != REQUEST_PICK_WALLPAPER || resultCode != android.app.Activity.RESULT_OK || data == null || data.getData() == null) {
+            return;
+        }
+        final Uri uri = data.getData();
+        final Context appContext = context.getApplicationContext();
+        Toast.makeText(context, "Копіюю відео...", Toast.LENGTH_SHORT).show();
+        Utilities.globalQueue.postRunnable(() -> {
+            boolean ok = false;
+            File target = ModSettings.getWallpaperFile();
+            File temp = new File(target.getParentFile(), "live_wallpaper.tmp");
+            try (InputStream in = appContext.getContentResolver().openInputStream(uri);
+                 OutputStream out = new FileOutputStream(temp)) {
+                if (in != null) {
+                    byte[] buffer = new byte[64 * 1024];
+                    int read;
+                    while ((read = in.read(buffer)) != -1) {
+                        out.write(buffer, 0, read);
+                    }
+                    out.flush();
+                    ok = true;
+                }
+            } catch (Throwable e) {
+                FileLog.e(e);
+            }
+            if (ok) {
+                //noinspection ResultOfMethodCallIgnored
+                target.delete();
+                ok = temp.renameTo(target);
+            }
+            final boolean success = ok;
+            AndroidUtilities.runOnUIThread(() -> {
+                if (success) {
+                    ModSettings.setWallpaperEnabled(true);
+                    Toast.makeText(appContext, "Живі шпалери встановлено", Toast.LENGTH_SHORT).show();
+                } else {
+                    Toast.makeText(appContext, "Не вдалося скопіювати відео", Toast.LENGTH_SHORT).show();
+                }
+                if (root != null) {
+                    rebuild();
+                }
+            });
+        });
+    }
