+    /** Round sample of a color (the first one, "auto", is crossed). */
+    private static class ColorChip extends View {
+        private final int color;
+        private final boolean selected;
+        private final Paint fill = new Paint(Paint.ANTI_ALIAS_FLAG);
+        private final Paint ring = new Paint(Paint.ANTI_ALIAS_FLAG);
+
+        ColorChip(Context context, int color, boolean selected, Runnable onClick) {
+            super(context);
+            this.color = color;
+            this.selected = selected;
+            ring.setStyle(Paint.Style.STROKE);
+            setOnClickListener(v -> onClick.run());
+        }
+
+        @Override
+        protected void onDraw(Canvas canvas) {
+            final float cx = getWidth() / 2f;
+            final float cy = getHeight() / 2f;
+            final float r = Math.min(getWidth(), getHeight()) / 2f - dp(10);
+            if (color == 0) {
+                fill.setColor(Theme.getColor(Theme.key_windowBackgroundGray));
+                canvas.drawCircle(cx, cy, r, fill);
+                ring.setStrokeWidth(dp(2));
+                ring.setColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText));
+                canvas.drawLine(cx - r * 0.6f, cy + r * 0.6f, cx + r * 0.6f, cy - r * 0.6f, ring);
+            } else {
+                fill.setColor(color);
+                canvas.drawCircle(cx, cy, r, fill);
+                ring.setStrokeWidth(dp(1));
+                ring.setColor(Theme.getColor(Theme.key_divider));
+                canvas.drawCircle(cx, cy, r, ring);
+            }
+            if (selected) {
+                ring.setStrokeWidth(dp(2.5f));
+                ring.setColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlueHeader));
+                canvas.drawCircle(cx, cy, r + dp(5), ring);
+            }
+        }
+    }
