+        scrollView.addView(root, new ScrollView.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
+        fragmentView = scrollView;
+
+        rebuild();
+        return fragmentView;
+    }
+
+    // ---- screen content -----------------------------------------------------------------
+
+    private void rebuild() {
+        root.removeAllViews();
+
+        // bubbles
+        addHeader("Бульбашки повідомлень");
+        addRow("Прозорість бульбашок", ModSettings.getBubbleAlphaPercent() + "%", v ->
+                showSeekDialog("Прозорість бульбашок", 20, 100, ModSettings.getBubbleAlphaPercent(), "%", value -> {
+                    ModSettings.setBubbleAlphaPercent(value);
+                    rebuild();
+                }));
+        addInfo("100% означає непрозорі бульбашки, менше значення: крізь них видно шпалери. Працює в усіх, хто встановив цей застосунок.");
+
+        // live wallpaper
+        addHeader("Живі шпалери чату");
+        String wallpaperState;
+        if (!ModSettings.hasWallpaperFile()) {
+            wallpaperState = "Відео не вибрано";
+        } else {
+            wallpaperState = ModSettings.isWallpaperEnabled() ? "Увімкнено" : "Вимкнено";
+        }
+        addRow("Вибрати відео для фону", wallpaperState, v -> pickWallpaper());
+        if (ModSettings.hasWallpaperFile()) {
+            addRow("Показувати живі шпалери", ModSettings.isWallpaperEnabled() ? "Так" : "Ні", v -> {
+                ModSettings.setWallpaperEnabled(!ModSettings.isWallpaperEnabled());
+                rebuild();
+            });
+            addRow("Прибрати відео", "Видалити файл шпалер", v -> {
+                //noinspection ResultOfMethodCallIgnored
+                ModSettings.getWallpaperFile().delete();
+                rebuild();
+            });
+        }
+        addInfo("Шпалери відтворюються лише у вашому застосунку. Краще брати коротке відео без звуку (до 30 секунд, до 1080p): так менше розряджається батарея. Шпалери відкриваються при наступному вході в чат.");
+
+        // my tick
+        addHeader("Мої галочки");
+        addRow("Галочка на моїх повідомленнях", ModTicks.NAMES[safeIndex(ModSettings.getMyTick(), ModTicks.NAMES.length)], v ->
+                showChoiceDialog("Моя галочка", ModTicks.NAMES, ModSettings.getMyTick(), index -> {
+                    ModSettings.setMyTick(index);
+                    rebuild();
+                }));
+
+        // my gift
+        addHeader("Мій анімований подарунок на бульбашці");
+        addRow("Анімація", ModGifts.NAMES[safeIndex(ModSettings.getMyGift(), ModGifts.NAMES.length)], v ->
+                showChoiceDialog("Анімація на бульбашці", ModGifts.NAMES, ModSettings.getMyGift(), index -> {
+                    ModSettings.setMyGift(index);
+                    rebuild();
+                }));
+        addRow("Розмір", ModSettings.getGiftScale() + "%", v ->
+                showSeekDialog("Розмір анімації", 25, 200, ModSettings.getGiftScale(), "%", value -> {
+                    ModSettings.setGiftScale(value);
+                    rebuild();
+                }));
+        root.addView(new GiftPlacementView(context), new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, dp(210)));
+        addInfo("Торкніться бульбашки вище й перетягніть анімацію туди, де вона має стояти на ваших повідомленнях.");
+
+        // sharing
+        addHeader("Друзі");
+        addRow("Показувати друзям мої галочки й подарунок", ModSettings.isShareWithFriends() ? "Так" : "Ні", v -> {
+            ModSettings.setShareWithFriends(!ModSettings.isShareWithFriends());
+            rebuild();
+        });
+        addInfo("Друзі з цим застосунком побачать вашу галочку й анімацію. Для цього в кінець ваших текстових повідомлень додається невидимий службовий знак. У звичайному Telegram він виглядає як порожній символ у кінці. У секретних чатах і в командах для ботів (/start тощо) він не додається.");
+    }
+
+    private static int safeIndex(int index, int length) {
+        return index >= 0 && index < length ? index : 0;
+    }
+
+    // ---- small view builders ------------------------------------------------------------
+
+    private void addHeader(String text) {
+        TextView view = new TextView(context);
+        view.setText(text);
+        view.setTextSize(14);
+        view.setTypeface(Typeface.DEFAULT_BOLD);
+        view.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlueHeader));
+        view.setPadding(dp(16), dp(20), dp(16), dp(8));
+        root.addView(view, new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
+    }
+
+    private void addInfo(String text) {
+        TextView view = new TextView(context);
+        view.setText(text);
+        view.setTextSize(13);
+        view.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText));
+        view.setPadding(dp(16), dp(8), dp(16), dp(12));
