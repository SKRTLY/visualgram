@@ -0,0 +1,246 @@
+package org.telegram.messenger.mod;
+
+import static org.telegram.messenger.AndroidUtilities.dp;
+
+import android.graphics.Canvas;
+import android.graphics.Paint;
+
+import org.telegram.messenger.MessageObject;
+
+/**
+ * Custom "ticks" instead of the standard Telegram check marks: emoji (ids 1..19) or a short text
+ * status such as "viewed / not viewed" (ids 20..23). Id 0 means the standard ticks.
+ * The ids are sent to friends, so never reorder or remove entries, only add new ones at the end.
+ */
+public class ModTicks {
+
+    private static final String[] EMOJI = {
+            "",
+            "\u2764\uFE0F",       // 1 red heart
+            "\u2B50",             // 2 star
+            "\uD83D\uDD25",       // 3 fire
+            "\u2728",             // 4 sparkles
+            "\uD83D\uDC8E",       // 5 diamond
+            "\uD83C\uDF38",       // 6 blossom
+            "\uD83C\uDF40",       // 7 clover
+            "\uD83E\uDD8B",       // 8 butterfly
+            "\uD83D\uDC51",       // 9 crown
+            "\uD83D\uDC3E",       // 10 paw prints
+            "\u26A1",             // 11 lightning
+            "\uD83D\uDC9C",       // 12 purple heart
+            "\uD83C\uDF08",       // 13 rainbow
+            "\uD83C\uDF53",       // 14 strawberry
+            "\uD83D\uDC31",       // 15 cat
+            "\uD83C\uDF80",       // 16 ribbon
+            "\u2601\uFE0F",       // 17 cloud
+            "\uD83C\uDF19",       // 18 crescent moon
+            "\uD83D\uDCAB"        // 19 dizzy star
+    };
+
+    private static final String[][] EMOJI_NAMES = {
+            {"Стандартні (як у Telegram)", "Серце", "Зірка", "Вогник", "Іскри", "Діамант", "Квітка", "Конюшина", "Метелик", "Корона",
+                    "Лапка", "Блискавка", "Фіолетове серце", "Веселка", "Полуниця", "Котик", "Бантик", "Хмаринка", "Місяць", "Зірочка"},
+            {"Стандартные (как в Telegram)", "Сердце", "Звезда", "Огонёк", "Искры", "Бриллиант", "Цветок", "Клевер", "Бабочка", "Корона",
+                    "Лапка", "Молния", "Фиолетовое сердце", "Радуга", "Клубника", "Котик", "Бантик", "Облачко", "Луна", "Звёздочка"},
+            {"Standard (as in Telegram)", "Heart", "Star", "Fire", "Sparkles", "Diamond", "Flower", "Clover", "Butterfly", "Crown",
+                    "Paw", "Lightning", "Purple heart", "Rainbow", "Strawberry", "Kitty", "Bow", "Cloud", "Moon", "Stardust"}
+    };
+
+    /** Text statuses per language (uk, ru, en): {not viewed yet, viewed}. */
+    private static final String[][][] TEXT = {
+            {
+                    {"не продивився", "продивився"},
+                    {"не переглянуто", "переглянуто"},
+                    {"⏳ доставлено", "👀 прочитано"},
+                    {"💌 надіслано", "💚 прочитано"}
+            },
+            {
+                    {"не просмотрел", "просмотрел"},
+                    {"не просмотрено", "просмотрено"},
+                    {"⏳ доставлено", "👀 прочитано"},
+                    {"💌 отправлено", "💚 прочитано"}
+            },
+            {
+                    {"not seen", "seen"},
+                    {"not viewed", "viewed"},
+                    {"⏳ delivered", "👀 read"},
+                    {"💌 sent", "💚 read"}
+            }
+    };
+
+    private static String[] pair(int tick) {
+        return TEXT[ModStrings.lang()][tick - FIRST_TEXT];
+    }
+
+    /** First id of the text statuses. */
+    public static final int FIRST_TEXT = EMOJI.length;
+    /** Number of ids, valid ids are 0..COUNT-1. */
+    public static final int COUNT = EMOJI.length + TEXT[0].length;
+
+    private static final Paint emojiPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private static final Paint textPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+
+    static {
+        emojiPaint.setTextAlign(Paint.Align.CENTER);
+    }
+
+    public static boolean isEmoji(int tick) {
+        return tick > 0 && tick < FIRST_TEXT;
+    }
+
+    public static boolean isText(int tick) {
+        return tick >= FIRST_TEXT && tick < COUNT;
+    }
+
+    public static boolean isCustom(int tick) {
+        return isEmoji(tick) || isText(tick);
+    }
+
+    /** Names of all styles for the choice dialog, the index in the array is the tick id. */
+    public static String[] labels() {
+        String[] result = new String[COUNT];
+        for (int i = 0; i < COUNT; i++) {
+            if (i == 0) {
+                result[i] = EMOJI_NAMES[ModStrings.lang()][0];
+            } else if (isEmoji(i)) {
+                result[i] = EMOJI[i] + "  " + EMOJI_NAMES[ModStrings.lang()][i];
+            } else {
+                final String[] pair = pair(i);
+                result[i] = ModStrings.t("Текст: ", "Текст: ", "Text: ") + pair[0] + " / " + pair[1];
+            }
+        }
+        return result;
+    }
+
+    public static String label(int tick) {
+        if (tick < 0 || tick >= COUNT) {
+            tick = 0;
+        }
+        return labels()[tick];
+    }
+
+    /** True if my own messages should use the custom tick instead of the standard checks. */
+    public static boolean isOwnActive() {
+        return isCustom(ModSettings.getMyTick());
+    }
+
+    /**
+     * The tick that the sender of this incoming message uses: taken from the marker in the message
+     * itself or, for messages without text, from what was learned from earlier messages of the sender.
+     */
+    public static int incomingTick(MessageObject message) {
+        if (message == null || message.isOutOwner()) {
+            return 0;
+        }
+        int tick;
+        if (message.modMarker != null) {
+            tick = message.modMarker.tick;
+        } else {
+            tick = ModPeers.get(message.getFromChatId());
+        }
+        return isCustom(tick) ? tick : 0;
+    }
+
+    private static int textWidth(int tick) {
+        String[] pair = pair(tick);
+        textPaint.setTextSize(dp(11));
+        float a = textPaint.measureText(pair[0]);
+        float b = textPaint.measureText(pair[1]);
+        return (int) Math.ceil(Math.max(a, b));
+    }
+
+    /**
+     * Extra width that the time line needs for the custom tick. The incoming tick has to be passed
+     * (see incomingTick); it is ignored for my own messages.
+     */
+    public static int extraTimeWidth(MessageObject message, int incomingTick) {
+        if (message == null) {
+            return 0;
+        }
+        if (message.isOutOwner()) {
+            int tick = ModSettings.getMyTick();
+            if (isText(tick)) {
+                // the standard check area is about 14dp wider than the room that the text needs to leave
+                return Math.max(0, textWidth(tick) - dp(14));
+            }
+            return 0;
+        }
+        if (isText(incomingTick)) {
+            return textWidth(incomingTick) + dp(6);
+        }
+        if (isEmoji(incomingTick)) {
+            return dp(16);
+        }
+        return 0;
+    }
+
+    /**
+     * Draws the tick of my own outgoing message, the tick ends at rightEdge.
+     * Not viewed yet: one emoji, a bit faded (or the first text). Viewed: two emoji like the double
+     * check (or the second text). The color is used for the text styles only.
+     */
+    public static void drawOwn(Canvas canvas, float rightEdge, float centerY, boolean viewed, int alpha255, int color) {
+        int tick = ModSettings.getMyTick();
+        if (isText(tick)) {
+            String[] pair = pair(tick);
+            drawText(canvas, pair[viewed ? 1 : 0], rightEdge, centerY, Paint.Align.RIGHT, viewed ? alpha255 : (int) (alpha255 * 0.75f), color);
+            return;
+        }
+        if (!isEmoji(tick)) {
+            return;
+        }
+        float size = dp(13);
+        if (viewed) {
+            drawEmoji(canvas, EMOJI[tick], rightEdge - size / 2f - dp(4.5f), centerY, size, alpha255);
+            drawEmoji(canvas, EMOJI[tick], rightEdge - size / 2f, centerY, size, alpha255);
+        } else {
+            drawEmoji(canvas, EMOJI[tick], rightEdge - size / 2f, centerY, size, (int) (alpha255 * 0.6f));
+        }
+    }
+
+    /** Draws the sender's tick right after the time of an incoming message (timeEndX = end of the time text). */
+    public static void drawIncoming(Canvas canvas, int tick, float timeEndX, float centerY, int alpha255, int color) {
+        if (isText(tick)) {
+            drawText(canvas, pair(tick)[1], timeEndX + dp(4), centerY, Paint.Align.LEFT, alpha255, color);
+        } else if (isEmoji(tick)) {
+            drawEmoji(canvas, EMOJI[tick], timeEndX + dp(9.5f), centerY, dp(13), alpha255);
+        }
+    }
+
+    /** Width of the tick area for the preview in the settings screen. */
+    public static int previewWidth(int tick) {
+        return isText(tick) ? textWidth(tick) : dp(22);
+    }
+
+    /** Preview in the settings screen: draws a tick of the given style, without touching the saved setting. */
+    public static void drawPreview(Canvas canvas, int tick, float rightEdge, float centerY, boolean viewed, int color) {
+        if (isText(tick)) {
+            drawText(canvas, pair(tick)[viewed ? 1 : 0], rightEdge, centerY, Paint.Align.RIGHT, 255, color);
+        } else if (isEmoji(tick)) {
+            float size = dp(13);
+            if (viewed) {
+                drawEmoji(canvas, EMOJI[tick], rightEdge - size / 2f - dp(4.5f), centerY, size, 255);
+                drawEmoji(canvas, EMOJI[tick], rightEdge - size / 2f, centerY, size, 255);
+            } else {
+                drawEmoji(canvas, EMOJI[tick], rightEdge - size / 2f, centerY, size, 153);
+            }
+        }
+    }
+
+    private static void drawText(Canvas canvas, String text, float x, float centerY, Paint.Align align, int alpha255, int color) {
+        textPaint.setTextSize(dp(11));
+        textPaint.setTextAlign(align);
+        textPaint.setColor(color);
+        textPaint.setAlpha(Math.max(0, Math.min(255, alpha255)));
+        Paint.FontMetrics fm = textPaint.getFontMetrics();
+        canvas.drawText(text, x, centerY - (fm.ascent + fm.descent) / 2f, textPaint);
+    }
+
+    private static void drawEmoji(Canvas canvas, String emoji, float cx, float cy, float size, int alpha255) {
+        emojiPaint.setTextSize(size);
+        emojiPaint.setAlpha(Math.max(0, Math.min(255, alpha255)));
+        Paint.FontMetrics fm = emojiPaint.getFontMetrics();
+        float baseline = cy - (fm.ascent + fm.descent) / 2f;
+        canvas.drawText(emoji, cx, baseline, emojiPaint);
+    }
+}
