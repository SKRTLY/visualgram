@@ -0,0 +1,52 @@
+package org.telegram.messenger.mod;
+
+import org.telegram.PhoneFormat.PhoneFormat;
+import org.telegram.messenger.UserConfig;
+import org.telegram.tgnet.TLRPC;
+
+/**
+ * Hides the phone number of the owner of the build (for example while the screen is recorded). It works only for
+ * the owner: the number is masked only if the setting is on and the number is the number of an account that
+ * belongs to the owner, so nobody else is touched.
+ */
+public final class ModPrivacy {
+
+    private ModPrivacy() {
+    }
+
+    /** The masked number if this is the phone of the owner and hiding is on, otherwise null. */
+    public static String maskIfOwnPhone(String orig) {
+        if (orig == null || !ModSettings.isHidePhone()) {
+            return null;
+        }
+        final String digits = PhoneFormat.stripExceptNumbers(orig);
+        if (digits == null || digits.length() < 5) {
+            return null;
+        }
+        for (int a = 0; a < UserConfig.MAX_ACCOUNT_COUNT; a++) {
+            final UserConfig config = UserConfig.getInstance(a);
+            if (!config.isClientActivated()) {
+                continue;
+            }
+            final TLRPC.User user = config.getCurrentUser();
+            if (user == null || user.phone == null || !ModOwner.isOwnerId(user.id)) {
+                continue;
+            }
+            if (digits.equals(PhoneFormat.stripExceptNumbers(user.phone))) {
+                return mask(digits.length());
+            }
+        }
+        return null;
+    }
+
+    private static String mask(int digits) {
+        final StringBuilder sb = new StringBuilder("+");
+        for (int a = 0; a < digits; a++) {
+            if (a > 0 && a % 3 == 2) {
+                sb.append(' ');
+            }
+            sb.append('•');
+        }
+        return sb.toString();
+    }
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/mod/ModProfileTheme.java b/TMessagesProj/src/main/java/org/telegram/messenger/mod/ModProfileTheme.java
new file mode 100644
index 000000000..3376afd9c
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/mod/ModProfileTheme.java
@@ -0,0 +1,176 @@
+package org.telegram.messenger.mod;
+
+import android.graphics.Color;
+import android.graphics.ColorFilter;
+import android.graphics.Paint;
+import android.graphics.drawable.Drawable;
+import android.util.SparseIntArray;
+
+import androidx.core.graphics.ColorUtils;
+
+import org.telegram.ui.ActionBar.Theme;
+
+/**
+ * Colors of the profile screen of a person: dark page (black, or tinted with the color of the gift
+ * that is set as the Premium status), rounded cards that are a little lighter than the page, and
+ * light text. Everything else is passed to the theme that was used before.
+ *
+ * The page color is set with setBody (see ProfileActivity.updatedPeerColor).
+ */
+public class ModProfileTheme implements Theme.ResourcesProvider {
+
+    private static final int ACCENT = 0xFF6DB6FF;
+    private static final float CARD_LIGHTEN = 0.14f;
+
+    private final Theme.ResourcesProvider base;
+    private final SparseIntArray colors = new SparseIntArray();
+    private int body = 0xFF000000;
+
+    private ModProfileTheme(Theme.ResourcesProvider base) {
+        this.base = base;
+        rebuild();
+    }
+
+    /** Wraps the theme once; a theme that is already wrapped is returned as it is. */
+    public static ModProfileTheme wrap(Theme.ResourcesProvider base) {
+        if (base instanceof ModProfileTheme) {
+            return (ModProfileTheme) base;
+        }
+        return new ModProfileTheme(base);
+    }
+
+    public int getBody() {
+        return body;
+    }
+
+    /** The theme that was used before the profile got its own dark colors (may be null: the main theme). */
+    public Theme.ResourcesProvider getBase() {
+        return base;
+    }
+
+    /** Sets the color of the page. Returns true if it changed. */
+    public boolean setBody(int color) {
+        color = color | 0xFF000000;
+        if (color == body) {
+            return false;
+        }
+        body = color;
+        rebuild();
+        return true;
+    }
+
+    private void rebuild() {
+        colors.clear();
+        final int card = ColorUtils.blendARGB(body, Color.WHITE, CARD_LIGHTEN);
+        final int white = Color.WHITE;
+        final int gray1 = 0xB3FFFFFF;
+        final int gray2 = 0x99FFFFFF;
+
+        colors.put(Theme.key_windowBackgroundWhite, card);
+        colors.put(Theme.key_windowBackgroundGray, body);
+        // the glass panel with the tabs (Posts, Gifts, ...) takes the color of the page, not the dark default
+        colors.put(Theme.key_glass_targetMainTopPanel, card);
