+/**
+ * "Verification" badges that the owner of the build gives to other people (see ModOwner).
+ * The owner's choice is stored on his phone. It reaches the person in the invisible marker (see
+ * ModMarker) of the owner's next messages to him, and from then on that person's own messages carry
+ * it, so everybody who runs this app sees it. Telegram itself and people without this app see nothing.
+ * A badge is a seal with a picture inside (and sparkles around it), like the badge of an official
+ * channel, plus a text that is shown in a bubble at the bottom when the badge is tapped.
+ */
+public class ModBadges {
+
+    private static final String PREFS = "mod_badges";
+    private static final int MAX_TEXT = 300;
+
+    // ---- storage ------------------------------------------------------------------------------
+
+    /** user id -> "design|text" */
+    private static HashMap<Long, String> cache;
+
+    private static SharedPreferences prefs() {
+        return ApplicationLoader.applicationContext.getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+    }
+
+    private static HashMap<Long, String> map() {
+        if (cache == null) {
+            HashMap<Long, String> loaded = new HashMap<>();
+            try {
+                Map<String, ?> all = prefs().getAll();
+                for (Map.Entry<String, ?> entry : all.entrySet()) {
+                    if (entry.getValue() instanceof String) {
+                        loaded.put(Long.parseLong(entry.getKey()), (String) entry.getValue());
+                    }
+                }
+            } catch (Throwable ignore) {
+            }
+            cache = loaded;
+        }
+        return cache;
+    }
+
+    /**
+     * Badge design (1..DESIGN_COUNT) of that user, 0 if he has no badge: the one the owner chose on
+     * this phone, otherwise the one the user showed in his messages.
+     */
+    public static synchronized int getDesign(long userId) {
+        final String value = userId == 0 ? null : map().get(userId);
+        if (value != null) {
+            final int bar = value.indexOf('|');
+            try {
+                final int design = Integer.parseInt(bar < 0 ? value : value.substring(0, bar));
+                if (design >= 1 && design <= DESIGN_COUNT) {
+                    return design;
+                }
+            } catch (NumberFormatException ignore) {
+            }
+        }
+        final int shown = ModPeers.getBadge(userId);
+        return shown >= 1 && shown <= DESIGN_COUNT ? shown : 0;
+    }
+
+    public static boolean has(long userId) {
+        return getDesign(userId) > 0;
+    }
+
+    /** The text that is shown when the badge is tapped (may be empty). */
+    public static synchronized String getText(long userId) {
+        final String value = map().get(userId);
+        final int bar = value == null ? -1 : value.indexOf('|');
+        return bar < 0 ? "" : value.substring(bar + 1);
+    }
+
+    public static synchronized void set(long userId, int design, String text) {
+        if (userId == 0 || design < 1 || design > DESIGN_COUNT) {
+            return;
+        }
+        text = text == null ? "" : text.trim();
+        if (text.length() > MAX_TEXT) {
+            text = text.substring(0, MAX_TEXT);
+        }
+        final String value = design + "|" + text;
+        map().put(userId, value);
+        prefs().edit().putString(String.valueOf(userId), value).apply();
+        if (!isMine(userId)) {
+            setGrant(userId, design);
+        }
+    }
+
+    public static synchronized void remove(long userId) {
+        map().remove(userId);
+        prefs().edit().remove(String.valueOf(userId)).apply();
+        ModPeers.forgetBadge(userId);
+        if (isMine(userId)) {
+            ModSettings.requestReset();
+        } else {
+            setGrant(userId, 0);
+        }
+    }
+
+    // ---- passing a badge to the person ----------------------------------------------------------
+
+    private static final String GRANTS = "mod_badge_grants";
+    private static final int GRANT_SENDS = 3;
+
+    private static SharedPreferences grants() {
+        return ApplicationLoader.applicationContext.getSharedPreferences(GRANTS, Context.MODE_PRIVATE);
+    }
+
+    /** True if that user id is one of my accounts. */
+    private static boolean isMine(long userId) {
+        for (int a = 0; a < UserConfig.MAX_ACCOUNT_COUNT; a++) {
+            final UserConfig config = UserConfig.getInstance(a);
+            if (config.isClientActivated() && config.getClientUserId() == userId) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    /** True if one of my accounts has a badge (it is then shown to friends). */
+    public static boolean hasOwnBadge() {
+        for (int a = 0; a < UserConfig.MAX_ACCOUNT_COUNT; a++) {
+            final UserConfig config = UserConfig.getInstance(a);
+            if (config.isClientActivated() && getDesign(config.getClientUserId()) > 0) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    /** The next messages to that user will carry this badge (0 = take the badge away). */
+    private static void setGrant(long userId, int design) {
+        grants().edit().putInt(String.valueOf(userId), (GRANT_SENDS << 8) | design).apply();
+    }
+
+    /**
+     * Called when a message to that user is sent: returns the badge that has to travel in it
+     * (0 = take it away), or -1 if nothing is waiting. After a few messages it is considered delivered.
+     */
+    public static synchronized int takeGrant(long userId) {
+        final String key = String.valueOf(userId);
+        final int value = grants().getInt(key, -1);
+        if (value < 0) {
+            return -1;
+        }
+        final int left = (value >> 8) - 1;
+        if (left <= 0) {
+            grants().edit().remove(key).apply();
+        } else {
+            grants().edit().putInt(key, (left << 8) | (value & 0xFF)).apply();
+        }
+        return value & 0xFF;
+    }
+
+    /** The owner gave me a badge (or took it away, design 0): show it and pass it on to my friends. */
+    public static void applyGrant(long me, int design, int date) {
+        final int before = ModPeers.getBadge(me);
+        if (ModPeers.remember(me, 0, design, date) && design == 0 && before != 0) {
+            ModSettings.requestReset();
+        }
+    }
+
+    /** Makes profile, chat title and chat list redraw the name of that user. */
+    public static void notifyChanged() {
+        AndroidUtilities.runOnUIThread(() -> {
+            for (int a = 0; a < UserConfig.MAX_ACCOUNT_COUNT; a++) {
+                if (UserConfig.getInstance(a).isClientActivated()) {
+                    NotificationCenter.getInstance(a).postNotificationName(NotificationCenter.updateInterfaces, MessagesController.UPDATE_MASK_NAME);
+                }
+            }
+        });
+    }
+
+    /** Bubble at the bottom with the badge and the text of that user (the badge was tapped). */
+    public static void showHint(BaseFragment fragment, long userId) {
+        final int design = getDesign(userId);
+        if (design == 0) {
+            return;
+        }
+        String text = getText(userId);
+        if (text.length() == 0) {
+            text = ModStrings.t("Позначку видано в SKgram.", "Отметка выдана в SKgram.", "Badge given in SKgram.");
+        }
+        BulletinFactory.of(fragment).createSimpleBulletin(new ModBadgeDrawable(design, 30), text).show();
+    }
+
+    // ---- drawings -----------------------------------------------------------------------------
+
+    // seals
