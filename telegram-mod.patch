+            addRow(ModStrings.t("Показувати живі шпалери", "Показывать живые обои", "Show live wallpaper"), yesNo(ModSettings.isWallpaperEnabled()), v -> {
+                ModSettings.setWallpaperEnabled(!ModSettings.isWallpaperEnabled());
+                rebuild();
+            });
+            addRow(ModStrings.t("Прибрати відео", "Убрать видео", "Remove the video"), ModStrings.t("Видалити файл шпалер", "Удалить файл обоев", "Delete the wallpaper file"), v -> {
