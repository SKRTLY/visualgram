index 000000000..44bdcb0a4
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/mod/ModBadges.java
@@ -0,0 +1,535 @@
+package org.telegram.messenger.mod;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.graphics.Canvas;
+import android.graphics.Color;
+import android.graphics.CornerPathEffect;
+import android.graphics.LinearGradient;
+import android.graphics.Paint;
+import android.graphics.Path;
+import android.graphics.RectF;
+import android.graphics.Shader;
+import android.graphics.SweepGradient;
+import android.graphics.Typeface;
+
+import org.telegram.messenger.AndroidUtilities;
+import org.telegram.messenger.ApplicationLoader;
+import org.telegram.messenger.MessagesController;
+import org.telegram.messenger.NotificationCenter;
+import org.telegram.messenger.UserConfig;
+import org.telegram.ui.ActionBar.BaseFragment;
+import org.telegram.ui.Components.BulletinFactory;
+
+import java.util.HashMap;
+import java.util.Map;
+
+/**
+ * "Verification" badges that the owner of the build gives to other people (see ModOwner).
+ * The owner's choice is stored on his phone and written into the shared list (see ModRegistry), which
+ * lives in a public Telegram channel that every copy of the app reads by itself, so everybody who runs
+ * this app sees the badges. Telegram itself and people without this app see nothing.
+ * A badge is a seal with a picture inside (and sparkles around it), like the badge of an official
+ * channel, plus a text that is shown in a bubble at the bottom when the badge is tapped.
+ */
+public class ModBadges {
+
+    private static final String PREFS = "mod_badges";
+    private static final int MAX_TEXT = 300;
+
+    // ---- storage ------------------------------------------------------------------------------
+
+    /** user id -> "design|text" */
+    private static HashMap<Long, String> cache;
+
+    private static SharedPreferences prefs() {
+        return ApplicationLoader.applicationContext.getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+    }
+
+    private static HashMap<Long, String> map() {
+        if (cache == null) {
+            HashMap<Long, String> loaded = new HashMap<>();
+            try {
+                Map<String, ?> all = prefs().getAll();
+                for (Map.Entry<String, ?> entry : all.entrySet()) {
+                    if (entry.getValue() instanceof String) {
+                        loaded.put(Long.parseLong(entry.getKey()), (String) entry.getValue());
+                    }
+                }
+            } catch (Throwable ignore) {
+            }
+            cache = loaded;
+        }
+        return cache;
+    }
+
+    /**
+     * Badge design (1..DESIGN_COUNT) of that user, 0 if he has no badge: the one the owner chose on
+     * this phone, then the one from the shared list (see ModRegistry).
+     */
+    public static synchronized int getDesign(long userId) {
+        final String value = userId == 0 ? null : map().get(userId);
+        if (value != null) {
+            final int bar = value.indexOf('|');
+            try {
+                final int design = Integer.parseInt(bar < 0 ? value : value.substring(0, bar));
+                if (design >= 1 && design <= DESIGN_COUNT) {
+                    return design;
+                }
+            } catch (NumberFormatException ignore) {
+            }
+        }
+        return ModRegistry.getDesign(userId);
+    }
+
+    public static boolean has(long userId) {
+        return getDesign(userId) > 0;
+    }
+
+    /** The text that is shown when the badge is tapped (may be empty). */
+    public static synchronized String getText(long userId) {
+        final String value = map().get(userId);
+        if (value == null) {
+            return ModRegistry.getText(userId);
+        }
+        final int bar = value.indexOf('|');
+        return bar < 0 ? "" : value.substring(bar + 1);
+    }
+
+    /**
+     * All badges as the text of badges.txt (the list of the repository plus what the owner changed on
+     * this phone), so it can be pasted into that file and everybody with the app sees the badges.
+     */
+    public static synchronized String exportList() {
+        final java.util.TreeMap<Long, String> lines = ModRegistry.lines();
+        for (Map.Entry<Long, String> entry : map().entrySet()) {
+            final String value = entry.getValue();
+            final int bar = value.indexOf('|');
+            final String text = bar < 0 ? "" : value.substring(bar + 1).replace('\n', ' ').trim();
+            lines.put(entry.getKey(), (bar < 0 ? value : value.substring(0, bar)) + (text.length() == 0 ? "" : " " + text));
+        }
+        final StringBuilder sb = new StringBuilder("# ID DESIGN text\n");
+        for (Map.Entry<Long, String> entry : lines.entrySet()) {
+            sb.append(entry.getKey()).append(' ').append(entry.getValue()).append('\n');
+        }
+        return sb.toString();
+    }
+
+    public static synchronized void set(long userId, int design, String text) {
+        if (userId == 0 || design < 1 || design > DESIGN_COUNT) {
+            return;
+        }
+        text = text == null ? "" : text.trim();
+        if (text.length() > MAX_TEXT) {
+            text = text.substring(0, MAX_TEXT);
+        }
+        final String value = design + "|" + text;
+        map().put(userId, value);
+        prefs().edit().putString(String.valueOf(userId), value).apply();
+        ModRegistry.publishChange(userId, design, text);
+    }
+
+    /** Sends all badges of this phone to the shared list in the channel. */
+    public static synchronized void publishAll() {
+        final java.util.TreeMap<Long, String> all = new java.util.TreeMap<>();
+        for (Map.Entry<Long, String> entry : map().entrySet()) {
+            final String value = entry.getValue();
+            final int bar = value.indexOf('|');
+            final String text = bar < 0 ? "" : value.substring(bar + 1).replace('\n', ' ').trim();
+            all.put(entry.getKey(), (bar < 0 ? value : value.substring(0, bar)) + (text.length() == 0 ? "" : " " + text));
+        }
