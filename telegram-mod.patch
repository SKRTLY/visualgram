--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/ui/ModBadgeDialog.java
@@ -0,0 +1,148 @@
+package org.telegram.ui;
+
+import static org.telegram.messenger.AndroidUtilities.dp;
+
+import android.content.Context;
+import android.graphics.Canvas;
+import android.graphics.Paint;
+import android.text.InputFilter;
+import android.text.InputType;
+import android.util.TypedValue;
+import android.view.Gravity;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.EditText;
+import android.widget.LinearLayout;
+import android.widget.ScrollView;
+import android.widget.TextView;
+
+import org.telegram.messenger.mod.ModBadges;
+import org.telegram.messenger.mod.ModStrings;
+import org.telegram.ui.ActionBar.AlertDialog;
+import org.telegram.ui.ActionBar.Theme;
+
+/** The window where the owner of the phone gives a badge to a person: picture and tap text. */
+public class ModBadgeDialog {
+
+    private static final int COLUMNS = 6;
+
+    private static class DesignCell extends View {
+
+        final int design;
+        boolean selected;
+        private final Paint ringPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+
+        DesignCell(Context context, int design) {
+            super(context);
+            this.design = design;
+            ringPaint.setStyle(Paint.Style.STROKE);
+            ringPaint.setStrokeWidth(dp(2));
+        }
+
+        @Override
+        protected void onDraw(Canvas canvas) {
+            final float w = getWidth();
+            final float h = getHeight();
+            final float size = Math.min(w, h) - dp(8);
+            if (selected) {
+                ringPaint.setColor(Theme.getColor(Theme.key_dialogTextBlack));
+                canvas.drawRoundRect(dp(2), dp(2), w - dp(2), h - dp(2), dp(10), dp(10), ringPaint);
+            }
+            ModBadges.draw(canvas, design, (w - size) / 2f, (h - size) / 2f, size, 255);
+        }
+    }
+
+    public static void show(Context context, long userId, String userName, Runnable onChanged) {
+        if (context == null) {
+            return;
+        }
+        final int[] selectedDesign = {Math.max(1, ModBadges.getDesign(userId))};
+        final boolean hadBadge = ModBadges.has(userId);
+
+        final LinearLayout content = new LinearLayout(context);
+        content.setOrientation(LinearLayout.VERTICAL);
+        content.setPadding(dp(16), dp(4), dp(16), dp(4));
+
+        final TextView hint = new TextView(context);
+        hint.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14);
+        hint.setTextColor(Theme.getColor(Theme.key_dialogTextGray2));
+        hint.setText(ModStrings.t("Галочку побачать усі, хто має SKgram. До людини вона дійде з вашим наступним повідомленням їй (у неї теж має бути SKgram). У Telegram і в людей без SKgram її немає. Оберіть малюнок:",
+                "Галочку увидят все, у кого есть SKgram. До человека она дойдёт с вашим следующим сообщением ему (у него тоже должен быть SKgram). В Telegram и у людей без SKgram её нет. Выберите рисунок:",
+                "Everyone with SKgram will see this badge. It reaches the person with your next message to them (they need SKgram too). It does not exist in Telegram or for people without SKgram. Choose a picture:"));
+        content.addView(hint, new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
+
+        final DesignCell[] cells = new DesignCell[ModBadges.DESIGN_COUNT + 1];
+        final LinearLayout grid = new LinearLayout(context);
+        grid.setOrientation(LinearLayout.VERTICAL);
+        LinearLayout row = null;
+        for (int design = 1; design <= ModBadges.DESIGN_COUNT; design++) {
+            if ((design - 1) % COLUMNS == 0) {
+                row = new LinearLayout(context);
+                row.setOrientation(LinearLayout.HORIZONTAL);
+                grid.addView(row, new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, dp(48)));
+            }
+            final int d = design;
+            final DesignCell cell = new DesignCell(context, design);
+            cell.selected = design == selectedDesign[0];
+            cells[design] = cell;
+            cell.setOnClickListener(v -> {
+                selectedDesign[0] = d;
+                for (int i = 1; i < cells.length; i++) {
+                    cells[i].selected = i == d;
+                    cells[i].invalidate();
+                }
+            });
+            row.addView(cell, new LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.MATCH_PARENT, 1f));
+        }
+        final LinearLayout.LayoutParams gridParams = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT);
+        gridParams.topMargin = dp(8);
+        content.addView(grid, gridParams);
+
+        final TextView textLabel = new TextView(context);
+        textLabel.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14);
+        textLabel.setTextColor(Theme.getColor(Theme.key_dialogTextGray2));
+        textLabel.setText(ModStrings.t("Текст, який з'явиться, коли ви натиснете на галочку (в інших людей буде стандартний):", "Текст, который появится, когда вы нажмёте на галочку (у других людей будет стандартный):", "Text that appears when you tap the badge (other people see a standard one):"));
+        final LinearLayout.LayoutParams labelParams = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT);
+        labelParams.topMargin = dp(12);
+        content.addView(textLabel, labelParams);
+
+        final EditText editText = new EditText(context);
+        editText.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 16);
+        editText.setTextColor(Theme.getColor(Theme.key_dialogTextBlack));
+        editText.setHintTextColor(Theme.getColor(Theme.key_dialogTextHint));
+        editText.setHint(ModStrings.t("Наприклад: найкращий друг", "Например: лучший друг", "For example: best friend"));
+        editText.setInputType(InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_FLAG_MULTI_LINE | InputType.TYPE_TEXT_FLAG_CAP_SENTENCES);
+        editText.setMinLines(2);
+        editText.setMaxLines(5);
+        editText.setGravity(Gravity.TOP | Gravity.START);
+        editText.setFilters(new InputFilter[]{new InputFilter.LengthFilter(300)});
+        editText.setText(ModBadges.getText(userId));
+        editText.setSelection(editText.getText().length());
+        content.addView(editText, new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
+
+        final ScrollView scrollView = new ScrollView(context);
+        scrollView.addView(content, new ViewGroup.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
+
+        final AlertDialog.Builder builder = new AlertDialog.Builder(context);
+        builder.setTitle(ModStrings.t("Галочка для ", "Галочка для ", "Badge for ") + (userName == null || userName.length() == 0 ? ModStrings.t("людини", "человека", "this person") : userName));
+        builder.setView(scrollView);
+        builder.setPositiveButton(hadBadge ? ModStrings.t("Зберегти", "Сохранить", "Save") : ModStrings.t("Видати", "Выдать", "Give"), (dialog, which) -> {
+            ModBadges.set(userId, selectedDesign[0], editText.getText().toString());
+            ModBadges.notifyChanged();
+            if (onChanged != null) {
+                onChanged.run();
+            }
+        });
+        if (hadBadge) {
+            builder.setNeutralButton(ModStrings.t("Зняти", "Снять", "Remove"), (dialog, which) -> {
+                ModBadges.remove(userId);
+                ModBadges.notifyChanged();
+                if (onChanged != null) {
+                    onChanged.run();
+                }
+            });
+        }
+        builder.setNegativeButton(ModStrings.t("Скасувати", "Отмена", "Cancel"), null);
+        builder.show();
+    }
+}
