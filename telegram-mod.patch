+
+    /** Designs are numbered from 1 (0 = no badge). */
+    public static final int DESIGN_COUNT = DESIGNS.length - 1;
+
+    private static final Path[] seals = new Path[SEAL_COUNT];
+    private static final Path[] fills = new Path[G_COUNT];
+    private static final Path[] strokes = new Path[DATA_GLYPHS];
+    private static final Shader[] shaders = new Shader[DESIGN_COUNT + 1];
+    private static Path sparkles;
+
+    private static final Paint fillPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private static final Paint strokePaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private static final Paint textPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private static final CornerPathEffect softSeal = new CornerPathEffect(0.12f);
+    private static final CornerPathEffect softGlyph = new CornerPathEffect(0.04f);
+
+    static {
+        strokePaint.setStyle(Paint.Style.STROKE);
+        strokePaint.setStrokeCap(Paint.Cap.ROUND);
+        strokePaint.setStrokeJoin(Paint.Join.ROUND);
+        textPaint.setTypeface(Typeface.DEFAULT_BOLD);
+        textPaint.setTextAlign(Paint.Align.CENTER);
+    }
+
+    private static Path wavy(int waves, float base, float amplitude) {
+        final Path p = new Path();
+        final int steps = 160;
+        for (int i = 0; i <= steps; i++) {
+            final double t = 2 * Math.PI * i / steps;
+            final double r = base + amplitude * Math.cos(waves * t);
+            final float x = (float) (r * Math.cos(t));
+            final float y = (float) (r * Math.sin(t));
+            if (i == 0) {
+                p.moveTo(x, y);
+            } else {
+                p.lineTo(x, y);
+            }
+        }
+        p.close();
+        return p;
+    }
+
+    private static Path polygon(float... xy) {
+        final Path p = new Path();
+        for (int i = 0; i + 1 < xy.length; i += 2) {
+            if (i == 0) {
+                p.moveTo(xy[i], xy[i + 1]);
+            } else {
+                p.lineTo(xy[i], xy[i + 1]);
+            }
+        }
+        p.close();
+        return p;
+    }
+
+    /** Star with the given number of points around (cx, cy). */
+    private static Path star(int points, float cx, float cy, float outer, float inner) {
+        final float[] xy = new float[points * 4];
+        for (int i = 0; i < points * 2; i++) {
+            final double a = -Math.PI / 2 + i * Math.PI / points;
+            final float r = i % 2 == 0 ? outer : inner;
+            xy[i * 2] = cx + (float) (r * Math.cos(a));
+            xy[i * 2 + 1] = cy + (float) (r * Math.sin(a));
+        }
+        return polygon(xy);
+    }
+
+    /** A path from the compact text of ModBadgeGlyphs: coordinates in 1/1000, so the picture is 1 x 1 around (0, 0). */
+    private static Path parse(String d) {
+        final Path p = new Path();
+        final float[] v = new float[6];
+        final int n = d.length();
+        char cmd = 'M';
+        int i = 0;
+        while (i < n) {
+            final char c = d.charAt(i);
+            if (c == ' ') {
+                i++;
+            } else if (c == 'Z') {
+                p.close();
+                i++;
+            } else if (c == 'M' || c == 'L' || c == 'C') {
+                cmd = c;
+                i++;
+            } else {
+                final int count = cmd == 'C' ? 6 : 2;
+                for (int k = 0; k < count; k++) {
+                    while (d.charAt(i) == ' ') {
+                        i++;
+                    }
+                    int j = i;
+                    while (j < n && d.charAt(j) != ' ' && !Character.isLetter(d.charAt(j))) {
+                        j++;
+                    }
+                    v[k] = Integer.parseInt(d.substring(i, j)) * 0.001f;
+                    i = j;
+                }
+                if (cmd == 'C') {
+                    p.cubicTo(v[0], v[1], v[2], v[3], v[4], v[5]);
+                } else if (cmd == 'M') {
+                    p.moveTo(v[0], v[1]);
+                    cmd = 'L';
+                } else {
+                    p.lineTo(v[0], v[1]);
+                }
+            }
+        }
+        return p;
+    }
+
+    private static Path seal(int seal) {
+        final Path p = new Path();
+        switch (seal) {
+            case SEAL_WAVY10:
+                return wavy(10, 0.88f, 0.06f);
+            case SEAL_WAVY8:
+                return wavy(8, 0.86f, 0.09f);
+            case SEAL_WAVY12:
+                return wavy(12, 0.87f, 0.07f);
+            case SEAL_HEX: {
+                final float[] xy = new float[12];
+                for (int i = 0; i < 6; i++) {
+                    final double a = Math.PI / 6 + i * Math.PI / 3;
+                    xy[i * 2] = (float) (0.95 * Math.cos(a));
+                    xy[i * 2 + 1] = (float) (0.95 * Math.sin(a));
+                }
+                return polygon(xy);
+            }
+            case SEAL_SQUIRCLE:
+                p.addRoundRect(new RectF(-0.84f, -0.84f, 0.84f, 0.84f), 0.36f, 0.36f, Path.Direction.CW);
+                return p;
+            case SEAL_SHIELD:
+                p.moveTo(0f, -0.96f);
+                p.lineTo(0.82f, -0.66f);
+                p.lineTo(0.82f, 0.06f);
+                p.quadTo(0.82f, 0.72f, 0f, 0.98f);
+                p.quadTo(-0.82f, 0.72f, -0.82f, 0.06f);
+                p.lineTo(-0.82f, -0.66f);
+                p.close();
+                return p;
+            case SEAL_BURST:
+                return star(12, 0f, 0f, 0.97f, 0.80f);
+            case SEAL_FLOWER:
+                return wavy(6, 0.80f, 0.11f);
+            default:
+                p.addCircle(0, 0, 0.92f, Path.Direction.CW);
+                return p;
+        }
+    }
+
+    /** The pictures that are drawn in code (a check mark is only a line). */
+    private static Path glyph(int glyph) {
+        final Path p = new Path();
+        switch (glyph) {
+            case G_CHECK:
+                p.moveTo(-0.36f, 0.02f);
+                p.lineTo(-0.10f, 0.30f);
+                p.lineTo(0.40f, -0.28f);
+                return p;
+            case G_STAR:
+                return star(5, 0f, 0.03f, 0.50f, 0.21f);
+            case G_BOLT:
+                return polygon(0.10f, -0.50f, -0.30f, 0.08f, -0.04f, 0.08f, -0.12f, 0.50f, 0.30f, -0.10f, 0.04f, -0.10f);
+            case G_CROWN:
+                return polygon(-0.48f, 0.34f, -0.48f, -0.28f, -0.24f, -0.02f, 0f, -0.40f, 0.24f, -0.02f, 0.48f, -0.28f, 0.48f, 0.34f);
+            case G_MOON: {
+                p.addCircle(-0.02f, 0f, 0.46f, Path.Direction.CW);
+                final Path cut = new Path();
+                cut.addCircle(0.2f, -0.12f, 0.38f, Path.Direction.CW);
+                p.op(cut, Path.Op.DIFFERENCE);
+                return p;
+            }
+            case G_FLAME:
+                p.moveTo(0.02f, -0.50f);
+                p.cubicTo(0.12f, -0.22f, 0.40f, -0.10f, 0.40f, 0.18f);
+                p.cubicTo(0.40f, 0.38f, 0.22f, 0.50f, 0f, 0.50f);
+                p.cubicTo(-0.24f, 0.50f, -0.40f, 0.36f, -0.40f, 0.14f);
+                p.cubicTo(-0.40f, -0.04f, -0.28f, -0.14f, -0.20f, -0.26f);
+                p.cubicTo(-0.16f, -0.08f, -0.06f, -0.06f, -0.02f, -0.14f);
+                p.cubicTo(-0.06f, -0.30f, -0.04f, -0.40f, 0.02f, -0.50f);
+                p.close();
+                return p;
+            default:
+                return p;
+        }
+    }
+
+    private static Path sparklePath() {
+        final float[][] spots = {{-0.80f, -0.74f, 0.22f}, {0.84f, -0.70f, 0.14f}, {-0.93f, 0.02f, 0.10f}, {-0.74f, 0.72f, 0.16f}, {0.92f, 0.20f, 0.10f}};
+        final Path p = new Path();
+        for (float[] s : spots) {
+            p.moveTo(s[0], s[1] - s[2]);
+            p.quadTo(s[0], s[1], s[0] + s[2], s[1]);
+            p.quadTo(s[0], s[1], s[0], s[1] + s[2]);
+            p.quadTo(s[0], s[1], s[0] - s[2], s[1]);
+            p.quadTo(s[0], s[1], s[0], s[1] - s[2]);
+            p.close();
+        }
+        return p;
+    }
+
+    private static float brightness(int color) {
+        return (0.299f * Color.red(color) + 0.587f * Color.green(color) + 0.114f * Color.blue(color)) / 255f;
+    }
+
+    /** Everything a design needs is built the first time it is drawn (always on the UI thread). */
+    private static void ensureBuilt(int design) {
+        if (sparkles == null) {
+            sparkles = sparklePath();
+        }
+        final int[] d = DESIGNS[design];
+        if (seals[d[0]] == null) {
+            seals[d[0]] = seal(d[0]);
+        }
+        final int g = d[1];
+        if (fills[g] == null) {
+            if (g < DATA_GLYPHS) {
+                fills[g] = parse(ModBadgeGlyphs.FILL[g]);
+                strokes[g] = parse(ModBadgeGlyphs.STROKE[g]);
+            } else {
+                fills[g] = glyph(g);
+            }
+        }
+        if (shaders[design] == null) {
+            shaders[design] = d[2] == 0
+                    ? new SweepGradient(0, 0, new int[]{0xFFFF5252, 0xFFFFB74D, 0xFFFFEE58, 0xFF66BB6A, 0xFF42A5F5, 0xFFAB47BC, 0xFFFF5252}, null)
+                    : new LinearGradient(-0.8f, -0.9f, 0.8f, 0.9f, d[2], d[3], Shader.TileMode.CLAMP);
+        }
+    }
+
+    /** Draws a badge into the square with this top left corner and this size (px). */
+    public static void draw(Canvas canvas, int design, float left, float top, float size, int alpha255) {
+        if (design < 1 || design > DESIGN_COUNT || alpha255 <= 0) {
+            return;
+        }
+        ensureBuilt(design);
+        final int[] d = DESIGNS[design];
+        final int seal = d[0];
+        final int glyph = d[1];
+        final boolean sparkling = d[5] == 1;
+        final boolean rainbow = d[2] == 0;
+
+        canvas.save();
+        canvas.translate(left + size / 2f, top + size / 2f);
+        canvas.scale(size / 2f, size / 2f);
+
+        // sparkles around the seal: the light color of the badge (the dark one on a light seal, white on a black one)
+        if (sparkling) {
+            fillPaint.setShader(null);
+            fillPaint.setColor(brightness(d[2]) > 0.85f ? d[3] : brightness(d[3]) < 0.1f ? WHITE : d[2]);
+            fillPaint.setAlpha(alpha255);
+            canvas.drawPath(sparkles, fillPaint);
+        }
+
+        final float sealScale = sparkling ? 0.76f : 0.94f;
+        canvas.scale(sealScale, sealScale);
+
+        // seal with a thin darker edge
+        final boolean softCorners = seal == SEAL_HEX || seal == SEAL_BURST || seal == SEAL_SHIELD;
+        fillPaint.setShader(shaders[design]);
+        fillPaint.setPathEffect(softCorners ? softSeal : null);
+        fillPaint.setAlpha(alpha255);
+        canvas.drawPath(seals[seal], fillPaint);
+        fillPaint.setShader(null);
+        fillPaint.setPathEffect(null);
+        strokePaint.setPathEffect(softCorners ? softSeal : null);
+        strokePaint.setColor(rainbow ? 0xFF000000 : d[3]);
+        strokePaint.setAlpha(rainbow ? alpha255 / 5 : alpha255 / 2);
+        strokePaint.setStrokeWidth(0.04f);
+        canvas.drawPath(seals[seal], strokePaint);
+        strokePaint.setPathEffect(null);
+
+        // picture inside
+        final int color = d[4];
+        if (glyph == G_CHECK) {
+            strokePaint.setColor(color);
+            strokePaint.setAlpha(alpha255);
+            strokePaint.setStrokeWidth(0.17f);
+            canvas.drawPath(fills[glyph], strokePaint);
+        } else if (glyph == G_SK || glyph == G_VIP) {
+            textPaint.setColor(color);
+            textPaint.setAlpha(alpha255);
+            textPaint.setTextSize(glyph == G_SK ? 46f : 32f);
+            canvas.save();
+            canvas.scale(0.01f, 0.01f);
+            canvas.drawText(glyph == G_SK ? "SK" : "VIP", 0f, glyph == G_SK ? 16f : 11f, textPaint);
+            canvas.restore();
+        } else if (glyph < DATA_GLYPHS) {
+            final float s = ModBadgeGlyphs.SCALE[glyph];
+            canvas.scale(s, s);
+            fillPaint.setColor(color);
+            fillPaint.setAlpha(alpha255);
+            canvas.drawPath(fills[glyph], fillPaint);
+            if (ModBadgeGlyphs.STROKE_WIDTH[glyph] > 0) {
+                strokePaint.setColor(color);
+                strokePaint.setAlpha(alpha255);
+                strokePaint.setStrokeWidth(ModBadgeGlyphs.STROKE_WIDTH[glyph] * 0.0012f);
+                canvas.drawPath(strokes[glyph], strokePaint);
+            }
+        } else {
+            fillPaint.setColor(color);
+            fillPaint.setAlpha(alpha255);
+            fillPaint.setPathEffect(softGlyph);
+            canvas.drawPath(fills[glyph], fillPaint);
+            fillPaint.setPathEffect(null);
+        }
+
+        canvas.restore();
+    }
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/mod/ModKeys.java b/TMessagesProj/src/main/java/org/telegram/messenger/mod/ModKeys.java
new file mode 100644
index 0000000..7adee22
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/mod/ModKeys.java
@@ -0,0 +1,161 @@
+package org.telegram.messenger.mod;
+
+import android.content.Context;
+import android.content.pm.PackageInfo;
+import android.content.pm.PackageManager;
+import android.content.pm.Signature;
+import android.content.pm.SigningInfo;
+import android.os.Build;
+
+import org.telegram.messenger.ApplicationLoader;
+import org.telegram.messenger.BuildVars;
+import org.telegram.messenger.FileLog;
+
+import java.security.MessageDigest;
+
+/**
+ * Keeps the Telegram API id and API hash of the owner out of sight.
+ *
+ * The build (see .github/workflows/build.yml) does not write the keys into the code as plain text.
+ * It encrypts them with a key that is made from the certificate that signs this APK, and puts only
+ * the encrypted bytes (PAYLOAD) and a random salt (SALT) here. At run time the key is made again from
+ * the certificate of the installed app and the keys are decrypted into memory.
+ *
+ * What this gives:
+ *  - the keys are not in the APK as readable text, so searching the unpacked APK or opening it in a
+ *    decompiler shows nothing useful;
+ *  - a copy of the APK that was changed and signed with another certificate cannot decrypt them.
+ *
+ * What this cannot give: the app has to send the keys to Telegram, so a person with a rooted phone
+ * and a debugging tool can still read them from the memory of the running app. No Android app can
+ * prevent that. The keys are not a password for the account, they only name the application.
+ *
+ * While the markers below are not replaced (an old build.yml, or a local build), the plain values
+ * from BuildVars are used.
+ */
+public class ModKeys {
+
+    private static final String PAYLOAD = "@@SK_PAYLOAD@@";
+    private static final String SALT = "@@SK_SALT@@";
+
+    private static boolean resolved;
+    private static boolean failed;
+    private static int resolvedId;
+    private static String resolvedHash;
+
+    public static int appId() {
+        resolve();
+        return resolved ? resolvedId : BuildVars.APP_ID;
+    }
+
+    public static String appHash() {
+        resolve();
+        return resolved ? resolvedHash : BuildVars.APP_HASH;
+    }
+
+    private static synchronized void resolve() {
+        if (resolved || failed) {
+            return;
+        }
+        if (PAYLOAD.startsWith("@@")) {
+            // the build did not put encrypted keys here: plain values from BuildVars are used
+            return;
+        }
+        final byte[] cert = certificateDigest();
+        if (cert == null) {
+            // the app is not fully started yet: try again at the next call
+            return;
+        }
+        try {
+            final String plain = decrypt(hexToBytes(PAYLOAD), hexToBytes(SALT), cert);
+            final int colon = plain.indexOf(':');
+            if (colon > 0 && colon <= 10 && plain.length() == colon + 33 && isDigits(plain, 0, colon) && isHex(plain, colon + 1, plain.length())) {
+                resolvedId = Integer.parseInt(plain.substring(0, colon));
+                resolvedHash = plain.substring(colon + 1);
+                resolved = true;
+            } else {
+                // decrypted into garbage: the APK was signed with another certificate
+                failed = true;
+            }
+        } catch (Throwable e) {
+            FileLog.e(e);
+            failed = true;
+        }
+    }
+
+    private static boolean isDigits(String s, int from, int to) {
+        for (int i = from; i < to; i++) {
+            char c = s.charAt(i);
+            if (c < '0' || c > '9') {
+                return false;
+            }
+        }
+        return to > from;
+    }
+
+    private static boolean isHex(String s, int from, int to) {
+        for (int i = from; i < to; i++) {
+            char c = s.charAt(i);
+            if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F'))) {
+                return false;
+            }
+        }
+        return to > from;
+    }
+
+    /** SHA-256 of the certificate that signed the installed app (the same value that apksigner prints). */
+    @SuppressWarnings("deprecation")
+    private static byte[] certificateDigest() {
+        try {
+            final Context context = ApplicationLoader.applicationContext;
+            if (context == null) {
+                return null;
+            }
+            final PackageManager pm = context.getPackageManager();
+            Signature[] signatures = null;
+            if (Build.VERSION.SDK_INT >= 28) {
+                final PackageInfo info = pm.getPackageInfo(context.getPackageName(), PackageManager.GET_SIGNING_CERTIFICATES);
+                final SigningInfo signingInfo = info.signingInfo;
+                if (signingInfo != null) {
+                    signatures = signingInfo.getApkContentsSigners();
+                }
+            } else {
+                final PackageInfo info = pm.getPackageInfo(context.getPackageName(), PackageManager.GET_SIGNATURES);
+                signatures = info.signatures;
+            }
+            if (signatures == null || signatures.length == 0) {
+                return null;
+            }
+            return MessageDigest.getInstance("SHA-256").digest(signatures[0].toByteArray());
+        } catch (Throwable e) {
+            FileLog.e(e);
+            return null;
+        }
+    }
+
+    /** Stream cipher: block i of the key stream is SHA-256(certificate digest, salt, i). */
+    static String decrypt(byte[] data, byte[] salt, byte[] cert) throws Exception {
+        final MessageDigest digest = MessageDigest.getInstance("SHA-256");
+        final byte[] out = new byte[data.length];
+        for (int block = 0; block * 32 < data.length; block++) {
+            digest.reset();
+            digest.update(cert);
+            digest.update(salt);
+            digest.update(new byte[]{(byte) (block >> 8), (byte) block});
+            final byte[] stream = digest.digest();
+            for (int i = 0; i < 32 && block * 32 + i < data.length; i++) {
+                out[block * 32 + i] = (byte) (data[block * 32 + i] ^ stream[i]);
+            }
+        }
+        return new String(out, "UTF-8");
+    }
+
+    static byte[] hexToBytes(String hex) {
+        final int length = hex.length() / 2;
+        final byte[] result = new byte[length];
+        for (int i = 0; i < length; i++) {
+            result[i] = (byte) ((Character.digit(hex.charAt(i * 2), 16) << 4) | Character.digit(hex.charAt(i * 2 + 1), 16));
+        }
+        return result;
+    }
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/mod/ModMarker.java b/TMessagesProj/src/main/java/org/telegram/messenger/mod/ModMarker.java
new file mode 100644
index 0000000..9ee55cb
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/mod/ModMarker.java
@@ -0,0 +1,169 @@
+package org.telegram.messenger.mod;
+
+import org.telegram.messenger.DialogObject;
+import org.telegram.messenger.UserConfig;
+
+/**
+ * Invisible marker appended to the end of outgoing text messages. Friends who run this app read it
+ * and remember the sender's tick style and badge; everybody else just sees an empty trailing character.
+ *
+ * Layout of the tail of the text:
+ *   SEP + 32 bits (ZERO / ONE characters) + SEP + TERM
+ * The bits are 4 bytes: magic, tick, info, checksum.
+ * info: the low 6 bits are a badge design (0 = none), bit 6 (GRANT) says that the badge is not the
+ * sender's own but a gift of the owner to the person who receives the message (see ModBadges).
+ * TERM (braille blank) is a real, non-whitespace character, so the server and clients do not trim
+ * the zero-width characters in front of it.
+ */
+public class ModMarker {
+
+    private static final char SEP = '\u2060';    // word joiner
+    private static final char ZERO = '\u200B';   // zero width space
+    private static final char ONE = '\u200D';    // zero width joiner
+    private static final char TERM = '\u2800';   // braille pattern blank
+
+    private static final int GRANT = 0x40;
+    private static final int PAYLOAD_BYTES = 4;
+    private static final int MAGIC = 0xA7;
+    public static final int MARKER_LENGTH = 1 + PAYLOAD_BYTES * 8 + 1 + 1;
+
+    public static class Data {
+        /** Tick id, 0 means "the sender went back to the standard ticks". */
+        public int tick;
+        /** Badge design, 0 = none: the sender's own one, or the one given to the receiver if grant is set. */
+        public int badge;
+        /** The owner gives that badge to the person who receives this message. */
+        public boolean grant;
+    }
+
+    /** Returns the text with the marker added, or the same text if nothing has to be added. */
+    public static String decorate(String text, long dialogId, boolean plainText, int account) {
+        if (text == null || text.length() == 0 || !plainText || DialogObject.isEncryptedDialog(dialogId)) {
+            return text;
+        }
+        // bot commands must stay untouched, very long messages must not exceed the limit
+        if (text.charAt(0) == '/' || text.length() > 3900 || parse(text) != null) {
+            return text;
+        }
+        int tick = ModSettings.getSharedTick();
+        if (tick < 0 || tick >= ModTicks.COUNT) {
+            tick = 0;
+        }
+        final long me = UserConfig.getInstance(account).getClientUserId();
+        // a badge that the owner gave to the person of this chat travels in the next messages to him
+        final int grant = DialogObject.isUserDialog(dialogId) && dialogId != me ? ModBadges.takeGrant(dialogId) : -1;
+        int info;
+        boolean reset = false;
+        if (grant >= 0) {
+            info = GRANT | grant;
+        } else {
+            info = ModSettings.isShareWithFriends() ? ModBadges.getDesign(me) : 0;
+            if (tick == 0 && info == 0) {
+                // after the tick or badge was switched off, a few messages still tell friends to forget it
+                if (ModSettings.getTickResetsLeft() <= 0) {
+                    return text;
+                }
+                reset = true;
+            }
+        }
+        int[] bytes = new int[PAYLOAD_BYTES];
+        bytes[0] = MAGIC;
+        bytes[1] = tick & 0xFF;
+        bytes[2] = info;
+        bytes[3] = checksum(bytes);
+
+        StringBuilder sb = new StringBuilder(text.length() + MARKER_LENGTH);
+        sb.append(text);
+        sb.append(SEP);
+        for (int i = 0; i < PAYLOAD_BYTES; i++) {
+            for (int bit = 7; bit >= 0; bit--) {
+                sb.append(((bytes[i] >> bit) & 1) == 1 ? ONE : ZERO);
+            }
+        }
+        sb.append(SEP);
+        sb.append(TERM);
+        if (reset) {
+            ModSettings.useTickReset();
+        }
+        return sb.toString();
+    }
+
+    /**
+     * An incoming message with a marker was read: remember the tick and the badge of the sender and,
+     * if the owner of the build gave me a badge, take it. peerUserId is the user the message was sent
+     * to (it is me for a private chat), me is my own id.
+     */
+    public static void receive(Data data, long senderId, int date, long peerUserId, long me) {
+        if (data.grant) {
+            ModPeers.remember(senderId, data.tick, -1, date);
+            if (me != 0 && peerUserId == me && ModOwner.isOwnerId(senderId)) {
+                ModBadges.applyGrant(me, data.badge, date);
+            }
+        } else {
+            ModPeers.remember(senderId, data.tick, data.badge, date);
+        }
+    }
+
+    private static int checksum(int[] bytes) {
+        int check = 0;
+        for (int i = 0; i < PAYLOAD_BYTES - 1; i++) {
+            check ^= bytes[i];
+        }
+        return check & 0xFF;
+    }
+
+    /** Reads the marker from the end of the text, returns null if there is none. */
+    public static Data parse(CharSequence text) {
+        if (text == null) {
+            return null;
+        }
+        int len = text.length();
+        if (len < MARKER_LENGTH) {
+            return null;
+        }
+        if (text.charAt(len - 1) != TERM || text.charAt(len - 2) != SEP) {
+            return null;
+        }
+        int start = len - MARKER_LENGTH;
+        if (text.charAt(start) != SEP) {
+            return null;
+        }
+        int[] bytes = new int[PAYLOAD_BYTES];
+        int pos = start + 1;
+        for (int i = 0; i < PAYLOAD_BYTES; i++) {
+            int value = 0;
+            for (int bit = 0; bit < 8; bit++) {
+                char c = text.charAt(pos++);
+                if (c == ONE) {
+                    value = (value << 1) | 1;
+                } else if (c == ZERO) {
+                    value = value << 1;
+                } else {
+                    return null;
+                }
+            }
+            bytes[i] = value;
+        }
+        if (bytes[0] != MAGIC || bytes[PAYLOAD_BYTES - 1] != checksum(bytes)) {
+            return null;
+        }
+        if (bytes[1] >= ModTicks.COUNT || (bytes[2] & 0x80) != 0) {
+            return null;
+        }
+        Data data = new Data();
+        data.tick = bytes[1];
+        final int badge = bytes[2] & 0x3F;
+        data.badge = badge <= ModBadges.DESIGN_COUNT ? badge : 0;
+        data.grant = (bytes[2] & GRANT) != 0;
+        return data;
+    }
+
+    /** Removes the marker from the end of the text (the text must have it, see parse). */
+    public static CharSequence strip(CharSequence text) {
+        int len = text.length();
+        if (len < MARKER_LENGTH) {
+            return text;
+        }
+        return text.subSequence(0, len - MARKER_LENGTH);
+    }
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/mod/ModOwner.java b/TMessagesProj/src/main/java/org/telegram/messenger/mod/ModOwner.java
new file mode 100644
index 0000000..34e5c78
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/mod/ModOwner.java
@@ -0,0 +1,56 @@
+package org.telegram.messenger.mod;
+
+import org.telegram.messenger.UserConfig;
+
+/**
+ * Only the owner of the build may give badges. The owner is the Telegram account whose numeric id was
+ * put into the OWNER_TG_ID secret of the build (the workflow writes it into IDS). Without the secret
+ * nobody can give badges.
+ */
+public class ModOwner {
+
+    private static final String IDS = "@@SK_OWNER@@";
+
+    private static long[] owners;
+
+    private static synchronized long[] owners() {
+        if (owners == null) {
+            final String[] parts = IDS.split(",");
+            long[] parsed = new long[parts.length];
+            int count = 0;
+            for (String part : parts) {
+                try {
+                    final long id = Long.parseLong(part.trim());
+                    if (id > 0) {
+                        parsed[count++] = id;
+                    }
+                } catch (NumberFormatException ignore) {
+                    // marker not replaced, or no owner set
+                }
+            }
+            owners = java.util.Arrays.copyOf(parsed, count);
+        }
+        return owners;
+    }
+
+    /** True if an owner id was put into this build. */
+    public static boolean isConfigured() {
+        return owners().length > 0;
+    }
+
+    /** True if the account that is logged in under this account number is the owner. */
+    public static boolean isOwner(int account) {
+        final UserConfig config = UserConfig.getInstance(account);
+        return config.isClientActivated() && isOwnerId(config.getClientUserId());
+    }
+
+    /** True if this Telegram user id is the owner (the sender of a badge gift is checked with it). */
+    public static boolean isOwnerId(long id) {
+        for (long owner : owners()) {
+            if (owner == id) {
+                return true;
+            }
+        }
+        return false;
+    }
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/mod/ModPeers.java b/TMessagesProj/src/main/java/org/telegram/messenger/mod/ModPeers.java
new file mode 100644
index 0000000..321d476
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/mod/ModPeers.java
@@ -0,0 +1,105 @@
+package org.telegram.messenger.mod;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+
+import org.telegram.messenger.ApplicationLoader;
+
+import java.util.HashMap;
+import java.util.Map;
+
+/**
+ * Remembers which tick and which badge each friend uses. Only text messages can carry the invisible
+ * marker, so when a text message with a marker arrives, the values are stored here and then used for
+ * all other messages of the same person: photos, videos, stickers, voice messages and so on.
+ * Each entry keeps the date of the message it came from, so older messages that are loaded later
+ * (scrolling up in the history) never replace a newer value.
+ */
+public class ModPeers {
+
+    private static final String PREFS = "mod_peers2";
+
+    /** user id -> (message date << 16) | (badge << 8) | tick */
+    private static HashMap<Long, Long> cache;
+
+    private static SharedPreferences prefs() {
+        return ApplicationLoader.applicationContext.getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+    }
+
+    private static HashMap<Long, Long> map() {
+        if (cache == null) {
+            HashMap<Long, Long> loaded = new HashMap<>();
+            try {
+                Map<String, ?> all = prefs().getAll();
+                for (Map.Entry<String, ?> entry : all.entrySet()) {
+                    if (entry.getValue() instanceof Long) {
+                        loaded.put(Long.parseLong(entry.getKey()), (Long) entry.getValue());
+                    }
+                }
+            } catch (Throwable ignore) {
+            }
+            cache = loaded;
+        }
+        return cache;
+    }
+
+    /** Returns the tick id of that user, or 0 when it is unknown or standard. */
+    public static synchronized int get(long userId) {
+        if (userId <= 0) {
+            return 0;
+        }
+        Long value = map().get(userId);
+        return value == null ? 0 : (int) (value & 0xFF);
+    }
+
+    /** Returns the badge design that this user showed in his messages, or 0. */
+    public static synchronized int getBadge(long userId) {
+        if (userId <= 0) {
+            return 0;
+        }
+        Long value = map().get(userId);
+        return value == null ? 0 : (int) ((value >> 8) & 0xFF);
+    }
+
+    /**
+     * Stores what was seen in a message of that user: the tick (0 = standard) and the badge
+     * (0 = none, -1 = the message says nothing about it, keep the known one).
+     * Returns true if the badge of that user changed.
+     */
+    public static boolean remember(long userId, int tick, int badge, int messageDate) {
+        if (userId <= 0 || tick < 0 || tick >= ModTicks.COUNT) {
+            return false;
+        }
+        boolean changed = false;
+        synchronized (ModPeers.class) {
+            HashMap<Long, Long> map = map();
+            Long old = map.get(userId);
+            final int oldBadge = old == null ? 0 : (int) ((old >> 8) & 0xFF);
+            if (badge < 0) {
+                badge = oldBadge;
+            }
+            final long encoded = (((long) messageDate) << 16) | ((long) (badge & 0xFF) << 8) | tick;
+            if (old != null && (messageDate < (old >> 16) || old == encoded)) {
+                return false;
+            }
+            map.put(userId, encoded);
+            prefs().edit().putLong(String.valueOf(userId), encoded).apply();
+            changed = badge != oldBadge;
+        }
+        if (changed) {
+            ModBadges.notifyChanged();
+        }
+        return changed;
+    }
+
+    /** Forgets the badge of that user (the owner took it away), the tick stays. */
+    public static synchronized void forgetBadge(long userId) {
+        Long old = userId <= 0 ? null : map().get(userId);
+        if (old == null || ((old >> 8) & 0xFF) == 0) {
+            return;
+        }
+        final long encoded = old & ~0xFF00L;
+        map().put(userId, encoded);
+        prefs().edit().putLong(String.valueOf(userId), encoded).apply();
+    }
+}
