+
+    private void showSeekDialog(String title, int min, int max, int current, String unit, IntCallback callback) {
+        LinearLayout layout = new LinearLayout(context);
+        layout.setOrientation(LinearLayout.VERTICAL);
+        layout.setPadding(dp(24), dp(8), dp(24), dp(8));
+
+        TextView valueView = new TextView(context);
+        valueView.setTextSize(18);
+        valueView.setGravity(Gravity.CENTER);
+        valueView.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText));
+        valueView.setText(current + unit);
+        layout.addView(valueView, new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
+
+        SeekBar seekBar = new SeekBar(context);
+        seekBar.setMax(max - min);
+        seekBar.setProgress(Math.max(0, Math.min(max - min, current - min)));
+        seekBar.setOnSeekBarChangeListener(new SeekBar.OnSeekBarChangeListener() {
+            @Override
+            public void onProgressChanged(SeekBar bar, int progress, boolean fromUser) {
+                valueView.setText((progress + min) + unit);
+            }
+
+            @Override
+            public void onStartTrackingTouch(SeekBar bar) {
+            }
+
+            @Override
+            public void onStopTrackingTouch(SeekBar bar) {
+            }
+        });
+        layout.addView(seekBar, new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
+
+        AlertDialog.Builder builder = new AlertDialog.Builder(context);
+        builder.setTitle(title);
+        builder.setView(layout);
+        builder.setPositiveButton("OK", (dialog, which) -> callback.run(seekBar.getProgress() + min));
+        builder.setNegativeButton(ModStrings.t("Скасувати", "Отмена", "Cancel"), null);
+        showDialog(builder.create());
+    }
+
+    // ---- wallpaper picking --------------------------------------------------------------
+
+    private void pickWallpaper() {
+        if (getParentActivity() == null) {
+            return;
+        }
+        try {
+            Intent intent = new Intent(Intent.ACTION_OPEN_DOCUMENT);
+            intent.addCategory(Intent.CATEGORY_OPENABLE);
+            intent.setType("video/*");
+            startActivityForResult(intent, REQUEST_PICK_WALLPAPER);
+        } catch (Throwable e) {
+            FileLog.e(e);
+            Toast.makeText(context, ModStrings.t("Не вдалося відкрити вибір файлу", "Не удалось открыть выбор файла", "Could not open the file picker"), Toast.LENGTH_SHORT).show();
+        }
+    }
+
+    @Override
+    public void onActivityResultFragment(int requestCode, int resultCode, Intent data) {
+        if (requestCode != REQUEST_PICK_WALLPAPER || resultCode != android.app.Activity.RESULT_OK || data == null || data.getData() == null) {
+            return;
+        }
+        final Uri uri = data.getData();
+        final Context appContext = context.getApplicationContext();
+        Toast.makeText(context, ModStrings.t("Копіюю відео...", "Копирую видео...", "Copying the video..."), Toast.LENGTH_SHORT).show();
+        Utilities.globalQueue.postRunnable(() -> {
+            boolean ok = false;
+            File target = ModSettings.getWallpaperFile();
+            File temp = new File(target.getParentFile(), "live_wallpaper.tmp");
+            try (InputStream in = appContext.getContentResolver().openInputStream(uri);
+                 OutputStream out = new FileOutputStream(temp)) {
+                if (in != null) {
+                    byte[] buffer = new byte[64 * 1024];
+                    int read;
+                    while ((read = in.read(buffer)) != -1) {
+                        out.write(buffer, 0, read);
+                    }
+                    out.flush();
+                    ok = true;
+                }
+            } catch (Throwable e) {
+                FileLog.e(e);
+            }
+            if (ok) {
+                //noinspection ResultOfMethodCallIgnored
+                target.delete();
+                ok = temp.renameTo(target);
+                if (ok) {
+                    // first frame of the video, so the chat shows the wallpaper at once when it opens
+                    LiveWallpaperView.createPoster();
+                }
+            }
+            final boolean success = ok;
+            AndroidUtilities.runOnUIThread(() -> {
+                if (success) {
+                    ModSettings.setWallpaperEnabled(true);
+                    Toast.makeText(appContext, ModStrings.t("Живі шпалери встановлено", "Живые обои установлены", "Live wallpaper is set"), Toast.LENGTH_SHORT).show();
+                } else {
+                    Toast.makeText(appContext, ModStrings.t("Не вдалося скопіювати відео", "Не удалось скопировать видео", "Could not copy the video"), Toast.LENGTH_SHORT).show();
+                }
+                if (root != null) {
+                    rebuild();
+                }
+            });
+        });
+    }
+
+    // ---- preview of the chosen tick -----------------------------------------------------
+
+    private static class TickPreviewView extends View {
+
+        private final Paint bubblePaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+        private final Paint textPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+        private final Paint timePaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+        private final RectF bubble = new RectF();
+
+        TickPreviewView(Context context) {
+            super(context);
+            textPaint.setTextSize(dp(15));
+            textPaint.setColor(Theme.getColor(Theme.key_chat_messageTextOut));
+            timePaint.setTextSize(dp(12));
+        }
+
+        @Override
+        protected void onDraw(Canvas canvas) {
+            canvas.drawColor(Theme.getColor(Theme.key_windowBackgroundGray));
+            drawBubble(canvas, dp(10), ModStrings.t("Ще не прочитано", "Ещё не прочитано", "Not read yet"), false);
+            drawBubble(canvas, dp(64), ModStrings.t("Вже прочитано", "Уже прочитано", "Already read"), true);
+        }
+
+        private void drawBubble(Canvas canvas, float top, String message, boolean viewed) {
+            float width = getWidth();
+            float bubbleWidth = Math.min(width - dp(32), dp(280));
+            bubble.set(width - dp(16) - bubbleWidth, top, width - dp(16), top + dp(46));
+
+            bubblePaint.setColor(Theme.getColor(Theme.key_chat_outBubble));
+            bubblePaint.setAlpha(ModSettings.applyBubbleAlpha(255));
+            canvas.drawRoundRect(bubble, dp(16), dp(16), bubblePaint);
+
+            canvas.drawText(message, bubble.left + dp(14), bubble.top + dp(19), textPaint);
+
+            int color = Theme.getColor(Theme.key_chat_outTimeText);
+            timePaint.setColor(color);
+            int tick = ModSettings.getMyTick();
+            float tickRight = bubble.right - dp(12);
+            float centerY = bubble.bottom - dp(13);
+            float tickWidth;
+            timePaint.setTextAlign(Paint.Align.RIGHT);
+            if (ModTicks.isCustom(tick)) {
+                tickWidth = ModTicks.previewWidth(tick);
+                ModTicks.drawPreview(canvas, tick, tickRight, centerY, viewed, color);
+            } else {
+                tickWidth = dp(18);
+                canvas.drawText(viewed ? "\u2713\u2713" : "\u2713", tickRight, centerY + dp(4), timePaint);
+            }
+            canvas.drawText("12:30", tickRight - tickWidth - dp(6), centerY + dp(4), timePaint);
+        }
+    }
+}
