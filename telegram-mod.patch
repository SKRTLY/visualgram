+package org.telegram.messenger.mod;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.widget.Toast;
+
+import org.telegram.messenger.AndroidUtilities;
+import org.telegram.messenger.ApplicationLoader;
+import org.telegram.messenger.ChatObject;
+import org.telegram.messenger.MessagesController;
+import org.telegram.messenger.UserConfig;
+import org.telegram.messenger.Utilities;
+import org.telegram.tgnet.ConnectionsManager;
+import org.telegram.tgnet.TLObject;
+import org.telegram.tgnet.TLRPC;
+
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.Map;
+import java.util.Set;
+import java.util.TreeMap;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+/**
+ * The list of badges that everybody with the app sees, no chat with the owner needed.
+ *
+ * The list lives in one message of a small public channel that the owner's app creates by itself
+ * (its name comes from the owner's id, see channelName). Every app reads that message with the
+ * Telegram account that is logged in, so there are no tokens and no other servers:
+ * - the last list that was read is kept on the phone and is used at once when the app starts;
+ * - when the app is opened it asks the channel again (at most once a minute) and redraws the names;
+ * - when the owner gives or takes away a badge, the owner's app edits that message.
+ * Before the first reading the list of the build (BAKED, the file badges.txt) is used.
+ * The value in capitals is filled in by the build workflow.
+ */
+public class ModRegistry {
+
+    private static final String BAKED = "@@SK_BADGES@@";
+    /** Public name of the owner's own channel (secret BADGES_CHANNEL), empty if the app should make its own. */
+    private static final String CUSTOM_CHANNEL = "@@SK_CHANNEL@@";
+    private static final Pattern NAME = Pattern.compile("^[A-Za-z][A-Za-z0-9_]{4,31}$");
+
+    private static final String PREFS = "mod_registry";
+    private static final String HEADER = "# SKgram badges";
+    private static final long INTERVAL = 60 * 1000L;
+    private static final int MAX_TEXT = 300;
+    private static final int MAX_MESSAGE = 4000;
+    private static final int HISTORY = 20;
+    private static final Pattern LINE = Pattern.compile("^(\\d{4,15})[\\s:;,]+(\\d{1,2})(?:[\\s:;,]+(.*))?$");
+
+    private static final class Entry {
+        final int design;
+        final String text;
+
+        Entry(int design, String text) {
+            this.design = design;
+            this.text = text;
+        }
+    }
+
+    private interface Result<T> {
+        void done(T value, String error);
+    }
+
+    private interface Done {
+        void done(String error);
+    }
+
+    private interface Reply {
+        void reply(TLObject response, TLRPC.TL_error error);
+    }
+
+    private static final class Found {
+        int id;
+        String text;
+    }
+
+    private static volatile HashMap<Long, Entry> entries;
+    private static long lastRefresh;
+    private static boolean reading;
+
+    private static TLRPC.Chat cachedChat;
+    private static int cachedAccount = -1;
+
+    private static final TreeMap<Long, String> pendingUpserts = new TreeMap<>();
+    private static final HashSet<Long> pendingRemoves = new HashSet<>();
+    private static boolean publishing;
+
+    private static SharedPreferences prefs() {
+        return ApplicationLoader.applicationContext.getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+    }
+
+    private static HashMap<Long, Entry> parse(String data) {
+        final HashMap<Long, Entry> map = new HashMap<>();
+        if (data == null) {
+            return map;
+        }
+        for (String raw : data.replace("﻿", "").split("\\r?\\n")) {
+            final String line = raw.trim();
+            if (line.length() == 0 || line.charAt(0) == '#') {
+                continue;
+            }
+            final Matcher m = LINE.matcher(line);
+            if (!m.matches()) {
+                continue;
+            }
+            try {
+                final long id = Long.parseLong(m.group(1));
+                final int design = Integer.parseInt(m.group(2));
+                if (design < 1 || design > ModBadges.DESIGN_COUNT) {
+                    continue;
+                }
+                String text = m.group(3) == null ? "" : m.group(3).trim();
+                if (text.length() > MAX_TEXT) {
+                    text = text.substring(0, MAX_TEXT);
+                }
+                map.put(id, new Entry(design, text));
+            } catch (NumberFormatException ignore) {
+            }
+        }
+        return map;
+    }
+
+    private static HashMap<Long, Entry> entries() {
+        HashMap<Long, Entry> map = entries;
+        if (map == null) {
+            synchronized (ModRegistry.class) {
+                if (entries == null) {
+                    String data = BAKED;
+                    try {
+                        // what the channel said the last time is newer than the list of the build
+                        final String cached = prefs().getString("data", null);
+                        if (cached != null) {
+                            data = cached;
+                        }
+                    } catch (Throwable ignore) {
+                    }
+                    entries = parse(data);
+                }
+                map = entries;
+            }
+        }
+        return map;
+    }
+
+    /** Badge design (1..DESIGN_COUNT) of that user in the list, 0 if he is not there. */
+    public static int getDesign(long userId) {
+        final Entry e = userId == 0 ? null : entries().get(userId);
+        return e == null ? 0 : e.design;
+    }
+
+    public static String getText(long userId) {
+        final Entry e = userId == 0 ? null : entries().get(userId);
+        return e == null ? "" : e.text;
+    }
+
+    public static boolean has(long userId) {
+        return getDesign(userId) > 0;
+    }
+
+    private static String line(Entry e) {
+        return e.design + (e.text.length() == 0 ? "" : " " + e.text);
+    }
+
+    private static TreeMap<Long, String> toLines(Map<Long, Entry> map) {
+        final TreeMap<Long, String> result = new TreeMap<>();
+        for (Map.Entry<Long, Entry> e : map.entrySet()) {
+            result.put(e.getKey(), line(e.getValue()));
+        }
+        return result;
+    }
+
+    /** The list as lines "design text" by user id, so the owner can merge his own changes into it. */
+    public static TreeMap<Long, String> lines() {
+        return toLines(entries());
+    }
+
+    // ---- the channel ------------------------------------------------------------------------------
+
+    /**
+     * The public name of the channel with the list: the channel of the owner from the secret
+     * BADGES_CHANNEL, or else a name made from the owner's id. null if this build has no owner.
+     */
+    public static String channelName() {
+        final long owner = ModOwner.firstOwnerId();
+        if (owner <= 0) {
+            return null;
+        }
+        if (NAME.matcher(CUSTOM_CHANNEL).matches()) {
+            return CUSTOM_CHANNEL;
+        }
+        return "skg" + owner + "_list";
+    }
+
+    public static boolean hasChannel() {
+        return channelName() != null;
+    }
+
+    private static int readerAccount() {
+        if (UserConfig.getInstance(UserConfig.selectedAccount).isClientActivated()) {
+            return UserConfig.selectedAccount;
+        }
+        for (int a = 0; a < UserConfig.MAX_ACCOUNT_COUNT; a++) {
+            if (UserConfig.getInstance(a).isClientActivated()) {
+                return a;
+            }
+        }
+        return -1;
+    }
+
+    /** The account of the main owner (only he can write the list), -1 if he is not logged in here. */
+    private static int ownerAccount() {
+        final long owner = ModOwner.firstOwnerId();
+        for (int a = 0; a < UserConfig.MAX_ACCOUNT_COUNT; a++) {
+            final UserConfig config = UserConfig.getInstance(a);
+            if (owner > 0 && config.isClientActivated() && config.getClientUserId() == owner) {
+                return a;
+            }
+        }
+        return -1;
+    }
+
+    private static String errorText(TLRPC.TL_error error) {
+        return error == null || error.text == null ? "ERROR" : error.text;
+    }
+
+    private static void resolve(final int account, final String name, final Result<TLRPC.Chat> result) {
+        if (cachedChat != null && cachedAccount == account) {
+            result.done(cachedChat, null);
+            return;
+        }
+        final TLRPC.TL_contacts_resolveUsername req = new TLRPC.TL_contacts_resolveUsername();
+        req.username = name;
+        ConnectionsManager.getInstance(account).sendRequest(req, (response, error) -> {
+            if (response instanceof TLRPC.TL_contacts_resolvedPeer) {
+                for (TLRPC.Chat chat : ((TLRPC.TL_contacts_resolvedPeer) response).chats) {
+                    if (ChatObject.isChannel(chat)) {
+                        cachedChat = chat;
+                        cachedAccount = account;
+                        result.done(chat, null);
+                        return;
+                    }
+                }
+                result.done(null, "NOT_A_CHANNEL");
+            } else {
+                result.done(null, errorText(error));
+            }
+        });
+    }
+
+    /** Finds the newest message of the channel that holds the list. */
+    private static void loadList(final int account, final TLRPC.Chat chat, final Result<Found> result) {
+        final TLRPC.TL_messages_getHistory req = new TLRPC.TL_messages_getHistory();
+        req.peer = MessagesController.getInputPeer(chat);
+        req.limit = HISTORY;
+        ConnectionsManager.getInstance(account).sendRequest(req, (response, error) -> {
+            if (!(response instanceof TLRPC.messages_Messages)) {
+                result.done(null, errorText(error));
+                return;
+            }
+            final Found found = new Found();
+            final ArrayList<TLRPC.Message> messages = ((TLRPC.messages_Messages) response).messages;
+            for (int a = 0; a < messages.size(); a++) {   // the newest message comes first
+                final TLRPC.Message message = messages.get(a);
+                if (message != null && message.message != null && message.message.startsWith(HEADER)) {
+                    found.id = message.id;
+                    found.text = message.message;
+                    break;
+                }
+            }
+            result.done(found, null);
+        });
+    }
+
+    // ---- reading the list -----------------------------------------------------------------------
+
+    /** Reads the list from the channel again (at most once a minute), call it when the app is opened. */
+    public static void refresh() {
+        final String name = channelName();
+        if (name == null) {
+            return;
+        }
+        final int account = readerAccount();
+        if (account < 0) {
+            return;
+        }
+        final long now = System.currentTimeMillis();
+        synchronized (ModRegistry.class) {
+            if (reading || now - lastRefresh < INTERVAL) {
+                return;
+            }
+            reading = true;
+            lastRefresh = now;
+        }
+        try {
+            resolve(account, name, (chat, error) -> {
+                if (chat == null) {
+                    finishReading();
+                    return;
+                }
+                loadList(account, chat, (found, error2) -> {
+                    try {
+                        if (found != null && found.text != null) {
+                            apply(found.text);
+                        }
+                        if (found != null && found.id != 0) {
+                            countView(account, chat, found.id);
+                        }
+                    } catch (Throwable ignore) {
+                    } finally {
+                        finishReading();
+                    }
+                });
+            });
+        } catch (Throwable e) {
+            finishReading();
+        }
+    }
+
+    private static void finishReading() {
+        synchronized (ModRegistry.class) {
+            reading = false;
+        }
+    }
+
+    /** Uses this text as the list, remembers it and redraws the names if something changed. */
+    private static void apply(String text) {
+        final HashMap<Long, Entry> fresh = parse(text);
+        boolean changed = false;
+        synchronized (ModRegistry.class) {
+            final HashMap<Long, Entry> old = entries();
+            if (old.size() != fresh.size()) {
+                changed = true;
+            } else {
+                for (Map.Entry<Long, Entry> e : fresh.entrySet()) {
+                    final Entry o = old.get(e.getKey());
+                    if (o == null || o.design != e.getValue().design || !o.text.equals(e.getValue().text)) {
+                        changed = true;
+                        break;
+                    }
+                }
+            }
+            entries = fresh;
+        }
+        prefs().edit().putString("data", text).apply();
+        if (changed) {
+            ModBadges.notifyChanged();
+        }
+    }
+
+    // ---- how many people use the app (shown only to the owner) -------------------------------------------
+
+    public interface UsersCallback {
+        /** count is -1 if it could not be read. Called on the UI thread. */
+        void done(int count, String error);
+    }
+
+    /**
+     * Every copy of the app opens the message with the list once per account: Telegram counts a view of a
+     * message of a channel once for every person, so the number of views of that message is the number of
+     * people who use the app (the owner reads it, see fetchUsers). Nothing else is sent, only the
+     * usual "this message was seen".
+     */
+    private static void countView(final int account, final TLRPC.Chat chat, final int messageId) {
+        try {
+            final long userId = UserConfig.getInstance(account).getClientUserId();
+            final String key = "counted_" + userId + "_" + chat.id + "_" + messageId;
+            final SharedPreferences p = prefs();
+            if (userId == 0 || p.getBoolean(key, false)) {
+                return;
+            }
+            final TLRPC.TL_messages_getMessagesViews req = new TLRPC.TL_messages_getMessagesViews();
+            req.peer = MessagesController.getInputPeer(chat);
+            req.id.add(messageId);
+            req.increment = true;
+            ConnectionsManager.getInstance(account).sendRequest(req, (response, error) -> {
+                if (response instanceof TLRPC.TL_messages_messageViews) {
+                    p.edit().putBoolean(key, true).apply();
+                }
+            });
+        } catch (Throwable ignore) {
+        }
+    }
+
+    /** Reads the number of people that use the app (owner only, see countView). */
+    public static void fetchUsers(final UsersCallback callback) {
+        final String name = channelName();
+        final int account = readerAccount();
+        if (name == null || account < 0 || !ModOwner.isOwner(account)) {
+            AndroidUtilities.runOnUIThread(() -> callback.done(-1, "NO_OWNER"));
+            return;
+        }
+        resolve(account, name, (chat, error) -> {
+            if (chat == null) {
+                AndroidUtilities.runOnUIThread(() -> callback.done(-1, error == null ? "ERROR" : error));
+                return;
+            }
+            loadList(account, chat, (found, error2) -> {
+                if (found == null || found.id == 0) {
+                    AndroidUtilities.runOnUIThread(() -> callback.done(-1, found == null ? error2 : "NO_LIST"));
+                    return;
+                }
+                final TLRPC.TL_messages_getMessagesViews req = new TLRPC.TL_messages_getMessagesViews();
+                req.peer = MessagesController.getInputPeer(chat);
+                req.id.add(found.id);
+                req.increment = false;
+                ConnectionsManager.getInstance(account).sendRequest(req, (response, err) -> {
+                    int views = -1;
+                    if (response instanceof TLRPC.TL_messages_messageViews) {
+                        final ArrayList<TLRPC.TL_messageViews> list = ((TLRPC.TL_messages_messageViews) response).views;
+                        if (!list.isEmpty()) {
+                            views = list.get(0).views;
+                        }
+                    }
+                    final int count = views;
+                    final String code = views >= 0 ? null : errorText(err);
+                    AndroidUtilities.runOnUIThread(() -> callback.done(count, code));
+                });
+            });
+        });
+    }
+
+    // ---- changing the list (the owner) ----------------------------------------------------------
+
+    private static void toast(String message) {
+        AndroidUtilities.runOnUIThread(() -> Toast.makeText(ApplicationLoader.applicationContext, message, Toast.LENGTH_LONG).show());
+    }
+
+    private static String describe(String code) {
+        if (code == null) {
+            return "";
+        }
+        if (code.startsWith("USERNAME_OCCUPIED") || code.equals("NOT_A_CHANNEL")) {
+            return ModStrings.t("назва @" + channelName() + " зайнята іншим акаунтом", "имя @" + channelName() + " занято другим аккаунтом", "the name @" + channelName() + " is taken by another account");
+        }
+        if (code.startsWith("CHANNELS_ADMIN_PUBLIC_TOO_MUCH") || code.startsWith("CHANNELS_TOO_MUCH")) {
+            return ModStrings.t("у вас забагато каналів, видаліть один і повторіть", "у вас слишком много каналов, удалите один и повторите", "you have too many channels, delete one and try again");
+        }
+        if (code.startsWith("CHAT_ADMIN_REQUIRED") || code.startsWith("CHAT_WRITE_FORBIDDEN") || code.startsWith("USER_NOT_PARTICIPANT")) {
+            return ModStrings.t("канал @" + channelName() + " створений не вами", "канал @" + channelName() + " создан не вами", "the channel @" + channelName() + " was not created by you");
+        }
+        if (code.startsWith("FLOOD_WAIT") || code.startsWith("FLOOD_PREMIUM_WAIT")) {
+            return ModStrings.t("забагато запитів, спробуйте за хвилину", "слишком много запросов, попробуйте через минуту", "too many requests, try again in a minute");
+        }
+        if (code.equals("TOO_LONG")) {
+            return ModStrings.t("список завеликий для одного повідомлення", "список слишком большой для одного сообщения", "the list is too long for one message");
+        }
+        return code;
+    }
+
+    /** Gives (design 1..), changes or takes away (design 0) the badge of one person in the shared list. */
+    public static void publishChange(long userId, int design, String text) {
+        final TreeMap<Long, String> upserts = new TreeMap<>();
+        final HashSet<Long> removes = new HashSet<>();
+        if (design > 0) {
+            final String oneLine = text == null ? "" : text.replace('\n', ' ').trim();
+            upserts.put(userId, design + (oneLine.length() == 0 ? "" : " " + oneLine));
+        } else {
+            removes.add(userId);
+        }
+        publish(upserts, removes);
+    }
+
+    /**
+     * Writes the changes into the message of the channel: upserts are lines "design text" by user id,
+     * removes are user ids. Changes that come while a write is going on wait for their turn. The
+     * result is shown in a toast.
+     */
+    public static void publish(final Map<Long, String> upserts, final Set<Long> removes) {
+        if (!hasChannel()) {
+            return;
+        }
+        final int account = ownerAccount();
+        if (account < 0) {
+            toast(ModStrings.t("Список для всіх може змінювати лише головний власник збірки.",
+                    "Список для всех может менять только главный владелец сборки.",
+                    "Only the main owner of the build can change the list for everybody."));
+            return;
+        }
+        synchronized (ModRegistry.class) {
+            for (Map.Entry<Long, String> e : upserts.entrySet()) {
+                pendingRemoves.remove(e.getKey());
+                pendingUpserts.put(e.getKey(), e.getValue());
+            }
+            for (Long id : removes) {
+                pendingUpserts.remove(id);
+                pendingRemoves.add(id);
+            }
+            if (publishing) {
+                return;
+            }
+            publishing = true;
+        }
+        runPublish(account);
+    }
+
+    private static void runPublish(final int account) {
+        final TreeMap<Long, String> upserts;
+        final HashSet<Long> removes;
+        synchronized (ModRegistry.class) {
+            upserts = new TreeMap<>(pendingUpserts);
+            removes = new HashSet<>(pendingRemoves);
+            pendingUpserts.clear();
+            pendingRemoves.clear();
+        }
+        try {
+            publishOnce(account, upserts, removes, error -> {
+                if (error == null) {
+                    toast(ModStrings.t("Галочки опубліковано: усі з SKgram побачать їх, щойно відкриють застосунок.",
+                            "Галочки опубликованы: все с SKgram увидят их, как только откроют приложение.",
+                            "Badges published: everybody with SKgram sees them as soon as they open the app."));
+                } else {
+                    toast(ModStrings.t("Не вдалося опублікувати: ", "Не удалось опубликовать: ", "Could not publish: ") + describe(error));
+                }
+                nextPublish(account);
+            });
+        } catch (Throwable e) {
+            toast(ModStrings.t("Не вдалося опублікувати: ", "Не удалось опубликовать: ", "Could not publish: ") + e);
+            nextPublish(account);
+        }
+    }
+
+    private static void nextPublish(int account) {
+        final boolean again;
+        synchronized (ModRegistry.class) {
+            again = !pendingUpserts.isEmpty() || !pendingRemoves.isEmpty();
+            if (!again) {
+                publishing = false;
+            }
+        }
+        if (again) {
+            runPublish(account);
+        }
+    }
+
+    private static void publishOnce(final int account, final Map<Long, String> upserts, final Set<Long> removes, final Done done) {
+        final String name = channelName();
+        resolve(account, name, (chat, error) -> {
+            if (chat != null) {
+                write(account, chat, upserts, removes, done);
+            } else if (error != null && (error.startsWith("USERNAME_NOT_OCCUPIED") || error.startsWith("USERNAME_INVALID"))) {
+                create(account, name, (created, error2) -> {
+                    if (created != null) {
+                        write(account, created, upserts, removes, done);
+                    } else {
+                        done.done(error2);
+                    }
+                });
+            } else {
+                done.done(error);
+            }
+        });
+    }
+
+    /** The channel does not exist yet: create it and give it the public name. */
+    private static void create(final int account, final String name, final Result<TLRPC.Chat> result) {
+        final TLRPC.TL_channels_createChannel req = new TLRPC.TL_channels_createChannel();
+        req.broadcast = true;
+        req.title = "SKgram badges";
+        req.about = "Service channel of SKgram: the list of badges. Please do not delete it.";
+        ConnectionsManager.getInstance(account).sendRequest(req, (response, error) -> {
+            if (!(response instanceof TLRPC.Updates)) {
+                result.done(null, errorText(error));
+                return;
+            }
+            final TLRPC.Updates updates = (TLRPC.Updates) response;
+            MessagesController.getInstance(account).processUpdates(updates, false);
+            final TLRPC.Chat chat = updates.chats.isEmpty() ? null : updates.chats.get(0);
+            if (chat == null) {
+                result.done(null, "ERROR");
+                return;
+            }
+            final TLRPC.TL_channels_updateUsername rename = new TLRPC.TL_channels_updateUsername();
+            rename.channel = MessagesController.getInputChannel(chat);
+            rename.username = name;
+            ConnectionsManager.getInstance(account).sendRequest(rename, (response2, error2) -> {
+                if (response2 instanceof TLRPC.TL_boolTrue) {
+                    cachedChat = chat;
+                    cachedAccount = account;
+                    result.done(chat, null);
+                } else {
+                    // no public name, no use for the channel: remove it again
+                    final TLRPC.TL_channels_deleteChannel delete = new TLRPC.TL_channels_deleteChannel();
+                    delete.channel = MessagesController.getInputChannel(chat);
+                    ConnectionsManager.getInstance(account).sendRequest(delete, (response3, error3) -> {
+                        if (response3 instanceof TLRPC.Updates) {
+                            MessagesController.getInstance(account).processUpdates((TLRPC.Updates) response3, false);
+                        }
+                    });
+                    result.done(null, errorText(error2));
+                }
+            });
+        });
+    }
+
+    private static String compose(Map<Long, String> lines) {
+        final StringBuilder sb = new StringBuilder(HEADER).append('\n');
+        for (Map.Entry<Long, String> e : lines.entrySet()) {
+            sb.append(e.getKey()).append(' ').append(e.getValue()).append('\n');
+        }
+        return sb.toString().trim();
+    }
+
+    /** Puts the changes into the list message of the channel (sends the message if there is none). */
+    private static void write(final int account, final TLRPC.Chat chat, final Map<Long, String> upserts, final Set<Long> removes, final Done done) {
+        loadList(account, chat, (found, error) -> {
+            if (found == null) {
+                done.done(error);
+                return;
+            }
+            // what the channel says is the base; a channel without the message starts from what this phone knows
+            final TreeMap<Long, String> base = found.text != null ? toLines(parse(found.text)) : lines();
+            base.putAll(upserts);
+            for (Long id : removes) {
+                base.remove(id);
+            }
+            final String text = compose(base);
+            if (text.length() > MAX_MESSAGE) {
+                done.done("TOO_LONG");
+                return;
+            }
+            if (found.id != 0 && found.text != null && text.equals(found.text.trim())) {
+                apply(text);
+                done.done(null);
+                return;
+            }
+            final Reply finish = (response, error2) -> {
+                final boolean ok = response instanceof TLRPC.Updates;
+                if (ok) {
+                    MessagesController.getInstance(account).processUpdates((TLRPC.Updates) response, false);
+                }
+                if (ok || errorText(error2).startsWith("MESSAGE_NOT_MODIFIED")) {
+                    apply(text);
+                    done.done(null);
+                } else {
+                    done.done(errorText(error2));
+                }
+            };
+            if (found.id != 0) {
+                final TLRPC.TL_messages_editMessage req = new TLRPC.TL_messages_editMessage();
+                req.peer = MessagesController.getInputPeer(chat);
+                req.id = found.id;
+                req.message = text;
+                req.flags |= 2048;
+                req.no_webpage = true;
+                ConnectionsManager.getInstance(account).sendRequest(req, (response, error2) -> finish.reply(response, error2));
+            } else {
+                final TLRPC.TL_messages_sendMessage req = new TLRPC.TL_messages_sendMessage();
+                req.peer = MessagesController.getInputPeer(chat);
+                req.message = text;
+                req.random_id = Utilities.random.nextLong();
+                req.no_webpage = true;
+                req.silent = true;
+                ConnectionsManager.getInstance(account).sendRequest(req, (response, error2) -> finish.reply(response, error2));
+            }
+        });
+    }
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/mod/ModSettings.java b/TMessagesProj/src/main/java/org/telegram/messenger/mod/ModSettings.java
new file mode 100644
index 000000000..07799a248
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/mod/ModSettings.java
@@ -0,0 +1,205 @@
+package org.telegram.messenger.mod;
+
+import org.telegram.ui.ActionBar.Theme;
+import android.content.Context;
+import android.content.SharedPreferences;
+
+import org.telegram.messenger.ApplicationLoader;
+
+import java.io.File;
+
+/**
+ * Local settings of the visual mod. Everything is stored in one SharedPreferences file
+ * and cached in static fields, because some getters are called on every frame.
+ */
+public class ModSettings {
+
+    private static final String PREFS = "mod_settings";
+    private static final String WALLPAPER_FILE = "live_wallpaper.mp4";
+
+    private static boolean loaded;
+    private static int bubbleAlphaPercent = 70;   // 20..100
+    private static int videoShape;
+    private static boolean wallpaperEnabled = true;
+    private static boolean keepDeleted = true;    // keep the messages that were deleted by the other side
+    private static boolean hidePhone;             // owner only: the own phone number is masked
+    private static int deletedColor;              // 0 = automatic, else the color of the "deleted" trash icon
+    private static int myTick = 0;                // id in ModTicks, 0 = default Telegram ticks
+
+    private static SharedPreferences prefs() {
+        return ApplicationLoader.applicationContext.getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+    }
+
+    private static void ensureLoaded() {
+        if (loaded) {
+            return;
+        }
+        synchronized (ModSettings.class) {
+            if (loaded) {
+                return;
+            }
+            SharedPreferences p = prefs();
+            bubbleAlphaPercent = p.getInt("bubble_alpha", 70);
+            wallpaperEnabled = p.getBoolean("wallpaper_enabled", true);
+            keepDeleted = p.getBoolean("keep_deleted", true);
+            hidePhone = p.getBoolean("hide_phone", false);
+            deletedColor = p.getInt("deleted_color", 0);
+            videoShape = p.getInt("video_shape", 0);
+            if (videoShape < 0 || videoShape >= ModShapes.COUNT) {
+                videoShape = 0;
+            }
+            myTick = p.getInt("my_tick", 0);
+            if (myTick < 0 || myTick >= ModTicks.COUNT) {
+                myTick = 0;
+            }
+            loaded = true;
+        }
+    }
+
+    // ---- messages deleted by the other side ------------------------------------------------
+
+    /** True: a message that somebody deletes stays in the chat with the mark "deleted" (see ModDeleted). */
+    public static boolean isKeepDeleted() {
+        ensureLoaded();
+        return keepDeleted;
+    }
+
+    public static void setKeepDeleted(boolean keep) {
+        ensureLoaded();
+        keepDeleted = keep;
+        prefs().edit().putBoolean("keep_deleted", keep).apply();
+    }
+
+    // ---- own phone number (owner only, see ModPrivacy) ------------------------------------------
+
+    public static boolean isHidePhone() {
+        ensureLoaded();
+        return hidePhone;
+    }
+
+    public static void setHidePhone(boolean hide) {
+        ensureLoaded();
+        hidePhone = hide;
+        prefs().edit().putBoolean("hide_phone", hide).apply();
+    }
+
+    // ---- the mark of a deleted message ---------------------------------------------------------
+
+    /** Color of the trash icon next to the time of a deleted message, 0 = automatic (the color of the time). */
+    public static int getDeletedColor() {
+        ensureLoaded();
+        return deletedColor;
+    }
+
+    public static void setDeletedColor(int color) {
+        ensureLoaded();
+        deletedColor = color;
+        prefs().edit().putInt("deleted_color", color).apply();
+    }
+
+    // ---- shape of video messages ---------------------------------------------------------
+
+    /** Shape (see ModShapes) that the next video message gets, 0 = the usual circle. */
+    public static int getVideoShape() {
+        ensureLoaded();
+        return videoShape;
+    }
+
+    public static void setVideoShape(int shape) {
+        ensureLoaded();
+        videoShape = shape >= 0 && shape < ModShapes.COUNT ? shape : 0;
+        prefs().edit().putInt("video_shape", videoShape).apply();
+    }
+
+    // ---- bubbles -------------------------------------------------------------------------
+
+    public static int getBubbleAlphaPercent() {
+        ensureLoaded();
+        return bubbleAlphaPercent;
+    }
+
+    public static void setBubbleAlphaPercent(int percent) {
+        ensureLoaded();
+        bubbleAlphaPercent = Math.max(20, Math.min(100, percent));
+        prefs().edit().putInt("bubble_alpha", bubbleAlphaPercent).apply();
+    }
+
+    /** Called from MessageDrawable.setAlpha: scales the alpha of every message bubble. */
+    public static int applyBubbleAlpha(int alpha) {
+        ensureLoaded();
+        if (bubbleAlphaPercent >= 100) {
+            return alpha;
+        }
+        float percent = bubbleAlphaPercent / 100f;
+        if (!Theme.isCurrentThemeDark()) {
+            // light bubbles over a dark video or photo would turn muddy gray-olive and the dark text would be lost:
+            // in a light theme the bubbles stay almost opaque (82..100%), only the edge of the video shines through
+            percent = 0.82f + 0.18f * percent;
+        }
+        return (int) (alpha * percent);
+    }
+
+    // ---- live wallpaper -----------------------------------------------------------------
+
+    public static File getWallpaperFile() {
+        return new File(ApplicationLoader.applicationContext.getFilesDir(), WALLPAPER_FILE);
+    }
+
+    public static boolean hasWallpaperFile() {
+        File f = getWallpaperFile();
+        return f.exists() && f.length() > 0;
+    }
+
+    public static boolean isWallpaperEnabled() {
+        ensureLoaded();
+        return wallpaperEnabled;
+    }
+
+    public static void setWallpaperEnabled(boolean enabled) {
+        ensureLoaded();
+        wallpaperEnabled = enabled;
+        prefs().edit().putBoolean("wallpaper_enabled", enabled).apply();
+    }
+
+    private static boolean wallpaperFileCached;
+    private static long wallpaperFileCheckedAt;
+
+    /** The file is checked at most once a second: this is called while the messages are drawn. */
+    public static boolean isWallpaperActive() {
+        if (!isWallpaperEnabled()) {
+            return false;
+        }
+        final long now = android.os.SystemClock.uptimeMillis();
+        if (now - wallpaperFileCheckedAt > 1000 || now < wallpaperFileCheckedAt) {
+            wallpaperFileCheckedAt = now;
+            wallpaperFileCached = hasWallpaperFile();
+        }
+        return wallpaperFileCached;
+    }
+
+    /** Light theme over the live wallpaper: small gray and green texts (time, views) are darker, otherwise they are lost on the video. */
+    public static int readableMeta(int color) {
+        if (!isWallpaperActive() || Theme.isCurrentThemeDark()) {
+            return color;
+        }
+        final int alpha = android.graphics.Color.alpha(color);
+        final int dark = androidx.core.graphics.ColorUtils.blendARGB(color | 0xFF000000, 0xFF000000, 0.42f);
+        return (dark & 0x00FFFFFF) | (alpha << 24);
+    }
+
+    // ---- my own tick (shown only on my own messages) -------------------------------------
+
+    public static int getMyTick() {
+        ensureLoaded();
+        return myTick;
+    }
+
+    public static void setMyTick(int tick) {
+        ensureLoaded();
+        if (tick < 0 || tick >= ModTicks.COUNT) {
+            tick = 0;
+        }
+        myTick = tick;
+        prefs().edit().putInt("my_tick", tick).apply();
+    }
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/mod/ModShapeMath.java b/TMessagesProj/src/main/java/org/telegram/messenger/mod/ModShapeMath.java
new file mode 100644
index 000000000..ef878730e
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/mod/ModShapeMath.java
@@ -0,0 +1,325 @@
+package org.telegram.messenger.mod;
+
+/**
+ * Outlines of the video message shapes. Plain math without Android classes.
+ *
+ * Every outline is a closed line of POINTS points (x0, y0, x1, y1, ...) that fits into the square
+ * [-1, 1] x [-1, 1]. The y axis points down, the line starts at the top centre and goes clockwise,
+ * so the recording progress can be drawn along it from the top, like the usual circle.
+ */
+final class ModShapeMath {
+
+    static final int COUNT = 14;
+    static final int POINTS = 240;
+
+    private static final double TWO_PI = Math.PI * 2;
+
+    private ModShapeMath() {
+    }
+
+    static float[] outline(int id) {
+        final double[] x = new double[POINTS];
+        final double[] y = new double[POINTS];
+        if (id == 2) {
+            heart(x, y);
+        } else if (id == 11) {
+            cloud(x, y);
+        } else {
+            final double[] r = new double[POINTS];
+            for (int i = 0; i < POINTS; i++) {
+                r[i] = radius(id, TWO_PI * i / POINTS);
+            }
+            smooth(r, smoothing(id));
+            for (int i = 0; i < POINTS; i++) {
+                final double a = TWO_PI * i / POINTS;
+                x[i] = r[i] * Math.sin(a);
+                y[i] = -r[i] * Math.cos(a);
+            }
+        }
+        return fit(x, y);
+    }
+
+    /** How many neighbours on each side are averaged to round the corners of the shape. */
+    private static int smoothing(int id) {
+        switch (id) {
+            case 3:
+                return 4;   // star
+            case 4:
+                return 6;   // hexagon
+            case 5:
+                return 5;   // pentagon
+            case 6:
+                return 9;   // diamond
+            case 10:
+                return 2;   // sparkle
+            case 13:
+                return 2;   // cat
+            default:
+                return 0;
+        }
+    }
+
+    /** Distance from the centre to the outline in the direction a (0 = up, clockwise). */
+    private static double radius(int id, double a) {
+        switch (id) {
+            case 1:
+                return superellipse(a, 4.0);
+            case 3:
+                return star(a, 5, 0.5);
+            case 4:
+                return polygon(a, 6);
+            case 5:
+                return polygon(a, 5);
+            case 6:
+                return polygon(a, 4);
+            case 7:
+                return 0.58 + 0.42 * Math.pow(Math.abs(Math.cos(4 * a)), 0.8);
+            case 8:
+                return clover(a);
+            case 9:
+                return 0.88 + 0.12 * Math.cos(12 * a);
+            case 10:
+                return superellipse(a, 0.62);
+            case 12:
+                return blob(a);
+            case 13:
+                return cat(a);
+            default:
+                return 1.0;
+        }
+    }
+
+    private static double superellipse(double a, double p) {
+        final double s = Math.abs(Math.sin(a));
+        final double c = Math.abs(Math.cos(a));
+        return Math.pow(Math.pow(s, p) + Math.pow(c, p), -1.0 / p);
+    }
+
+    /** Regular polygon with a vertex at the top. */
+    private static double polygon(double a, int n) {
+        final double sector = TWO_PI / n;
+        double local = a % sector;
+        if (local < 0) {
+            local += sector;
+        }
+        return Math.cos(Math.PI / n) / Math.cos(local - Math.PI / n);
+    }
+
+    /** Star with a tip at the top: the line between the tip and the inner corner. */
+    private static double star(double a, int n, double inner) {
+        final double sector = TWO_PI / n;
+        double local = a % sector;
+        if (local < 0) {
+            local += sector;
+        }
+        // tip at local = 0 and local = sector (radius 1), inner corner in the middle (radius inner)
+        final double half = sector / 2;
+        final double t = local <= half ? local : sector - local;
+        // line from the tip (angle 0, radius 1) to the inner corner (angle half, radius inner)
+        final double tipX = 1.0;
+        final double tipY = 0.0;
+        final double inX = inner * Math.cos(half);
+        final double inY = inner * Math.sin(half);
+        final double dx = inX - tipX;
+        final double dy = inY - tipY;
+        // intersection of the ray (cos t, sin t) with that line
+        final double denom = Math.cos(t) * dy - Math.sin(t) * dx;
+        final double s = (tipX * dy - tipY * dx) / denom;
+        return s;
+    }
+
+    private static double clover(double a) {
+        final double d = 0.52;
+        final double rr = 0.56;
+        double best = 0;
+        for (int k = 0; k < 4; k++) {
+            final double ca = k * Math.PI / 2;
+            best = Math.max(best, rayExit(a, d * Math.sin(ca), -d * Math.cos(ca), rr));
+        }
+        return best;
+    }
+
+    /** Cloud: bumps (circles) on a flat bottom, built from the upper and the lower line of the bumps. */
+    private static void cloud(double[] outX, double[] outY) {
+        final double[][] circles = {
+                {-0.58, 0.18, 0.36},
+                {0.60, 0.20, 0.34},
+                {-0.36, -0.08, 0.42},
+                {0.34, -0.02, 0.40},
+                {-0.02, -0.26, 0.52},
+                {-0.20, 0.20, 0.40},
+                {0.22, 0.22, 0.40},
+        };
+        final double bottom = 0.50;
+        final int steps = 1600;
+        double minX = Double.MAX_VALUE, maxX = -Double.MAX_VALUE;
+        for (double[] c : circles) {
+            minX = Math.min(minX, c[0] - c[2]);
+            maxX = Math.max(maxX, c[0] + c[2]);
+        }
+        final double[] topY = new double[steps + 1];
+        final double[] botY = new double[steps + 1];
+        final double[] gx = new double[steps + 1];
+        for (int i = 0; i <= steps; i++) {
+            final double px = minX + (maxX - minX) * i / steps;
+            gx[i] = px;
+            double top = Double.MAX_VALUE;
+            double low = -Double.MAX_VALUE;
+            for (double[] c : circles) {
+                final double dx = px - c[0];
+                final double h = c[2] * c[2] - dx * dx;
+                if (h < 0) {
+                    continue;
+                }
+                final double sq = Math.sqrt(h);
+                top = Math.min(top, c[1] - sq);
+                low = Math.max(low, c[1] + sq);
+            }
+            if (top == Double.MAX_VALUE) {
+                top = low = 0;
+            }
+            topY[i] = top;
+            botY[i] = Math.min(bottom, low);
+        }
+        // dense closed line: top left -> right, bottom right -> left
+        final double[] dx = new double[(steps + 1) * 2];
+        final double[] dy = new double[(steps + 1) * 2];
+        int n = 0;
+        for (int i = 0; i <= steps; i++) {
+            dx[n] = gx[i];
+            dy[n++] = topY[i];
+        }
+        for (int i = steps; i >= 0; i--) {
+            dx[n] = gx[i];
+            dy[n++] = botY[i];
+        }
+        // start at the top centre (x = 0) and go clockwise
+        int start = 0;
+        double bestDist = Double.MAX_VALUE;
+        for (int i = 0; i <= steps; i++) {
+            final double d = Math.abs(gx[i]);
+            if (d < bestDist) {
+                bestDist = d;
+                start = i;
+            }
+        }
+        final double[] sx = new double[n];
+        final double[] sy = new double[n];
+        for (int i = 0; i < n; i++) {
+            sx[i] = dx[(start + i) % n];
+            sy[i] = dy[(start + i) % n];
+        }
+        resample(sx, sy, n, outX, outY);
+    }
+
+    /** Puts POINTS points with the same distance along the closed line. */
+    private static void resample(double[] sx, double[] sy, int n, double[] outX, double[] outY) {
+        final double[] len = new double[n + 1];
+        for (int i = 0; i < n; i++) {
+            final int j = (i + 1) % n;
+            len[i + 1] = len[i] + Math.hypot(sx[j] - sx[i], sy[j] - sy[i]);
+        }
+        final double total = len[n];
+        int seg = 0;
+        for (int k = 0; k < POINTS; k++) {
+            final double target = total * k / POINTS;
+            while (seg < n - 1 && len[seg + 1] < target) {
+                seg++;
+            }
+            final double span = len[seg + 1] - len[seg];
+            final double t = span > 0 ? (target - len[seg]) / span : 0;
+            final int j = (seg + 1) % n;
+            outX[k] = sx[seg] + (sx[j] - sx[seg]) * t;
+            outY[k] = sy[seg] + (sy[j] - sy[seg]) * t;
+        }
+    }
+
+    private static double blob(double a) {
+        return 0.80
+                + 0.09 * Math.sin(2 * a + 0.8)
+                + 0.07 * Math.sin(3 * a + 2.1)
+                + 0.05 * Math.sin(5 * a + 0.3);
+    }
+
+    private static double cat(double a) {
+        final double ear = 0.66;
+        final double width = 0.36;
+        double r = 0.76;
+        r += 0.44 * peak(a, -ear, width);
+        r += 0.44 * peak(a, ear, width);
+        return r;
+    }
+
+    private static double peak(double a, double centre, double width) {
+        double d = a - centre;
+        while (d > Math.PI) {
+            d -= TWO_PI;
+        }
+        while (d < -Math.PI) {
+            d += TWO_PI;
+        }
+        final double v = 1.0 - Math.abs(d) / width;
+        return v > 0 ? Math.pow(v, 1.15) : 0;
+    }
+
+    /**
+     * Where the ray from the origin in the direction a leaves the circle with the centre (cx, cy)
+     * and the radius r. The origin has to be inside of the circle.
+     */
+    private static double rayExit(double a, double cx, double cy, double r) {
+        final double dx = Math.sin(a);
+        final double dy = -Math.cos(a);
+        final double b = dx * cx + dy * cy;
+        final double c = cx * cx + cy * cy - r * r;
+        final double disc = b * b - c;
+        if (disc < 0) {
+            return 0;
+        }
+        return b + Math.sqrt(disc);
+    }
+
+    private static void heart(double[] x, double[] y) {
+        for (int i = 0; i < POINTS; i++) {
+            final double t = TWO_PI * i / POINTS;
+            final double s = Math.sin(t);
+            x[i] = 16 * s * s * s;
+            y[i] = -(13 * Math.cos(t) - 5 * Math.cos(2 * t) - 2 * Math.cos(3 * t) - Math.cos(4 * t));
+        }
+    }
+
+    /** Averages the radius with its neighbours (round corners), the line is closed. */
+    private static void smooth(double[] r, int k) {
+        if (k <= 0) {
+            return;
+        }
+        final double[] copy = r.clone();
+        for (int i = 0; i < POINTS; i++) {
+            double sum = 0;
+            for (int j = -k; j <= k; j++) {
+                sum += copy[(i + j + POINTS) % POINTS];
+            }
+            r[i] = sum / (2 * k + 1);
+        }
+    }
+
+    /** Moves the outline to the middle and scales it so that it fills the square [-1, 1]. */
+    private static float[] fit(double[] x, double[] y) {
+        double minX = Double.MAX_VALUE, maxX = -Double.MAX_VALUE;
+        double minY = Double.MAX_VALUE, maxY = -Double.MAX_VALUE;
+        for (int i = 0; i < POINTS; i++) {
+            minX = Math.min(minX, x[i]);
+            maxX = Math.max(maxX, x[i]);
+            minY = Math.min(minY, y[i]);
+            maxY = Math.max(maxY, y[i]);
+        }
+        final double cx = (minX + maxX) / 2;
+        final double cy = (minY + maxY) / 2;
+        final double half = Math.max(maxX - minX, maxY - minY) / 2;
+        final float[] out = new float[POINTS * 2];
+        for (int i = 0; i < POINTS; i++) {
+            out[i * 2] = (float) ((x[i] - cx) / half);
+            out[i * 2 + 1] = (float) ((y[i] - cy) / half);
+        }
+        return out;
+    }
+}
