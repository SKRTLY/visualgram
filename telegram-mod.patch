@@ -0,0 +1,40 @@
+package org.telegram.messenger.mod;
+
+import org.telegram.messenger.LocaleController;
+
+import java.util.Locale;
+
+/**
+ * Texts of the mod in the language that is chosen in the Telegram settings: Ukrainian, Russian or
+ * English (every other language gets English). Usage: ModStrings.t("українською", "по-русски", "in English").
+ */
+public class ModStrings {
+
+    public static final int UK = 0;
+    public static final int RU = 1;
+    public static final int EN = 2;
+
+    private static Locale cachedLocale;
+    private static int cachedLang = EN;
+
+    public static int lang() {
+        final Locale locale = LocaleController.getInstance().getCurrentLocale();
+        if (locale != cachedLocale) {
+            cachedLocale = locale;
+            final String code = locale == null ? "" : locale.getLanguage();
+            if ("uk".equals(code)) {
+                cachedLang = UK;
+            } else if ("ru".equals(code)) {
+                cachedLang = RU;
+            } else {
+                cachedLang = EN;
+            }
+        }
+        return cachedLang;
+    }
+
+    public static String t(String uk, String ru, String en) {
+        final int lang = lang();
+        return lang == UK ? uk : lang == RU ? ru : en;
+    }
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/mod/ModTicks.java b/TMessagesProj/src/main/java/org/telegram/messenger/mod/ModTicks.java
