+
+            canvas.drawText("Привіт! Так виглядатиме", bubble.left + dp(14), bubble.top + dp(38), textPaint);
+            canvas.drawText("моє повідомлення", bubble.left + dp(14), bubble.top + dp(60), textPaint);
+
+            // time and my tick, like in a real bubble
+            Paint timePaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+            timePaint.setTextSize(dp(12));
+            timePaint.setColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText));
+            timePaint.setTextAlign(Paint.Align.RIGHT);
+            canvas.drawText("12:30", bubble.right - dp(34), bubble.bottom - dp(10), timePaint);
+            int tick = ModSettings.getMyTick();
+            if (tick > 0) {
+                ModTicks.drawIncoming(canvas, tick, bubble.right - dp(20), bubble.bottom - dp(14), dp(13), 255);
+                ModTicks.drawIncoming(canvas, tick, bubble.right - dp(15), bubble.bottom - dp(14), dp(13), 255);
+            } else {
+                timePaint.setTextAlign(Paint.Align.CENTER);
+                canvas.drawText("✓✓", bubble.right - dp(18), bubble.bottom - dp(10), timePaint);
+            }
+
+            int gift = ModSettings.getMyGift();
+            int rawRes = ModGifts.rawFor(gift);
+            if (rawRes == 0) {
+                return;
+            }
+            int size = dp(56 * ModSettings.getGiftScale() / 100f);
+            if (receiver == null) {
+                receiver = new ImageReceiver(this);
+                receiver.setAllowStartLottieAnimation(true);
+                if (isAttachedToWindow()) {
+                    receiver.onAttachedToWindow();
+                }
+            }
+            if (shownGift != gift || shownSize != size) {
+                shownGift = gift;
+                shownSize = size;
+                RLottieDrawable drawable = new RLottieDrawable(rawRes, size, size);
+                drawable.setAutoRepeat(1);
+                receiver.setImageBitmap(drawable);
+            }
+            float cx = bubble.left + bubble.width() * ModSettings.getGiftX() / 100f;
+            float cy = bubble.top + bubble.height() * ModSettings.getGiftY() / 100f;
+            receiver.setImageCoords(cx - size / 2f, cy - size / 2f, size, size);
+            receiver.draw(canvas);
+        }
+
+        @Override
+        public boolean onTouchEvent(MotionEvent event) {
+            int action = event.getActionMasked();
+            if (action == MotionEvent.ACTION_DOWN || action == MotionEvent.ACTION_MOVE) {
+                if (getParent() != null) {
+                    getParent().requestDisallowInterceptTouchEvent(true);
+                }
+                if (bubble.width() > 0 && bubble.height() > 0) {
+                    int x = Math.round((event.getX() - bubble.left) / bubble.width() * 100f);
+                    int y = Math.round((event.getY() - bubble.top) / bubble.height() * 100f);
+                    ModSettings.setGiftPositionTemp(x, y);
+                    invalidate();
+                }
+                return true;
+            }
+            if (action == MotionEvent.ACTION_UP || action == MotionEvent.ACTION_CANCEL) {
+                ModSettings.saveGiftPosition();
+                return true;
+            }
+            return super.onTouchEvent(event);
+        }
+    }
+}
