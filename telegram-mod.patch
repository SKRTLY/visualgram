+/** Settings screen of the visual mod: bubbles, live wallpaper and my ticks. */
+public class ModSettingsActivity extends BaseFragment {
+
+    private static final int REQUEST_PICK_WALLPAPER = 9137;
+
+    private interface IntCallback {
+        void run(int value);
+    }
+
+    private Context context;
+    private LinearLayout root;
+
+    @Override
+    public View createView(Context context) {
+        this.context = context;
+
+        actionBar.setBackButtonImage(R.drawable.ic_ab_back);
+        actionBar.setAllowOverlayTitle(true);
+        actionBar.setTitle(ModStrings.t("Мод: вигляд чату", "Мод: вид чата", "Mod: chat look"));
+        actionBar.setActionBarMenuOnItemClick(new ActionBar.ActionBarMenuOnItemClick() {
+            @Override
+            public void onItemClick(int id) {
+                if (id == -1) {
+                    finishFragment();
+                }
+            }
+        });
+
+        ScrollView scrollView = new ScrollView(context);
+        scrollView.setBackgroundColor(Theme.getColor(Theme.key_windowBackgroundGray));
+        root = new LinearLayout(context);
+        root.setOrientation(LinearLayout.VERTICAL);
+        scrollView.addView(root, new ScrollView.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
+        fragmentView = scrollView;
+
+        rebuild();
+        return fragmentView;
+    }
+
+    // ---- screen content -----------------------------------------------------------------
+
+    private void rebuild() {
+        root.removeAllViews();
+
+        // bubbles
+        addHeader(ModStrings.t("Повідомлення", "Сообщения", "Messages"));
+        addRow(ModStrings.t("Прозорість повідомлення", "Прозрачность сообщения", "Message transparency"), ModSettings.getBubbleAlphaPercent() + "%", v ->
+                showSeekDialog(ModStrings.t("Прозорість повідомлення", "Прозрачность сообщения", "Message transparency"), 20, 100, ModSettings.getBubbleAlphaPercent(), "%", value -> {
+                    ModSettings.setBubbleAlphaPercent(value);
+                    rebuild();
+                }));
+        addInfo(ModStrings.t("100% означає непрозорі повідомлення, менше значення: крізь них видно шпалери. Працює в усіх, хто встановив цей застосунок.", "100% означает непрозрачные сообщения, меньшее значение: сквозь них видны обои. Работает у всех, кто установил это приложение.", "100% means opaque messages, a lower value lets the wallpaper show through. Works for everyone who installed this app."));
+
+        // live wallpaper
+        addHeader(ModStrings.t("Живі шпалери чату", "Живые обои чата", "Live chat wallpaper"));
+        String wallpaperState;
+        if (!ModSettings.hasWallpaperFile()) {
+            wallpaperState = ModStrings.t("Відео не вибрано", "Видео не выбрано", "No video chosen");
