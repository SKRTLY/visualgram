+package org.telegram.messenger.mod;
+
+import android.text.TextUtils;
+
+import androidx.collection.LongSparseArray;
+
+import org.telegram.SQLite.SQLiteCursor;
+import org.telegram.SQLite.SQLiteDatabase;
+import org.telegram.SQLite.SQLitePreparedStatement;
+import org.telegram.messenger.AndroidUtilities;
+import org.telegram.messenger.FileLog;
+import org.telegram.messenger.MessageObject;
+import org.telegram.messenger.MessagesStorage;
+import org.telegram.messenger.NotificationCenter;
+import org.telegram.messenger.UserConfig;
+import org.telegram.tgnet.TLRPC;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.Set;
+import java.util.concurrent.ConcurrentHashMap;
+
+/**
+ * Messages that the other side deleted. When the server says that a message is deleted, the usual
+ * Telegram removes it from the chat. With the option "keep deleted messages" the message stays in the
+ * local database and in the chat, and gets the mark "deleted" next to the time.
+ *
+ * Which messages are marked is kept in the table mod_deleted of the same database (it is created by
+ * this class when it is needed), and in memory, because the chat asks about every message it draws.
+ * Messages of private chats and small groups share one numbering, so they are stored with the number
+ * 0; messages of channels and supergroups are stored with the id of the channel.
+ *
+ * Only messages that the phone really has are marked, so deletions in the chats that were never
+ * opened do not fill the table. Secret chats and Saved Messages are not touched.
+ */
+public final class ModDeleted {
+
+    private static final ModDeleted[] INSTANCES = new ModDeleted[UserConfig.MAX_ACCOUNT_COUNT];
+
+    public static ModDeleted getInstance(int account) {
+        ModDeleted instance = INSTANCES[account];
+        if (instance == null) {
+            synchronized (ModDeleted.class) {
+                instance = INSTANCES[account];
+                if (instance == null) {
+                    instance = new ModDeleted(account);
+                    INSTANCES[account] = instance;
+                }
+            }
+        }
+        return instance;
+    }
+
+    /** The mark that is shown next to the time of a message that was deleted. */
+    public static String label() {
+        return ModStrings.t("видалено", "удалено", "deleted");
+    }
+
+    private final int account;
+    private final Set<Integer> legacyIds = Collections.newSetFromMap(new ConcurrentHashMap<Integer, Boolean>());
+    private final ConcurrentHashMap<Long, Set<Integer>> channelIds = new ConcurrentHashMap<>();
+    private volatile long owner = -1;
+
+    private ModDeleted(int account) {
+        this.account = account;
+    }
+
+    // ---- asking ----------------------------------------------------------------------------
+
+    /** True if this message was deleted by the other side and is only kept here. */
+    public boolean isDeleted(MessageObject message) {
+        if (message == null || message.messageOwner == null || message.messageOwner.id <= 0) {
+            return false;
+        }
+        checkOwner();
+        if (legacyIds.isEmpty() && channelIds.isEmpty()) {
+            return false;
+        }
+        final int id = message.messageOwner.id;
+        final TLRPC.Peer peer = message.messageOwner.peer_id;
+        if (peer != null && peer.channel_id != 0) {
+            final Set<Integer> ids = channelIds.get(peer.channel_id);
+            return ids != null && ids.contains(id);
+        }
+        return legacyIds.contains(id);
+    }
+
+    /** The phone can be logged in to another person after the exit: then the list starts from scratch. */
+    private void checkOwner() {
+        final long me = UserConfig.getInstance(account).getClientUserId();
+        if (me == 0 || me == owner) {
+            return;
+        }
+        synchronized (this) {
+            if (me == owner) {
+                return;
+            }
+            owner = me;
+            legacyIds.clear();
+            channelIds.clear();
+        }
+        load();
+    }
+
+    // ---- storing ---------------------------------------------------------------------------
+
+    private void add(long channelId, int id) {
+        if (channelId == 0) {
+            legacyIds.add(id);
+            return;
+        }
+        Set<Integer> ids = channelIds.get(channelId);
+        if (ids == null) {
+            ids = Collections.newSetFromMap(new ConcurrentHashMap<Integer, Boolean>());
+            final Set<Integer> old = channelIds.putIfAbsent(channelId, ids);
+            if (old != null) {
+                ids = old;
+            }
+        }
+        ids.add(id);
+    }
+
+    private static void ensureTable(SQLiteDatabase database) throws Exception {
+        database.executeFast("CREATE TABLE IF NOT EXISTS mod_deleted(did INTEGER, mid INTEGER, PRIMARY KEY(did, mid))").stepThis().dispose();
+    }
+
+    /** Reads the marks from the database (on the thread of the database). */
+    private void load() {
+        final MessagesStorage storage = MessagesStorage.getInstance(account);
+        storage.getStorageQueue().postRunnable(() -> {
+            try {
+                final SQLiteDatabase database = storage.getDatabase();
+                if (database == null) {
+                    return;
+                }
+                ensureTable(database);
+                final SQLiteCursor cursor = database.queryFinalized("SELECT did, mid FROM mod_deleted");
+                while (cursor.next()) {
+                    add(cursor.longValue(0), cursor.intValue(1));
+                }
+                cursor.dispose();
+            } catch (Throwable e) {
+                FileLog.e(e);
+            }
+            notifyChats(0);
+        });
+    }
+
+    private void notifyChats(long dialogId) {
+        AndroidUtilities.runOnUIThread(() -> NotificationCenter.getInstance(account).postNotificationName(NotificationCenter.modMessagesDeleted, dialogId));
+    }
+
+    /**
+     * The server deleted these messages. Key 0 of the list: messages of private chats and small groups
+     * (their ids are shared), another key: minus the id of the channel. The messages that the phone has
+     * stay and get the mark, the rest are ignored.
+     */
+    public void keep(LongSparseArray<ArrayList<Integer>> deleted) {
+        if (deleted == null || deleted.size() == 0) {
+            return;
+        }
+        checkOwner();
+        final ArrayList<Long> keys = new ArrayList<>();
+        final ArrayList<ArrayList<Integer>> lists = new ArrayList<>();
+        for (int a = 0, size = deleted.size(); a < size; a++) {
+            final ArrayList<Integer> ids = deleted.valueAt(a);
+            if (ids != null && !ids.isEmpty()) {
+                keys.add(deleted.keyAt(a));
+                lists.add(new ArrayList<>(ids));
+            }
+        }
+        if (keys.isEmpty()) {
+            return;
+        }
+        final long me = UserConfig.getInstance(account).getClientUserId();
+        final MessagesStorage storage = MessagesStorage.getInstance(account);
+        storage.getStorageQueue().postRunnable(() -> {
+            try {
+                final SQLiteDatabase database = storage.getDatabase();
+                if (database == null) {
+                    return;
+                }
+                ensureTable(database);
+                final ArrayList<long[]> found = new ArrayList<>(); // {channel id or 0, message id}
+                for (int a = 0; a < keys.size(); a++) {
+                    final long key = keys.get(a);
+                    final String ids = TextUtils.join(",", lists.get(a));
+                    final String sql;
+                    if (key == 0) {
+                        // not in Saved Messages: a message deleted there on another phone of the same person must go
+                        sql = "SELECT mid FROM messages_v2 WHERE mid IN(" + ids + ") AND is_channel = 0 AND uid != " + me;
+                    } else {
+                        sql = "SELECT mid FROM messages_v2 WHERE mid IN(" + ids + ") AND uid = " + key;
+                    }
+                    final SQLiteCursor cursor = database.queryFinalized(sql);
+                    while (cursor.next()) {
+                        found.add(new long[]{key == 0 ? 0 : -key, cursor.intValue(0)});
+                    }
+                    cursor.dispose();
+                }
+                if (found.isEmpty()) {
+                    return;
+                }
+                final SQLitePreparedStatement state = database.executeFast("REPLACE INTO mod_deleted VALUES(?, ?)");
+                for (int a = 0; a < found.size(); a++) {
+                    final long[] item = found.get(a);
+                    state.requery();
+                    state.bindLong(1, item[0]);
+                    state.bindInteger(2, (int) item[1]);
+                    state.step();
+                    add(item[0], (int) item[1]);
+                }
+                state.dispose();
+                for (int a = 0; a < keys.size(); a++) {
+                    notifyChats(keys.get(a));
+                }
+            } catch (Throwable e) {
+                FileLog.e(e);
+            }
+        });
+    }
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/mod/ModKeys.java b/TMessagesProj/src/main/java/org/telegram/messenger/mod/ModKeys.java
new file mode 100644
index 000000000..7adee222c
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/mod/ModKeys.java
@@ -0,0 +1,161 @@
+package org.telegram.messenger.mod;
+
+import android.content.Context;
+import android.content.pm.PackageInfo;
+import android.content.pm.PackageManager;
+import android.content.pm.Signature;
+import android.content.pm.SigningInfo;
+import android.os.Build;
+
+import org.telegram.messenger.ApplicationLoader;
+import org.telegram.messenger.BuildVars;
+import org.telegram.messenger.FileLog;
+
+import java.security.MessageDigest;
+
+/**
+ * Keeps the Telegram API id and API hash of the owner out of sight.
+ *
+ * The build (see .github/workflows/build.yml) does not write the keys into the code as plain text.
+ * It encrypts them with a key that is made from the certificate that signs this APK, and puts only
+ * the encrypted bytes (PAYLOAD) and a random salt (SALT) here. At run time the key is made again from
+ * the certificate of the installed app and the keys are decrypted into memory.
+ *
+ * What this gives:
+ *  - the keys are not in the APK as readable text, so searching the unpacked APK or opening it in a
+ *    decompiler shows nothing useful;
+ *  - a copy of the APK that was changed and signed with another certificate cannot decrypt them.
+ *
+ * What this cannot give: the app has to send the keys to Telegram, so a person with a rooted phone
+ * and a debugging tool can still read them from the memory of the running app. No Android app can
+ * prevent that. The keys are not a password for the account, they only name the application.
+ *
+ * While the markers below are not replaced (an old build.yml, or a local build), the plain values
+ * from BuildVars are used.
+ */
+public class ModKeys {
+
+    private static final String PAYLOAD = "@@SK_PAYLOAD@@";
+    private static final String SALT = "@@SK_SALT@@";
+
+    private static boolean resolved;
+    private static boolean failed;
+    private static int resolvedId;
+    private static String resolvedHash;
+
+    public static int appId() {
+        resolve();
+        return resolved ? resolvedId : BuildVars.APP_ID;
+    }
+
+    public static String appHash() {
+        resolve();
+        return resolved ? resolvedHash : BuildVars.APP_HASH;
+    }
+
+    private static synchronized void resolve() {
+        if (resolved || failed) {
+            return;
+        }
+        if (PAYLOAD.startsWith("@@")) {
+            // the build did not put encrypted keys here: plain values from BuildVars are used
+            return;
+        }
+        final byte[] cert = certificateDigest();
+        if (cert == null) {
+            // the app is not fully started yet: try again at the next call
+            return;
+        }
+        try {
+            final String plain = decrypt(hexToBytes(PAYLOAD), hexToBytes(SALT), cert);
+            final int colon = plain.indexOf(':');
+            if (colon > 0 && colon <= 10 && plain.length() == colon + 33 && isDigits(plain, 0, colon) && isHex(plain, colon + 1, plain.length())) {
+                resolvedId = Integer.parseInt(plain.substring(0, colon));
+                resolvedHash = plain.substring(colon + 1);
+                resolved = true;
+            } else {
+                // decrypted into garbage: the APK was signed with another certificate
+                failed = true;
+            }
+        } catch (Throwable e) {
+            FileLog.e(e);
+            failed = true;
+        }
+    }
+
+    private static boolean isDigits(String s, int from, int to) {
+        for (int i = from; i < to; i++) {
+            char c = s.charAt(i);
+            if (c < '0' || c > '9') {
+                return false;
+            }
+        }
+        return to > from;
+    }
+
+    private static boolean isHex(String s, int from, int to) {
+        for (int i = from; i < to; i++) {
+            char c = s.charAt(i);
+            if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F'))) {
+                return false;
+            }
+        }
+        return to > from;
+    }
+
+    /** SHA-256 of the certificate that signed the installed app (the same value that apksigner prints). */
+    @SuppressWarnings("deprecation")
+    private static byte[] certificateDigest() {
+        try {
+            final Context context = ApplicationLoader.applicationContext;
+            if (context == null) {
+                return null;
+            }
+            final PackageManager pm = context.getPackageManager();
+            Signature[] signatures = null;
+            if (Build.VERSION.SDK_INT >= 28) {
+                final PackageInfo info = pm.getPackageInfo(context.getPackageName(), PackageManager.GET_SIGNING_CERTIFICATES);
+                final SigningInfo signingInfo = info.signingInfo;
+                if (signingInfo != null) {
+                    signatures = signingInfo.getApkContentsSigners();
+                }
+            } else {
+                final PackageInfo info = pm.getPackageInfo(context.getPackageName(), PackageManager.GET_SIGNATURES);
+                signatures = info.signatures;
+            }
+            if (signatures == null || signatures.length == 0) {
+                return null;
+            }
+            return MessageDigest.getInstance("SHA-256").digest(signatures[0].toByteArray());
+        } catch (Throwable e) {
+            FileLog.e(e);
+            return null;
+        }
+    }
+
+    /** Stream cipher: block i of the key stream is SHA-256(certificate digest, salt, i). */
+    static String decrypt(byte[] data, byte[] salt, byte[] cert) throws Exception {
+        final MessageDigest digest = MessageDigest.getInstance("SHA-256");
+        final byte[] out = new byte[data.length];
+        for (int block = 0; block * 32 < data.length; block++) {
+            digest.reset();
+            digest.update(cert);
+            digest.update(salt);
+            digest.update(new byte[]{(byte) (block >> 8), (byte) block});
+            final byte[] stream = digest.digest();
+            for (int i = 0; i < 32 && block * 32 + i < data.length; i++) {
+                out[block * 32 + i] = (byte) (data[block * 32 + i] ^ stream[i]);
+            }
+        }
+        return new String(out, "UTF-8");
+    }
+
+    static byte[] hexToBytes(String hex) {
+        final int length = hex.length() / 2;
+        final byte[] result = new byte[length];
+        for (int i = 0; i < length; i++) {
+            result[i] = (byte) ((Character.digit(hex.charAt(i * 2), 16) << 4) | Character.digit(hex.charAt(i * 2 + 1), 16));
+        }
+        return result;
+    }
+}
