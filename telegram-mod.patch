+package org.telegram.messenger.mod;
+
+import org.telegram.messenger.R;
+
+/** Animated decorations that can be pinned to a message bubble. Ids are sent to friends, never reorder them. */
+public class ModGifts {
+
+    public static final String[] NAMES = {
+            "Без подарунка",
+            "Подарунок",
+            "Золотий подарунок",
+            "Торт",
+            "Вогонь",
+            "Іскри",
+            "Зірка",
+            "Серце"
+    };
+
+    /** Returns the raw Lottie resource for the gift id, or 0 if the id is unknown. */
+    public static int rawFor(int id) {
+        switch (id) {
+            case 1:
+                return R.raw.gift;
+            case 2:
+                return R.raw.premium_gift;
+            case 3:
+                return R.raw.cake;
+            case 4:
+                return R.raw.fire_on;
+            case 5:
+                return R.raw.emoji_stars;
+            case 6:
+                return R.raw.star_reaction;
+            case 7:
+                return R.raw.email_setup_heart;
+            default:
+                return 0;
+        }
+    }
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/mod/ModMarker.java b/TMessagesProj/src/main/java/org/telegram/messenger/mod/ModMarker.java
new file mode 100644
index 0000000..3d364bc
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/mod/ModMarker.java
@@ -0,0 +1,151 @@
+package org.telegram.messenger.mod;
+
+import org.telegram.messenger.DialogObject;
+
+/**
+ * Invisible marker appended to the end of outgoing text messages. Friends who run this app read it
+ * and show the sender's tick and gift; everybody else just sees an empty trailing character.
+ *
+ * Layout of the tail of the text:
+ *   SEP + 56 bits (ZERO / ONE characters) + SEP + TERM
+ * The bits are 7 bytes: magic, tick, gift, giftX, giftY, giftScale, checksum.
+ * TERM (braille blank) is a real, non-whitespace character, so the server and clients do not trim
+ * the zero-width characters in front of it.
+ */
+public class ModMarker {
+
+    private static final char SEP = '\u2060';    // word joiner
+    private static final char ZERO = '\u200B';   // zero width space
+    private static final char ONE = '\u200D';    // zero width joiner
+    private static final char TERM = '\u2800';   // braille pattern blank
+
+    private static final int PAYLOAD_BYTES = 7;
+    private static final int MAGIC = 0xA7;
+    public static final int MARKER_LENGTH = 1 + PAYLOAD_BYTES * 8 + 1 + 1;
+
+    public static class Data {
+        public int tick;
+        public int gift;
+        public int giftX;
+        public int giftY;
+        public int giftScale;
+    }
+
+    /** Returns the text with the marker added, or the same text if nothing has to be added. */
+    public static String decorate(String text, long dialogId, boolean plainText) {
+        if (text == null || text.length() == 0 || !plainText) {
+            return text;
+        }
+        if (!ModSettings.isShareWithFriends()) {
+            return text;
+        }
+        int tick = ModSettings.getMyTick();
+        int gift = ModSettings.getMyGift();
+        if (tick <= 0 && gift <= 0) {
+            return text;
+        }
+        if (DialogObject.isEncryptedDialog(dialogId)) {
+            return text;
+        }
+        // bot commands must stay untouched, very long messages must not exceed the limit
+        if (text.charAt(0) == '/' || text.length() > 3900) {
+            return text;
+        }
+        if (parse(text) != null) {
+            return text;
+        }
+        int[] bytes = new int[PAYLOAD_BYTES];
+        bytes[0] = MAGIC;
+        bytes[1] = tick & 0xFF;
+        bytes[2] = gift & 0xFF;
+        bytes[3] = ModSettings.getGiftX() & 0xFF;
+        bytes[4] = ModSettings.getGiftY() & 0xFF;
+        bytes[5] = ModSettings.getGiftScale() & 0xFF;
+        int check = 0;
+        for (int i = 0; i < PAYLOAD_BYTES - 1; i++) {
+            check ^= bytes[i];
+        }
+        bytes[6] = check & 0xFF;
+
+        StringBuilder sb = new StringBuilder(text.length() + MARKER_LENGTH);
+        sb.append(text);
+        sb.append(SEP);
+        for (int i = 0; i < PAYLOAD_BYTES; i++) {
+            for (int bit = 7; bit >= 0; bit--) {
+                sb.append(((bytes[i] >> bit) & 1) == 1 ? ONE : ZERO);
+            }
+        }
+        sb.append(SEP);
+        sb.append(TERM);
+        return sb.toString();
+    }
+
+    /** Reads the marker from the end of the text, returns null if there is none. */
+    public static Data parse(CharSequence text) {
+        if (text == null) {
+            return null;
+        }
+        int len = text.length();
+        if (len < MARKER_LENGTH) {
+            return null;
+        }
+        if (text.charAt(len - 1) != TERM || text.charAt(len - 2) != SEP) {
+            return null;
+        }
+        int start = len - MARKER_LENGTH;
+        if (text.charAt(start) != SEP) {
+            return null;
+        }
+        int[] bytes = new int[PAYLOAD_BYTES];
+        int pos = start + 1;
+        for (int i = 0; i < PAYLOAD_BYTES; i++) {
+            int value = 0;
+            for (int bit = 0; bit < 8; bit++) {
+                char c = text.charAt(pos++);
+                if (c == ONE) {
+                    value = (value << 1) | 1;
+                } else if (c == ZERO) {
+                    value = value << 1;
+                } else {
+                    return null;
+                }
+            }
+            bytes[i] = value;
+        }
+        if (bytes[0] != MAGIC) {
+            return null;
+        }
+        int check = 0;
+        for (int i = 0; i < PAYLOAD_BYTES - 1; i++) {
+            check ^= bytes[i];
+        }
+        if ((check & 0xFF) != bytes[PAYLOAD_BYTES - 1]) {
+            return null;
+        }
+        Data data = new Data();
+        data.tick = bytes[1];
+        data.gift = bytes[2];
+        data.giftX = Math.min(100, bytes[3]);
+        data.giftY = Math.min(100, bytes[4]);
+        data.giftScale = Math.max(25, Math.min(200, bytes[5]));
+        if (data.tick >= ModTicks.EMOJI.length) {
+            data.tick = 0;
+        }
+        if (ModGifts.rawFor(data.gift) == 0) {
+            data.gift = 0;
+        }
+        if (data.tick == 0 && data.gift == 0) {
+            return null;
+        }
+        return data;
+    }
+
+    /** Removes the marker from the end of the text (the text must have it, see parse). */
+    public static CharSequence strip(CharSequence text) {
+        int len = text.length();
+        if (len < MARKER_LENGTH) {
+            return text;
+        }
+        return text.subSequence(0, len - MARKER_LENGTH);
+    }
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/mod/ModSettings.java b/TMessagesProj/src/main/java/org/telegram/messenger/mod/ModSettings.java
new file mode 100644
index 0000000..d4345fd
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/mod/ModSettings.java
@@ -0,0 +1,169 @@
+package org.telegram.messenger.mod;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+
+import org.telegram.messenger.ApplicationLoader;
+
+import java.io.File;
+
+/**
+ * Local settings of the visual mod. Everything is stored in one SharedPreferences file
+ * and cached in static fields, because some getters are called on every frame.
+ */
+public class ModSettings {
+
+    private static final String PREFS = "mod_settings";
+    private static final String WALLPAPER_FILE = "live_wallpaper.mp4";
+
+    private static boolean loaded;
+    private static int bubbleAlphaPercent = 70;   // 20..100
+    private static boolean wallpaperEnabled = true;
+    private static int myTick = 0;                // index in ModTicks.EMOJI, 0 = default Telegram ticks
+    private static int myGift = 0;                // id in ModGifts, 0 = none
+    private static int giftX = 85;                // 0..100 % of bubble width
+    private static int giftY = 20;                // 0..100 % of bubble height
+    private static int giftScale = 100;           // 25..200 %
+    private static boolean shareWithFriends = true;
+
+    private static SharedPreferences prefs() {
+        return ApplicationLoader.applicationContext.getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+    }
+
+    private static void ensureLoaded() {
+        if (loaded) {
+            return;
+        }
+        synchronized (ModSettings.class) {
+            if (loaded) {
+                return;
+            }
+            SharedPreferences p = prefs();
+            bubbleAlphaPercent = p.getInt("bubble_alpha", 70);
+            wallpaperEnabled = p.getBoolean("wallpaper_enabled", true);
+            myTick = p.getInt("my_tick", 0);
+            myGift = p.getInt("my_gift", 0);
+            giftX = p.getInt("gift_x", 85);
+            giftY = p.getInt("gift_y", 20);
+            giftScale = p.getInt("gift_scale", 100);
+            shareWithFriends = p.getBoolean("share_with_friends", true);
+            loaded = true;
+        }
+    }
+
+    // ---- bubbles -------------------------------------------------------------------------
+
+    public static int getBubbleAlphaPercent() {
+        ensureLoaded();
+        return bubbleAlphaPercent;
+    }
+
+    public static void setBubbleAlphaPercent(int percent) {
+        ensureLoaded();
+        bubbleAlphaPercent = Math.max(20, Math.min(100, percent));
+        prefs().edit().putInt("bubble_alpha", bubbleAlphaPercent).apply();
+    }
+
+    /** Called from MessageDrawable.setAlpha: scales the alpha of every message bubble. */
+    public static int applyBubbleAlpha(int alpha) {
+        ensureLoaded();
+        if (bubbleAlphaPercent >= 100) {
+            return alpha;
+        }
+        return (int) (alpha * (bubbleAlphaPercent / 100f));
+    }
+
+    // ---- live wallpaper -----------------------------------------------------------------
+
+    public static File getWallpaperFile() {
+        return new File(ApplicationLoader.applicationContext.getFilesDir(), WALLPAPER_FILE);
+    }
+
+    public static boolean hasWallpaperFile() {
+        File f = getWallpaperFile();
+        return f.exists() && f.length() > 0;
+    }
+
+    public static boolean isWallpaperEnabled() {
+        ensureLoaded();
+        return wallpaperEnabled;
+    }
+
+    public static void setWallpaperEnabled(boolean enabled) {
+        ensureLoaded();
+        wallpaperEnabled = enabled;
+        prefs().edit().putBoolean("wallpaper_enabled", enabled).apply();
+    }
+
+    public static boolean isWallpaperActive() {
+        return isWallpaperEnabled() && hasWallpaperFile();
+    }
+
+    // ---- my own tick and gift (what friends with the mod will see) -----------------------
+
+    public static int getMyTick() {
+        ensureLoaded();
+        return myTick;
+    }
+
+    public static void setMyTick(int tick) {
+        ensureLoaded();
+        myTick = tick;
+        prefs().edit().putInt("my_tick", tick).apply();
+    }
+
+    public static int getMyGift() {
+        ensureLoaded();
+        return myGift;
+    }
+
+    public static void setMyGift(int gift) {
+        ensureLoaded();
+        myGift = gift;
+        prefs().edit().putInt("my_gift", gift).apply();
+    }
+
+    public static int getGiftX() {
+        ensureLoaded();
+        return giftX;
+    }
+
+    public static int getGiftY() {
+        ensureLoaded();
+        return giftY;
+    }
+
+    /** Updates the position in memory only; call saveGiftPosition() when the finger is lifted. */
+    public static void setGiftPositionTemp(int x, int y) {
+        ensureLoaded();
+        giftX = Math.max(0, Math.min(100, x));
+        giftY = Math.max(0, Math.min(100, y));
+    }
+
+    public static void saveGiftPosition() {
+        ensureLoaded();
+        prefs().edit().putInt("gift_x", giftX).putInt("gift_y", giftY).apply();
+    }
+
+    public static int getGiftScale() {
+        ensureLoaded();
+        return giftScale;
+    }
+
+    public static void setGiftScale(int scale) {
+        ensureLoaded();
+        giftScale = Math.max(25, Math.min(200, scale));
+        prefs().edit().putInt("gift_scale", giftScale).apply();
+    }
+
+    public static boolean isShareWithFriends() {
+        ensureLoaded();
+        return shareWithFriends;
+    }
+
+    public static void setShareWithFriends(boolean share) {
+        ensureLoaded();
+        shareWithFriends = share;
+        prefs().edit().putBoolean("share_with_friends", share).apply();
+    }
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/mod/ModTicks.java b/TMessagesProj/src/main/java/org/telegram/messenger/mod/ModTicks.java
new file mode 100644
index 0000000..05e1650
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/mod/ModTicks.java
@@ -0,0 +1,98 @@
+package org.telegram.messenger.mod;
+
+import static org.telegram.messenger.AndroidUtilities.dp;
+
+import android.graphics.Canvas;
+import android.graphics.Paint;
+
+import org.telegram.messenger.MessageObject;
+
+/** Custom "ticks" drawn as emoji instead of the standard Telegram check marks. */
+public class ModTicks {
+
+    /** Index 0 means the standard Telegram ticks. Ids are sent to friends, never reorder them. */
+    public static final String[] EMOJI = {
+            "",
+            "❤️",
+            "⭐",
+            "🔥",
+            "✨",
+            "💎",
+            "🌸",
+            "🍀",
+            "🦋",
+            "👑",
+            "🐾",
+            "⚡"
+    };
+
+    public static final String[] NAMES = {
+            "Стандартні",
+            "Серце",
+            "Зірка",
+            "Вогник",
+            "Іскри",
+            "Діамант",
+            "Квітка",
+            "Конюшина",
+            "Метелик",
+            "Корона",
+            "Лапка",
+            "Блискавка"
+    };
+
+    private static final Paint paint = new Paint(Paint.ANTI_ALIAS_FLAG);
+
+    static {
+        paint.setTextAlign(Paint.Align.CENTER);
+    }
+
+    /** True if my own messages should use the custom tick instead of the standard checks. */
+    public static boolean isOwnActive() {
+        int tick = ModSettings.getMyTick();
+        return tick > 0 && tick < EMOJI.length;
+    }
+
+    /** True if this incoming message carries a tick chosen by the sender. */
+    public static boolean hasIncomingTick(MessageObject message) {
+        return message != null
+                && !message.isOutOwner()
+                && message.modMarker != null
+                && message.modMarker.tick > 0
+                && message.modMarker.tick < EMOJI.length;
+    }
+
+    /**
+     * Draws the tick of my own outgoing message.
+     * Sent = one emoji, a bit faded. Read = two overlapping emoji, like the double check.
+     */
+    public static void drawOwn(Canvas canvas, float layoutWidth, float centerY, boolean read, int alpha255) {
+        int tick = ModSettings.getMyTick();
+        if (tick <= 0 || tick >= EMOJI.length) {
+            return;
+        }
+        float size = dp(13);
+        if (read) {
+            drawEmoji(canvas, EMOJI[tick], layoutWidth - dp(28.5f), centerY, size, alpha255);
+            drawEmoji(canvas, EMOJI[tick], layoutWidth - dp(24f), centerY, size, alpha255);
+        } else {
+            drawEmoji(canvas, EMOJI[tick], layoutWidth - dp(24.5f), centerY, size, (int) (alpha255 * 0.6f));
+        }
+    }
+
+    /** Draws the sender's tick next to the time of an incoming message. */
+    public static void drawIncoming(Canvas canvas, int tick, float centerX, float centerY, float size, int alpha255) {
+        if (tick <= 0 || tick >= EMOJI.length) {
+            return;
+        }
+        drawEmoji(canvas, EMOJI[tick], centerX, centerY, size, alpha255);
+    }
+
+    private static void drawEmoji(Canvas canvas, String emoji, float cx, float cy, float size, int alpha255) {
+        paint.setTextSize(size);
+        paint.setAlpha(Math.max(0, Math.min(255, alpha255)));
+        Paint.FontMetrics fm = paint.getFontMetrics();
+        float baseline = cy - (fm.ascent + fm.descent) / 2f;
+        canvas.drawText(emoji, cx, baseline, paint);
+    }
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/ui/ActionBar/MessageDrawable.java b/TMessagesProj/src/main/java/org/telegram/ui/ActionBar/MessageDrawable.java
index 9242105..5503a82 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/ActionBar/MessageDrawable.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/ActionBar/MessageDrawable.java
@@ -808,6 +808,7 @@ public class MessageDrawable extends Drawable {
 
     @Override
